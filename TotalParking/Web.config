<?xml version="1.0" encoding="utf-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  https://go.microsoft.com/fwlink/?LinkId=301880
  -->
<configuration>
  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />

    <!-- ================= Nguong phan loai xe (VehicleClassifier) =================
         DA XAC NHAN - lay tu du lieu that:
           palletRatingLow/High : hai hang tai pallet cua bai nay, doc tu danh sach
                                  the (weight_class 2200KG / 2600KG).
           mechanicalMaxLength* : ranh gioi hai lan LED theo TAI_LIEU_API.docx muc 4.

         CHUA XAC NHAN - so tam, can khao sat khoang da thi cong (design §12.1):
           palletMaxWidth/Height : dang lay theo nguong "Nho/Tieu chuan" cua camera.
           garageMax*            : gioi han vat ly cua bai, dung de TU CHOI xe khong
                                   the tiep nhan (vi du xe tai 12 m / 15 tan).

         BIEN AN TOAN - phan doan, chinh theo van hanh:
           mirrorMargin : width_mm camera gui KHONG tinh guong; guong mo them
                          khoang 150-250 mm tong.
           loadMargin   : weight_kg la khoi luong ban than. Xe cho du nguoi va
                          hanh ly co the nang them 300-500 kg.
    -->
    <add key="classifier:mechanicalMaxLengthShortMm" value="4800" />
    <add key="classifier:mechanicalMaxLengthLongMm"  value="5000" />
    <add key="classifier:palletRatingLowKg"          value="2200" />
    <add key="classifier:palletRatingHighKg"         value="2600" />
    <add key="classifier:palletMaxWidthMm"           value="2000" />
    <add key="classifier:palletMaxHeightMm"          value="1900" />
    <add key="classifier:mirrorMarginMm"             value="200" />
    <add key="classifier:loadMarginKg"               value="400" />

    <!-- PGS (ZCU/CCU cam bien do thuong). Chua co bang trong CSDL: thiet bi dau
         noi sau va giao thuc cong 2000 van chua co tai lieu. De o day de doi dai
         IP khong phai build lai. Bo trong = khong giam sat, giao dien se hien
         "chua giam sat" chu KHONG hien xanh. -->
    <add key="pgs:hosts" value="192.169.1.70,192.169.1.71,192.169.1.72,192.169.1.73,192.169.1.74,192.169.1.75" />
    <add key="pgs:port"  value="2000" />
    <!-- Camera AI khong co heartbeat, chi gui khi co xe. Im lang qua nguong nay
         thi bao "chua ro" (vang), KHONG phai "hong" (do): khong phan biet duoc
         camera chet voi dem khuya khong ai vao bai. Tang len neu bai it xe. -->
    <add key="camera:silentAfterMinutes" value="120" />
    <add key="classifier:garageMaxLengthMm"          value="6000" />
    <add key="classifier:garageMaxWidthMm"           value="2200" />
    <add key="classifier:garageMaxHeightMm"          value="2200" />
    <add key="classifier:garageMaxWeightKg"          value="3500" />

    <!-- ===================== Tang giao tiep PLC Omron ============================
         MAC DINH TAT. May dev khong noi duoc vao mang OT, ma mot vong poll cu
         500ms lai quay so vao IP khong ton tai se lam cham moi lan F5.
         Bat o may co mang OT: doi thanh true.

         Ba thanh ghi da chot voi ben lap trinh PLC (dia chi that nam trong bang
         plc_device, day chi la cong tac bat/tat):
           D100  PLC -> SCADA   ma the khach vua quet
           D402  SCADA -> PLC   2200 / 2600, de HMI an/hien pallet
           W75.0 SCADA -> PLC   1 = dung block da gui xe, 0 = sai block

         Thiet ke: docs/parking-session-db-design.md muc 6. -->
    <add key="plc:enabled" value="true" />

    <!-- Cho phep POST /PlcStatus/Write ghi thang D402 va W75.0 xuong PLC, bo qua
         buoc tra the. Dung khi nghiem thu HMI truoc luc ladder co bit bao luot
         quet. Chi nhan loi goi tu loopback. TAT LAI sau khi nghiem thu xong. -->
    <add key="plc:allowManualWrite" value="true" />
    <!-- Thu tu thanh ghi luu ma the cua tung o trong block (khach xac nhan).
         o 1 -> D400, o 2 -> D202, ... o 10 -> D308. Block 4 o doc 4 dia chi dau.
         De o day thay vi hard-code trong C# de doi khong phai build lai. -->
    <add key="plc:slotWords" value="400,202,204,206,208,300,302,304,306,308" />
    <!-- So word moi o. Ma the la 32 bit = 2 word (vd a0d22940) nen mac dinh 2.
         CHUA KIEM CHUNG duoc vi chua co xe nao duoc gui. Sai gia tri nay chi lam
         giai ma ra ma the rac, khong ghi gi xuong PLC. -->
    <add key="plc:slotWordCount" value="2" />
    <!-- Vong quet o do: doc D400/D202..D308 de biet o nao dang giu the nao.
         CHI DOC, khong ghi gi xuong PLC -> tach rieng khoi plc:enabled (vong do
         co ghi D1000). Bat cai nay khong dong nghia voi cho phep ghi.
         Chu ky 45s: xe vao/ra khong nhanh hon the, va 112 PLC x 3 lenh doc moi
         vong la 336 khung — chay day hon chi lam can node cua PLC. -->
    <add key="plc:slotScanEnabled" value="true" />
    <add key="plc:slotScanMs"      value="45000" />
    <!-- Nhat ky doc/ghi thanh ghi PLC ra file. Moi dong deu ghi IP THAT da gui
         goi tin toi, khong phai suy lai tu block_no. -->
    <add key="plc:auditEnabled"   value="true" />
    <add key="plc:auditPath"      value="~/App_Data/plc_audit.log" />
    <!-- false = bo qua dong SCAN dinh ky (51 block moi 45s), chi giu block co o doi -->
    <add key="plc:auditScanLines" value="true" />
    <!-- true = chi chap nhan the DA DANG KY trong parking_card khi tim xe.
         Mac dinh false: the test ngoai hien truong khong co trong danh sach dang
         ky, bat che do chat se lam moi luot test deu tra "khong tim thay" va
         khong phan biet duoc voi loi that.
         Rac van bi loc bang quy tac: mot ma the chi duoc nam o DUNG MOT block. -->
    <add key="plc:requireRegisteredCard" value="false" />
    <!-- Sau bao lau thi tu xoa cau tra loi o D1000 ve 0.
         Cau tra loi tim xe la thong tin nhat thoi: tai xe doc so block roi di.
         De nguyen thi luot quet sau cua nguoi khac co the doc phai so block cua
         nguoi truoc neu SCADA chua kip ghi de. -->
    <add key="plc:findAnswerResetMs" value="30000" />
    <!-- Xoa D1002 sau khi da tra loi, de luot quet sau duoc nhan la yeu cau MOI.
         Khong co no thi khach quet lai DUNG the do se khong duoc tra loi, vi D1002
         khong doi va he thong bo qua de tranh ghi de moi nhip poll.
         LUU Y: day la lan dau SCADA GHI vao D1002 — truoc gio chi doc.
         Dat false neu ladder khong chap nhan bi ghi de thanh ghi nay. -->
    <add key="plc:clearFindCardAfterAnswer" value="false" />

    <!-- ======================== Tang bang LED chi huong =======================
         MAC DINH TAT. Bat khi may co duong toi mang bang LED (192.169.1.50-.69).

         intervalMs PHAI <= 10000: spec yeu cau toi thieu mot goi moi 10 giay,
         va board dong socket sau 30 giay im lang. 5000 cho bien an toan gap doi.

         CANH BAO: board GIU NGUYEN noi dung cuoi cung vinh vien, ke ca sau khi
         client ngat ket noi, va KHONG co watchdog. Tat ung dung khong dung cach
         (mat dien, kill process) se de lai mot tam bang dang quang cao so cho
         trong cu. Xem stale_seconds o /LedStatus.

         Thiet ke: docs/parking-session-db-design.md; giao thuc: repo led-control. -->
    <add key="led:enabled" value="true" />
    <add key="led:intervalMs" value="5000" />
    <add key="led:timeoutMs" value="3000" />
    <!-- Cho phep POST /LedStatus/Send gui khung tuy y. Chi loopback. TAT sau khi
         nghiem thu xong. -->
    <add key="led:allowManualSend" value="false" />
  </appSettings>
  <connectionStrings>
    <!-- MySQL chay cung may, chi nghe 127.0.0.1 (xem my.ini: bind-address).
         SslMode=None: tren loopback thi TLS khong bao ve them gi ma van ton CPU,
         va CPU o day dang phai chia voi Camera AI. AllowPublicKeyRetrieval=True
         la bat buoc khi dung caching_sha2_password ma khong co TLS; rui ro cua no
         la MITM, dieu khong the xay ra tren loopback.
         DIEN MAT KHAU cua user 'totalparking' vao Password. -->
    <add name="TotalParkingDb"
         providerName="MySqlConnector"
         connectionString="Server=127.0.0.1;Port=3306;Database=total_parking;User ID=totalparking;Password=12345678;SslMode=None;AllowPublicKeyRetrieval=True;CharacterSet=utf8mb4" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" />
    <globalization requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8" />
  </system.web>
  <runtime>
