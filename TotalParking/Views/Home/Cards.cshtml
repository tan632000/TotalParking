@{
    Layout = "~/Views/Shared/_ScadaLayout.cshtml";
}

@*  Trang nay TRUOC DAY la giao dien mau: bang the la 5 dong HTML viet tay, con
    nut "Them the moi" chi them mot dong vao DOM roi thoi -- khong co mot loi goi
    fetch nao trong ca file. Nguoi van hanh bam xong thay dong moi hien ra, kem
    huy hieu "HMI SYNC 0%" nhap nhay, va tin la the da duoc them.

    Da thay bang du lieu that tu /Cards/List, va bo han ba nut gia (them / khoa /
    xoa). Them tung the la viec hiem, nhap theo lo moi la viec thuong -- nen lam
    nhap CSV truoc, con sua tung the de sau khi that su can.                    *@

<div class="p-6 pb-12 min-h-[calc(100vh-3.5rem)] text-slate-100" style="background: rgb(15, 23, 42); font-family: 'Inter', system-ui, -apple-system, sans-serif;">
    <div class="space-y-6">

        <!-- Header -->
        <div class="flex flex-col lg:flex-row justify-between lg:items-center gap-4 pb-4 border-b border-slate-800">
            <div>
                <h1 class="text-2xl font-bold tracking-tight">Quản lý thẻ RFID</h1>
                <p class="text-slate-400 text-sm mt-1">Danh sách thẻ đã đăng ký trong hệ thống. Mã thẻ là giá trị PLC đọc được khi khách quẹt.</p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <a href="/Cards/Template" class="flex items-center gap-1.5 px-3 py-2 rounded text-xs border border-slate-700 text-slate-300 hover:border-slate-500 hover:text-white transition-colors font-bold" style="text-decoration:none;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" x2="12" y1="15" y2="3"></line></svg>
                    Tải file mẫu
                </a>
                <button onclick="openImport()" class="flex items-center gap-1.5 px-3 py-2 rounded text-xs bg-blue-600 hover:bg-blue-500 text-white border border-blue-500/50 transition-colors font-bold shadow-md">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" x2="12" y1="3" y2="15"></line></svg>
                    Nhập từ CSV
                </button>
            </div>
        </div>

        <!-- Tom tat + bo loc -->
        <div class="flex flex-col lg:flex-row lg:items-center gap-3">
            <div id="cardSummary" class="text-xs font-mono text-slate-400">Đang tải...</div>
            <div class="flex-1"></div>
            <div class="flex flex-wrap items-center gap-2">
                <div class="flex items-center gap-2 bg-slate-900/50 border border-slate-800 rounded-lg px-3 py-1.5">
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-500"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
                    <input id="cardSearch" class="bg-transparent text-xs text-slate-200 placeholder-slate-500 outline-none w-52 font-mono" placeholder="mã thẻ hoặc số thẻ...">
                </div>
                <select id="filterLabel" class="bg-slate-900/50 border border-slate-800 rounded-lg px-2.5 py-1.5 text-xs text-slate-300 font-mono outline-none">
                    <option value="">tất cả lô nhập</option>
                </select>
                <select id="filterWeight" class="bg-slate-900/50 border border-slate-800 rounded-lg px-2.5 py-1.5 text-xs text-slate-300 font-mono outline-none">
                    <option value="">tất cả hạng tải</option>
                    <option value="THUONG">THUONG</option>
                    <option value="2200KG">2200KG</option>
                    <option value="2600KG">2600KG</option>
                </select>
            </div>
        </div>

        <!-- Bang the -->
        <div class="bg-slate-900/50 rounded-xl border border-slate-800 overflow-hidden shadow-2xl">
            <div class="overflow-x-auto" style="max-height:62vh; overflow-y:auto;">
                <table class="w-full text-xs font-mono">
                    <thead class="border-b border-slate-800 bg-slate-900 sticky top-0">
                        <tr>
                            <th class="text-left text-slate-500 px-4 py-3 font-bold">Mã thẻ</th>
                            <th class="text-left text-slate-500 px-4 py-3 font-bold">Số thẻ</th>
                            <th class="text-left text-slate-500 px-4 py-3 font-bold">Loại khách</th>
                            <th class="text-left text-slate-500 px-4 py-3 font-bold">Hạng tải</th>
                            <th class="text-left text-slate-500 px-4 py-3 font-bold">Lô nhập</th>
                            <th class="text-left text-slate-500 px-4 py-3 font-bold">Ngày tạo</th>
                            <th class="text-center text-slate-500 px-4 py-3 font-bold">Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody id="cardRows">
                        <tr><td colspan="7" class="text-center text-slate-600 py-10">Đang tải...</td></tr>
                    </tbody>
                </table>
            </div>
            <div id="cardCount" class="px-4 py-2.5 border-t border-slate-800 text-[11px] font-mono text-slate-500"></div>
        </div>
    </div>
</div>

<!-- ===================== HOP THOAI NHAP CSV ===================== -->
<div id="importModal" class="hidden fixed inset-0 z-50 items-center justify-center p-4"
     style="background:rgba(2,6,23,.78); backdrop-filter:blur(3px); -webkit-backdrop-filter:blur(3px);">
    <div class="rounded-xl w-full max-w-3xl flex flex-col"
             style="background:#1e293b; border:1px solid #475569;
                    box-shadow:0 25px 60px rgba(0,0,0,.75), 0 0 0 1px rgba(148,163,184,.08);
                    max-height:88vh;">
        <div class="flex justify-between items-center px-5 py-4" style="background:#172033; border-bottom:1px solid #334155; border-radius:.75rem .75rem 0 0;">
            <h3 class="text-white font-bold text-sm">Nhập thẻ từ file CSV</h3>
            <button onclick="closeImport()" class="text-slate-500 hover:text-white text-lg leading-none">&times;</button>
        </div>

        <div class="p-5 space-y-4" style="overflow-y:auto; min-height:0;">
            <div class="flex items-center gap-3">
                <input type="file" id="csvFile" accept=".csv,text/csv"
                       class="flex-1 text-xs text-slate-300 file:mr-3 file:py-1.5 file:px-3 file:rounded file:border file:border-slate-600 file:bg-slate-800 file:text-slate-200 file:text-xs file:font-bold file:cursor-pointer">
                <button id="btnPreview" onclick="doPreview()" class="px-3 py-2 rounded text-xs border border-slate-600 text-slate-200 hover:border-blue-500 font-bold whitespace-nowrap">Kiểm tra file</button>
            </div>
            <p class="text-[11px] text-slate-500">
                Bấm <b>Kiểm tra file</b> để xem trước — chưa ghi gì vào hệ thống. Chỉ khi bấm nút xác nhận bên dưới thì dữ liệu mới được nạp.
            </p>

            <div id="impSummary" class="hidden"></div>
            <div id="impRows" class="hidden"></div>
        </div>

        <div class="flex justify-between items-center gap-3 px-5 py-4" style="background:#172033; border-top:1px solid #334155; border-radius:0 0 .75rem .75rem;">
            <button id="btnDownloadErr" onclick="downloadErrors()" class="hidden px-3 py-2 rounded text-xs border border-slate-700 text-slate-300 hover:border-slate-500">Tải danh sách lỗi</button>
            <div class="flex-1"></div>
            <button onclick="closeImport()" class="px-4 py-2 rounded text-xs bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold">Đóng</button>
            <button id="btnCommit" onclick="doImport()" disabled
                    class="px-4 py-2 rounded text-xs text-white font-bold disabled:text-slate-600" style="background:#059669;">
                Xác nhận nạp
            </button>
        </div>
    </div>
</div>

<script>
// ===================== DANH SACH THE =====================
var allCards = [];

function esc(s) {
    return String(s === null || s === undefined ? '' : s)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

function loadCards() {
    fetch('/Cards/List')
        .then(function (r) { return r.json(); })
        .then(function (d) {
            if (d.error) {
                document.getElementById('cardSummary').textContent = 'Lỗi: ' + d.error;
                document.getElementById('cardRows').innerHTML =
                    '<tr><td colspan="7" class="text-center text-red-400 py-10">' + esc(d.error) + '</td></tr>';
                return;
            }
            allCards = d.cards || [];
            document.getElementById('cardSummary').innerHTML =
                'Tổng <b class="text-slate-200">' + d.total + '</b> thẻ · ' +
                'đang bật <b style="color:#34d399;">' + d.active + '</b> · ' +
                (d.labels || []).length + ' lô nhập';

            var sel = document.getElementById('filterLabel');
            var cur = sel.value;
            sel.innerHTML = '<option value="">tất cả lô nhập</option>';
            (d.labels || []).forEach(function (l) {
                var o = document.createElement('option');
                o.value = l; o.textContent = l;
                sel.appendChild(o);
            });
            sel.value = cur;
            render();
        })
        .catch(function (e) {
            document.getElementById('cardSummary').textContent = 'Không gọi được máy chủ: ' + e.message;
        });
}

function render() {
    var q     = document.getElementById('cardSearch').value.trim().toLowerCase();
    var label = document.getElementById('filterLabel').value;
    var wc    = document.getElementById('filterWeight').value;

    var rows = allCards.filter(function (c) {
        if (label && c.source_label !== label) return false;
        if (wc && c.weight_class !== wc) return false;
        if (q && (c.card_code + ' ' + c.card_no).toLowerCase().indexOf(q) < 0) return false;
        return true;
    });

    // Chi ve toi da 500 dong. 487 the thi khong sao, nhung khi danh sach lon len
    // thi ve het se lam treo trinh duyet -- va nguoi ta cung khong doc 5000 dong.
    var shown = rows.slice(0, 500);
    var h = '';
    shown.forEach(function (c) {
        h += '<tr class="hover:bg-slate-800" style="border-bottom:1px solid #293548;">' +
             '<td class="px-4 py-2.5 text-blue-300 font-bold">' + esc(c.card_code) + '</td>' +
             '<td class="px-4 py-2.5 text-slate-200">' + esc(c.card_no) + '</td>' +
             '<td class="px-4 py-2.5 text-slate-400">' + esc(c.customer_type) + '</td>' +
             '<td class="px-4 py-2.5 text-slate-400">' + esc(c.weight_class) + '</td>' +
             '<td class="px-4 py-2.5 text-slate-500 text-[11px]">' + esc(c.source_label) + '</td>' +
             '<td class="px-4 py-2.5 text-slate-500">' + esc(c.created_at) + '</td>' +
             '<td class="px-4 py-2.5 text-center">' +
             (c.is_active
                ? '<span class="px-1.5 py-0.5 rounded border text-[9px] font-bold" style="background:rgba(6,78,59,.6);border-color:rgba(4,120,87,.5);color:#34d399;">bật</span>'
                : '<span class="px-1.5 py-0.5 rounded border text-[9px] font-bold bg-slate-800 border-slate-700 text-slate-500">tắt</span>') +
             '</td></tr>';
    });
    if (!h) h = '<tr><td colspan="7" class="text-center text-slate-600 py-10">Không có thẻ nào khớp bộ lọc</td></tr>';
    document.getElementById('cardRows').innerHTML = h;
    document.getElementById('cardCount').textContent =
        'Hiện ' + shown.length + ' / ' + rows.length + ' thẻ khớp bộ lọc' +
        (rows.length > shown.length ? '  (giới hạn hiển thị 500 dòng)' : '');
}

document.getElementById('cardSearch').addEventListener('input', render);
document.getElementById('filterLabel').addEventListener('change', render);
document.getElementById('filterWeight').addEventListener('change', render);

// ===================== NHAP CSV =====================
var lastPreview = null;

function openImport() {
    document.getElementById('importModal').classList.remove('hidden');
    document.getElementById('importModal').classList.add('flex');
}
function closeImport() {
    document.getElementById('importModal').classList.add('hidden');
    document.getElementById('importModal').classList.remove('flex');
    document.getElementById('impSummary').classList.add('hidden');
    document.getElementById('impRows').classList.add('hidden');
    document.getElementById('btnDownloadErr').classList.add('hidden');
    document.getElementById('btnCommit').disabled = true;
    document.getElementById('csvFile').value = '';
    lastPreview = null;
}

function send(url, then) {
    var f = document.getElementById('csvFile').files[0];
    if (!f) { alert('Chưa chọn file.'); return; }
    var fd = new FormData();
    fd.append('file', f);
    fetch(url, { method: 'POST', body: fd })
        .then(function (r) { return r.json(); })
        .then(then)
        .catch(function (e) { alert('Lỗi: ' + e.message); });
}

function doPreview() { send('/Cards/Preview', showResult); }

function doImport() {
    if (!lastPreview || !lastPreview.accepted) return;
    if (!confirm('Nạp ' + lastPreview.accepted + ' thẻ vào hệ thống?')) return;
    send('/Cards/Import', function (d) {
        showResult(d);
        if (!d.error) { loadCards(); document.getElementById('btnCommit').disabled = true; }
    });
}

function showResult(d) {
    var sum = document.getElementById('impSummary');
    sum.classList.remove('hidden');

    if (d.error) {
        sum.className = 'p-3.5 rounded-lg border text-xs';
        sum.style.cssText = 'background:rgba(239,68,68,.10);border-color:rgba(239,68,68,.30);color:#fca5a5;';
        sum.textContent = d.error;
        document.getElementById('btnCommit').disabled = true;
        document.getElementById('impRows').classList.add('hidden');
        return;
    }

    lastPreview = d;
    // CSS da bien dich san va purge, khong the ghep ten lop Tailwind dong --
    // lop khong ton tai thi mat mau ma khong bao loi. Dung inline style.
    var good = d.accepted > 0;
    var boxStyle = good
        ? 'background:rgba(16,185,129,.10);border-color:rgba(16,185,129,.30);'
        : 'background:rgba(245,158,11,.10);border-color:rgba(245,158,11,.30);';
    var hdColor = good ? '#6ee7b7' : '#fcd34d';
    var h = '<div class="p-3.5 rounded-lg border text-xs space-y-1.5" style="' + boxStyle + '">';
    h += '<div class="font-bold text-sm" style="color:' + hdColor + ';">' +
         (d.committed ? ('Đã nạp ' + d.written + ' thẻ') : ('Sẽ nạp được ' + d.accepted + ' thẻ')) + '</div>';
    h += '<div class="font-mono text-[11px] text-slate-300">' +
         'đọc ' + d.read_rows + ' dòng · hợp lệ ' + d.accepted + ' · bỏ qua ' + d.rejected +
         ' · đã có sẵn ' + d.already_in_db + '</div>';
    h += '<div class="font-mono text-[11px] text-slate-500">lô nhập: ' + esc(d.label) + '</div>';
    if ((d.by_reason || []).length) {
        h += '<div class="pt-1.5 mt-1.5 border-t border-slate-700 space-y-0.5">';
        d.by_reason.forEach(function (r) {
            // padStart khong co o trinh duyet cu; dem thu cong cho chac.
            var n = String(r.count);
            while (n.length < 3) n = '&nbsp;' + n;
            h += '<div class="font-mono text-[11px]" style="color:#fcd34d;">' +
                 n + '&nbsp;&nbsp;' + esc(r.reason) + '</div>';
        });
        h += '</div>';
    }
    h += '</div>';
    sum.className = '';
    sum.innerHTML = h;

    // Chi liet ke dong BI BO. Dong hop le khong can xem tung cai -- con so da du,
    // va 470 dong dung se chon mat vai dong sai can chu y.
    var bad = (d.rows || []).filter(function (r) { return !r.ok; });
    var box = document.getElementById('impRows');
    if (bad.length) {
        var t = '<div class="text-[11px] text-slate-400 mb-1.5 font-semibold">Dòng bị bỏ qua</div>' +
                '<div style="max-height:14rem; overflow-y:auto; border:1px solid #334155; border-radius:.5rem;">' +
                '<table class="w-full text-[11px] font-mono"><tbody>';
        bad.forEach(function (r) {
            t += '<tr style="border-bottom:1px solid #293548;">' +
                 '<td class="px-2.5 py-1.5 text-slate-600">dòng ' + r.line + '</td>' +
                 '<td class="px-2.5 py-1.5 text-slate-300">' + esc(r.card_code || '(trống)') + '</td>' +
                 '<td class="px-2.5 py-1.5 text-slate-500">' + esc(r.card_no) + '</td>' +
                 '<td class="px-2.5 py-1.5 text-amber-400">' + esc(r.reject) + '</td></tr>';
        });
        t += '</tbody></table></div>';
        box.innerHTML = t;
        box.classList.remove('hidden');
        document.getElementById('btnDownloadErr').classList.remove('hidden');
    } else {
        box.classList.add('hidden');
        document.getElementById('btnDownloadErr').classList.add('hidden');
    }

    document.getElementById('btnCommit').disabled = d.committed || d.accepted === 0;
}

function downloadErrors() {
    if (!lastPreview) return;
    var bad = (lastPreview.rows || []).filter(function (r) { return !r.ok; });
    var csv = '﻿dong,ma_the,so_the,bien_so,chu_xe,ly_do_bo_qua\r\n';
    bad.forEach(function (r) {
        csv += [r.line, r.card_code, r.card_no, r.plate, r.owner, r.reject]
                 .map(function (v) { return '"' + String(v === null || v === undefined ? '' : v).replace(/"/g, '""') + '"'; })
                 .join(',') + '\r\n';
    });
    var a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8;' }));
    a.download = 'dong_bi_bo_qua.csv';
    a.click();
    URL.revokeObjectURL(a.href);
}

document.addEventListener('DOMContentLoaded', loadCards);
</script>
