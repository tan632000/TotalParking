@{
    Layout = "~/Views/Shared/_ScadaLayout.cshtml";
}

@*  Trang nay TRUOC DAY la giao dien mau: bang the la 5 dong HTML viet tay, con
    nut "Them the moi" chi them mot dong vao DOM roi thoi -- khong co mot loi goi
    fetch nao trong ca file. Nguoi van hanh bam xong thay dong moi hien ra, kem
    huy hieu "HMI SYNC 0%" nhap nhay, va tin la the da duoc them.

    Da thay bang du lieu that tu /Cards/List, va bo han ba nut gia (them / khoa /
    xoa). Them tung the la viec hiem, nhap theo lo moi la viec thuong -- nen lam
    nhap theo lo truoc, con sua tung the de sau khi that su can.

    Nhap doc thang file .xlsx khach xuat ra tu he thong DEC. Ban truoc doi CSV 8
    cot theo mau rieng, nghia la moi lan co nguoi phai mo Excel xoa 14 cot roi
    luu sang CSV -- mot buoc lam tay khong ai kiem tra. Bo doc khop cot theo TEN
    nen khach them hay bot cot khong dung cung khong anh huong.                *@

<div class="p-6 pb-12 min-h-[calc(100vh-3.5rem)] text-slate-100" style="background: rgb(15, 23, 42); font-family: 'Inter', system-ui, -apple-system, sans-serif;">
    <div class="space-y-6">

        <!-- Header -->
        <div class="flex flex-col lg:flex-row justify-between lg:items-center gap-4 pb-4 border-b border-slate-800">
            <div>
                <h1 class="text-2xl font-bold tracking-tight">Quản lý thẻ RFID</h1>
                <p class="text-slate-400 text-sm mt-1">Danh sách thẻ đã đăng ký trong hệ thống. Mã thẻ là giá trị PLC đọc được khi khách quẹt.</p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <a href="/Cards/Template" class="flex items-center gap-1.5 px-3 py-2 rounded text-xs border border-slate-700 text-slate-300 hover:border-slate-500 hover:text-white transition-colors font-bold" style="text-decoration:none;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" x2="12" y1="15" y2="3"></line></svg>
                    Tải file mẫu (.xlsx)
                </a>
                <button onclick="openImport()" class="flex items-center gap-1.5 px-3 py-2 rounded text-xs bg-blue-600 hover:bg-blue-500 text-white border border-blue-500/50 transition-colors font-bold shadow-md">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" x2="12" y1="3" y2="15"></line></svg>
                    Nhập từ Excel
                </button>
            </div>
        </div>

        <!-- Tom tat + bo loc -->
        <div class="flex flex-col lg:flex-row lg:items-center gap-3">
            <div id="cardSummary" class="text-xs font-mono text-slate-400">Đang tải...</div>
            <div class="flex-1"></div>
            <div class="flex flex-wrap items-center gap-2">
                <div class="flex items-center gap-2 bg-slate-900/50 border border-slate-800 rounded-lg px-3 py-1.5">
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-500"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
                    <input id="cardSearch" class="bg-transparent text-xs text-slate-200 placeholder-slate-500 outline-none w-60 font-mono" placeholder="mã thẻ, số thẻ, biển số, tên khách...">
                </div>
                <select id="filterLabel" class="bg-slate-900/50 border border-slate-800 rounded-lg px-2.5 py-1.5 text-xs text-slate-300 font-mono outline-none">
                    <option value="">tất cả lô nhập</option>
                </select>
                <select id="filterWeight" class="bg-slate-900/50 border border-slate-800 rounded-lg px-2.5 py-1.5 text-xs text-slate-300 font-mono outline-none">
                    <option value="">tất cả hạng tải</option>
                    <option value="THUONG">THUONG</option>
                    <option value="2200KG">2200KG</option>
                    <option value="2600KG">2600KG</option>
                </select>
            </div>
        </div>

        <!-- Bang the -->
        <div id="cardMsg" class="text-xs mb-2"></div>
        <div class="bg-slate-900/50 rounded-xl border border-slate-800 overflow-hidden shadow-2xl">
            <div class="overflow-x-auto" style="max-height:62vh; overflow-y:auto;">
                <table class="w-full text-xs font-mono">
                    <thead class="border-b border-slate-800 bg-slate-900 sticky top-0">
                        <tr>
                            <th class="text-left text-slate-500 px-4 py-3 font-bold">Mã thẻ</th>
                            <th class="text-left text-slate-500 px-4 py-3 font-bold">Số thẻ</th>
                            <th class="text-left text-slate-500 px-4 py-3 font-bold">Biển số</th>
                            <th class="text-left text-slate-500 px-4 py-3 font-bold">Tên phương tiện</th>
                            <th class="text-left text-slate-500 px-4 py-3 font-bold">Tên khách hàng</th>
                            <th class="text-left text-slate-500 px-4 py-3 font-bold">Hạng tải</th>
                            <th class="text-left text-slate-500 px-4 py-3 font-bold">Hết hạn</th>
                            <th class="text-left text-slate-500 px-4 py-3 font-bold">Loại khách</th>
                            <th class="text-left text-slate-500 px-4 py-3 font-bold">Lô nhập</th>
                            <th class="text-left text-slate-500 px-4 py-3 font-bold">Ngày tạo</th>
                            <th class="text-center text-slate-500 px-4 py-3 font-bold">Trạng thái</th>
                            <th class="text-center text-slate-500 px-4 py-3 font-bold">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="cardRows">
                        <tr><td colspan="12" class="text-center text-slate-600 py-10">Đang tải...</td></tr>
                    </tbody>
                </table>
            </div>
            <div id="cardCount" class="px-4 py-2.5 border-t border-slate-800 text-[11px] font-mono text-slate-500"></div>
        </div>
    </div>
</div>

<!-- ===================== HOP THOAI NHAP EXCEL ===================== -->
<style>
    /* Mau NEN va CHU dat tuong minh, khong dua vao lop Tailwind.
       scada.css la ban trich xuat: do duoc bg-slate-900 KHONG co trong file
       (nen o chon ra trong suot), trong khi bg-slate-900/50 thi co. Va the
       <option> khong co nen rieng thi popup cua Chrome tren Windows dung nen
       trang he thong, con chu thi thua text-slate-200 sang mau — chu sang tren
       nen trang, khong doc duoc gia tri nao. */
    #editModal select,
    #editModal input { background: #0f172a; color: #e2e8f0; }
    #editModal select option { background: #0f172a; color: #e2e8f0; }

    /* Hai o loc o dau trang co cung tinh trang: <option> khong co nen rieng nen
       popup dung nen trang he thong con chu thi sang mau. Ban than o chon thi
       van to duoc vi no dung bg-slate-900/50 (co trong scada.css), nen loi chi
       lo ra khi bung danh sach. */
    #filterLabel option,
    #filterWeight option { background: #0f172a; color: #e2e8f0; }
</style>

<!-- Modal sua thong tin the -->
<div id="editModal" class="hidden fixed inset-0 z-50 items-center justify-center p-4"
     style="background:rgba(2,6,23,.78); backdrop-filter:blur(3px); -webkit-backdrop-filter:blur(3px);">
    <div class="rounded-xl w-full max-w-2xl flex flex-col"
         style="background:#1e293b; border:1px solid #475569;
                box-shadow:0 25px 60px rgba(0,0,0,.75); max-height:88vh;">
        <div class="flex justify-between items-center px-5 py-4"
             style="background:#172033; border-bottom:1px solid #334155; border-radius:.75rem .75rem 0 0;">
            <h3 class="text-white font-bold text-sm">Sửa thông tin thẻ</h3>
            <button onclick="dongSua()" class="text-slate-500 hover:text-white text-lg leading-none">&times;</button>
        </div>

        <div class="px-5 py-4 overflow-y-auto text-xs" style="display:grid; grid-template-columns:1fr 1fr; gap:.75rem 1rem;">
            <!-- Ma the hien dang CHU, khong phai o nhap.
                 May chu khong bao gio ghi card_code, nen mot o nhap o day se im
                 lang khong co tac dung: nguoi van hanh go vao, bam luu, thay bao
                 thanh cong, va tin rang ma da doi. -->
            <div class="flex items-center gap-2 px-3 py-2 rounded"
                 style="grid-column:1 / -1; background:#0f172a; border:1px solid #334155;">
                <span class="text-slate-500">Mã thẻ:</span>
                <span id="edMaThe" class="text-blue-300 font-bold font-mono"></span>
                <span class="text-slate-600 text-[10px]">(không sửa được — mã nằm trong thanh ghi PLC)</span>
            </div>

            <label class="flex flex-col gap-1"><span class="text-slate-500">Số thẻ</span>
                <input id="edSoThe" maxlength="16" class="px-2 py-1.5 rounded bg-slate-900 border border-slate-700 text-slate-200"></label>
            <label class="flex flex-col gap-1"><span class="text-slate-500">Biển số</span>
                <input id="edBienSo" maxlength="16" class="px-2 py-1.5 rounded bg-slate-900 border border-slate-700 text-slate-200"></label>
            <label class="flex flex-col gap-1"><span class="text-slate-500">Tên phương tiện</span>
                <input id="edTenXe" maxlength="64" class="px-2 py-1.5 rounded bg-slate-900 border border-slate-700 text-slate-200"></label>
            <label class="flex flex-col gap-1"><span class="text-slate-500">Tên khách hàng</span>
                <input id="edTenKhach" maxlength="128" class="px-2 py-1.5 rounded bg-slate-900 border border-slate-700 text-slate-200"></label>
            <label class="flex flex-col gap-1"><span class="text-slate-500">Loại xe</span>
                <input id="edLoaiXe" maxlength="16" class="px-2 py-1.5 rounded bg-slate-900 border border-slate-700 text-slate-200"></label>
            <label class="flex flex-col gap-1"><span class="text-slate-500">Tải trọng (chữ)</span>
                <input id="edTaiTrong" maxlength="32" class="px-2 py-1.5 rounded bg-slate-900 border border-slate-700 text-slate-200"></label>
            <label class="flex flex-col gap-1"><span class="text-slate-500">Hết hạn (dd/MM/yyyy)</span>
                <input id="edHetHan" maxlength="10" placeholder="31/12/2027" class="px-2 py-1.5 rounded bg-slate-900 border border-slate-700 text-slate-200"></label>
            <label class="flex flex-col gap-1"><span class="text-slate-500">Loại khách</span>
                <select id="edLoaiKhach" class="px-2 py-1.5 rounded bg-slate-900 border border-slate-700 text-slate-200"></select></label>
            <label class="flex flex-col gap-1"><span class="text-slate-500">Hạng tải</span>
                <select id="edHangTai" class="px-2 py-1.5 rounded bg-slate-900 border border-slate-700 text-slate-200"></select></label>
            <label class="flex flex-col gap-1"><span class="text-slate-500">Người thao tác</span>
                <input id="edNguoi" maxlength="64" placeholder="tên bạn" class="px-2 py-1.5 rounded bg-slate-900 border border-slate-700 text-slate-200"></label>
        </div>

        <div class="flex justify-end items-center gap-3 px-5 py-4"
             style="background:#172033; border-top:1px solid #334155; border-radius:0 0 .75rem .75rem;">
            <span id="edLoi" class="text-red-400 text-xs flex-1"></span>
            <button onclick="dongSua()" class="px-4 py-2 rounded text-xs bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold">Đóng</button>
            <button id="edLuu" onclick="luuSua()" class="px-4 py-2 rounded text-xs text-white font-bold" style="background:#2563eb;">Lưu</button>
        </div>
    </div>
</div>

<div id="importModal" class="hidden fixed inset-0 z-50 items-center justify-center p-4"
     style="background:rgba(2,6,23,.78); backdrop-filter:blur(3px); -webkit-backdrop-filter:blur(3px);">
    <div class="rounded-xl w-full max-w-3xl flex flex-col"
             style="background:#1e293b; border:1px solid #475569;
                    box-shadow:0 25px 60px rgba(0,0,0,.75), 0 0 0 1px rgba(148,163,184,.08);
                    max-height:88vh;">
        <div class="flex justify-between items-center px-5 py-4" style="background:#172033; border-bottom:1px solid #334155; border-radius:.75rem .75rem 0 0;">
            <h3 class="text-white font-bold text-sm">Nhập thẻ từ file Excel</h3>
            <button onclick="closeImport()" class="text-slate-500 hover:text-white text-lg leading-none">&times;</button>
        </div>

        <div class="p-5 space-y-4" style="overflow-y:auto; min-height:0;">
            <div class="flex items-center gap-3">
                <input type="file" id="importFile"
                       accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                       class="flex-1 text-xs text-slate-300 file:mr-3 file:py-1.5 file:px-3 file:rounded file:border file:border-slate-600 file:bg-slate-800 file:text-slate-200 file:text-xs file:font-bold file:cursor-pointer">
                <button id="btnPreview" onclick="doPreview()" class="px-3 py-2 rounded text-xs border border-slate-600 text-slate-200 hover:border-blue-500 font-bold whitespace-nowrap">Kiểm tra file</button>
            </div>
            <p class="text-[11px] text-slate-500">
                Chọn file <b>.xlsx</b> xuất từ hệ thống thẻ (không cần xoá cột hay đổi tên cột).
                Chỉ những dòng có <b>Mã nhóm định danh = THE THANG OTO</b> được nạp; các nhóm khác bỏ qua.
            </p>
            <p class="text-[11px] text-slate-500">
                Bấm <b>Kiểm tra file</b> để xem trước — chưa ghi gì vào hệ thống. Chỉ khi bấm nút xác nhận bên dưới thì dữ liệu mới được nạp.
            </p>

            <div id="impSummary" class="hidden"></div>
            <div id="impRows" class="hidden"></div>
        </div>

        <div class="flex justify-between items-center gap-3 px-5 py-4" style="background:#172033; border-top:1px solid #334155; border-radius:0 0 .75rem .75rem;">
            <button id="btnDownloadErr" onclick="downloadErrors()" class="hidden px-3 py-2 rounded text-xs border border-slate-700 text-slate-300 hover:border-slate-500">Tải danh sách lỗi</button>
            <div class="flex-1"></div>
            <button onclick="closeImport()" class="px-4 py-2 rounded text-xs bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold">Đóng</button>
            <button id="btnCommit" onclick="doImport()" disabled
                    class="px-4 py-2 rounded text-xs text-white font-bold disabled:text-slate-600" style="background:#059669;">
                Xác nhận nạp
            </button>
        </div>
    </div>
</div>

<script>
// ===================== DANH SACH THE =====================
var allCards = [];

var loaiKhach = [], hangTai = [], theDangSua = null;

function esc(s) {
    return String(s === null || s === undefined ? '' : s)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

function loadCards() {
    fetch('/Cards/List')
        .then(function (r) { return r.json(); })
        .then(function (d) {
            if (d.error) {
                document.getElementById('cardSummary').textContent = 'Lỗi: ' + d.error;
                document.getElementById('cardRows').innerHTML =
                    '<tr><td colspan="12" class="text-center text-red-400 py-10">' + esc(d.error) + '</td></tr>';
                return;
            }
            allCards  = d.cards || [];
            // Hai bang tra cuu lay TU MAY CHU. Viet cung id trong view thi
            // them mot hang vao customer_type/weight_class la view ghi sai
            // id ma khong co gi bao.
            loaiKhach = d.loai_khach || [];
            hangTai   = d.hang_tai   || [];
            document.getElementById('cardSummary').innerHTML =
                'Tổng <b class="text-slate-200">' + d.total + '</b> thẻ · ' +
                'đang bật <b style="color:#34d399;">' + d.active + '</b> · ' +
                (d.labels || []).length + ' lô nhập';

            var sel = document.getElementById('filterLabel');
            var cur = sel.value;
            sel.innerHTML = '<option value="">tất cả lô nhập</option>';
            (d.labels || []).forEach(function (l) {
                var o = document.createElement('option');
                o.value = l; o.textContent = l;
                sel.appendChild(o);
            });
            sel.value = cur;
            render();
        })
        .catch(function (e) {
            document.getElementById('cardSummary').textContent = 'Không gọi được máy chủ: ' + e.message;
        });
}

function render() {
    var q     = document.getElementById('cardSearch').value.trim().toLowerCase();
    var label = document.getElementById('filterLabel').value;
    var wc    = document.getElementById('filterWeight').value;

    var rows = allCards.filter(function (c) {
        if (label && c.source_label !== label) return false;
        if (wc && c.weight_class !== wc) return false;
        // Tim theo ca bien so va ten khach: o quay bao ve khach doc bien so chu
        // khong doc so the, nen o tim khong nhan bien so la o tim khong dung duoc.
        if (q) {
            var hay = [c.card_code, c.card_no, c.plate, c.vehicle_name, c.customer_name]
                        .join(' ').toLowerCase();
            if (hay.indexOf(q) < 0) return false;
        }
        return true;
    });

    // Chi ve toi da 500 dong. 487 the thi khong sao, nhung khi danh sach lon len
    // thi ve het se lam treo trinh duyet -- va nguoi ta cung khong doc 5000 dong.
    var shown = rows.slice(0, 500);
    var h = '';
    shown.forEach(function (c) {
        // 487 the nap truoc khi co cac cot ho so nay nen chung deu null. Hien
        // dau gach chu khong de trong: o trong nhin giong loi ve giao dien, con
        // dau gach noi ro "chua co du lieu".
        var dash = '<span class="text-slate-700">&mdash;</span>';
        var opt  = function (v) { return v ? esc(v) : dash; };

        // Hang tai doan duoc to vang kem dau *: con so hien ra la gia tri mac
        // dinh, khong phai tai trong that. Nhan ra bang weight_text -- nguyen van
        // chu cua khach -- chu khong bang lo nhap, vi the cap nhat sau nay van
        // giu lo nhap cu ma weight_text thi luon dung theo lan nhap gan nhat.
        var wcGuessed = c.weight_text === 'Chưa xác định' ||
                        c.weight_text === 'Không phải ô tô';
        var wcCell = wcGuessed
            ? '<td class="px-4 py-2.5" style="color:#fcd34d;" title="' +
              esc(c.weight_text) + ' — hạng tải là giá trị mặc định">' +
              esc(c.weight_class) + ' *</td>'
            : '<td class="px-4 py-2.5 text-slate-400">' + esc(c.weight_class) + '</td>';

        h += '<tr class="hover:bg-slate-800" style="border-bottom:1px solid #293548;">' +
             '<td class="px-4 py-2.5 text-blue-300 font-bold">' + esc(c.card_code) + '</td>' +
             '<td class="px-4 py-2.5 text-slate-200">' + esc(c.card_no) + '</td>' +
             '<td class="px-4 py-2.5 text-slate-200">' + opt(c.plate) + '</td>' +
             '<td class="px-4 py-2.5 text-slate-400">' + opt(c.vehicle_name) + '</td>' +
             '<td class="px-4 py-2.5 text-slate-400">' + opt(c.customer_name) + '</td>' +
             wcCell +
             '<td class="px-4 py-2.5 text-slate-500">' + opt(c.expiry_date) + '</td>' +
             '<td class="px-4 py-2.5 text-slate-400">' + esc(c.customer_type) + '</td>' +
             '<td class="px-4 py-2.5 text-slate-500 text-[11px]">' + esc(c.source_label) + '</td>' +
             '<td class="px-4 py-2.5 text-slate-500">' + esc(c.created_at) + '</td>' +
             '<td class="px-4 py-2.5 text-center">' +
             (c.is_active
                ? '<span class="px-1.5 py-0.5 rounded border text-[9px] font-bold" style="background:rgba(6,78,59,.6);border-color:rgba(4,120,87,.5);color:#34d399;">bật</span>'
                : '<span class="px-1.5 py-0.5 rounded border text-[9px] font-bold bg-slate-800 border-slate-700 text-slate-500">tắt</span>') +
             '</td>' +
             // Nhan la "Ngung dung" chu khong phai "Xoa": dong van o lai trong
             // bang. Goi no la xoa thi nguoi van hanh tin the da bien mat roi
             // ngac nhien khi van thay no.
             '<td class="px-4 py-2.5 text-center whitespace-nowrap">' +
             '<button onclick="moSua(' + c.card_id + ')" ' +
             'class="px-2 py-1 rounded border border-slate-600 text-slate-300 hover:border-blue-500 ' +
             'hover:text-blue-300 text-[10px] font-bold">Sửa</button> ' +
             (c.is_active
                ? '<button onclick="doiTrangThai(' + c.card_id + ', 0)" ' +
                  'class="px-2 py-1 rounded border border-amber-800 text-amber-400 ' +
                  'hover:bg-slate-700 text-[10px] font-bold">Ngừng dùng</button>'
                : '<button onclick="doiTrangThai(' + c.card_id + ', 1)" ' +
                  'class="px-2 py-1 rounded border border-green-700/50 text-green-300 ' +
                  'hover:bg-slate-700 text-[10px] font-bold">Dùng lại</button>') +
             '</td></tr>';
    });
    if (!h) h = '<tr><td colspan="12" class="text-center text-slate-600 py-10">Không có thẻ nào khớp bộ lọc</td></tr>';
    document.getElementById('cardRows').innerHTML = h;
    document.getElementById('cardCount').textContent =
        'Hiện ' + shown.length + ' / ' + rows.length + ' thẻ khớp bộ lọc' +
        (rows.length > shown.length ? '  (giới hạn hiển thị 500 dòng)' : '');
}

document.getElementById('cardSearch').addEventListener('input', render);
document.getElementById('filterLabel').addEventListener('change', render);
document.getElementById('filterWeight').addEventListener('change', render);

// ===================== SUA / NGUNG DUNG THE =====================
// May chu khoa card_code va giu ba lop chan cho viec ngung dung (the dang trong
// o do, dang co phien gui xe, hoac vua quet trong 24 gio). Giao dien o day KHONG
// lap lai cac lop do — no chi goi API va hien dung ly do tra ve.

function thongBao(chu, loi) {
    var e = document.getElementById('cardMsg');
    if (!e) return;
    e.textContent = chu || '';
    e.className = 'text-xs ' + (loi ? 'text-red-400' : 'text-green-300');
}

function veOChon(id, ds, chon) {
    var sel = document.getElementById(id);
    sel.innerHTML = '';

    // Khong doi chieu duoc thi chen mot o TRONG va chon no, thay vi de trinh
    // duyet tu chon option dau tien. Tu chon nghia la ghi tham mot id ma nguoi
    // dung khong he chon — va may chu se nhan no nhu mot lua chon that.
    // O trong lam may chu tra 400 "Thieu loai khach hoac hang tai", tuc bao loi
    // to ro thay vi doi im lang.
    if (chon === null || chon === undefined) {
        var r = document.createElement('option');
        r.value = ''; r.textContent = '— chưa xác định —'; r.selected = true;
        sel.appendChild(r);
    }

    ds.forEach(function (x) {
        var o = document.createElement('option');
        o.value = x.id; o.textContent = x.ma;
        if (String(x.id) === String(chon)) o.selected = true;
        sel.appendChild(o);
    });
}

function moSua(cardId) {
    var c = allCards.filter(function (x) { return x.card_id === cardId; })[0];
    if (!c) return;
    theDangSua = c;

    document.getElementById('edMaThe').textContent   = c.card_code;
    document.getElementById('edSoThe').value         = c.card_no || '';
    document.getElementById('edBienSo').value        = c.plate || '';
    document.getElementById('edTenXe').value         = c.vehicle_name || '';
    document.getElementById('edTenKhach').value      = c.customer_name || '';
    document.getElementById('edLoaiXe').value        = c.card_type || '';
    document.getElementById('edTaiTrong').value      = c.weight_text || '';
    document.getElementById('edHetHan').value        = c.expiry_date || '';
    document.getElementById('edLoi').textContent     = '';

    // Ma hien trong bang la CHU (VANG/XT/GHI), con API doi id. Doi chieu qua
    // danh sach tra cuu chu khong doan.
    var lk = loaiKhach.filter(function (x) { return x.ma === c.customer_type; })[0];
    var ht = hangTai.filter(function (x) { return x.ma === c.weight_class; })[0];
    veOChon('edLoaiKhach', loaiKhach, lk ? lk.id : null);
    veOChon('edHangTai',   hangTai,   ht ? ht.id : null);

    var m = document.getElementById('editModal');
    m.classList.remove('hidden');
    m.classList.add('flex');
}

function dongSua() {
    var m = document.getElementById('editModal');
    m.classList.add('hidden');
    m.classList.remove('flex');
    theDangSua = null;
}

function luuSua() {
    if (!theDangSua) return;
    var nguoi = document.getElementById('edNguoi').value.trim();
    if (!nguoi) {
        document.getElementById('edLoi').textContent = 'Nhập tên người thao tác.';
        return;
    }

    var fd = new URLSearchParams();
    fd.append('card_id',          theDangSua.card_id);
    fd.append('nguoi',            nguoi);
    fd.append('card_no',          document.getElementById('edSoThe').value.trim());
    fd.append('plate',            document.getElementById('edBienSo').value.trim());
    fd.append('vehicle_name',     document.getElementById('edTenXe').value.trim());
    fd.append('customer_name',    document.getElementById('edTenKhach').value.trim());
    fd.append('card_type',        document.getElementById('edLoaiXe').value.trim());
    fd.append('weight_text',      document.getElementById('edTaiTrong').value.trim());
    fd.append('expiry_date',      document.getElementById('edHetHan').value.trim());
    fd.append('customer_type_id', document.getElementById('edLoaiKhach').value);
    fd.append('weight_class_id',  document.getElementById('edHangTai').value);
    // KHONG gui card_code: may chu khong bao gio ghi no, va mot o nhap o day chi
    // tao cam giac sai rang ma da doi.

    var nut = document.getElementById('edLuu');
    nut.disabled = true;
    fetch('/Cards/Update', { method: 'POST', body: fd })
        .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
        .then(function (kq) {
            nut.disabled = false;
            if (!kq.ok) {
                document.getElementById('edLoi').textContent =
                    (kq.d && kq.d.error) ? kq.d.error : 'Không lưu được.';
                return;
            }
            dongSua();
            thongBao('Đã lưu thẻ ' + kq.d.card_code + '.', false);
            loadCards();
        })
        .catch(function (e) {
            nut.disabled = false;
            document.getElementById('edLoi').textContent = 'Không gọi được máy chủ: ' + e.message;
        });
}

function doiTrangThai(cardId, bat) {
    var c = allCards.filter(function (x) { return x.card_id === cardId; })[0];
    if (!c) return;

    if (bat === 0) {
        // Hop xac nhan PHAI hien ma the va bien so. Mot cau "Ban co chac khong?"
        // la vo dung khi nguoi van hanh vua cuon qua 613 dong.
        var hoi = 'Ngừng dùng thẻ ' + c.card_code +
                  ' (số thẻ ' + c.card_no + ', biển số ' + (c.plate || '—') + ')?\n\n' +
                  'Thẻ sẽ bị từ chối ở cổng cho tới khi được dùng lại.';
        if (!confirm(hoi)) return;
    }

    var nguoi = prompt('Tên người thao tác:');
    if (!nguoi || !nguoi.trim()) return;

    var fd = new URLSearchParams();
    fd.append('card_id', cardId);
    fd.append('bat', bat);
    fd.append('nguoi', nguoi.trim());

    fetch('/Cards/SetActive', { method: 'POST', body: fd })
        .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
        .then(function (kq) {
            if (!kq.ok) {
                // Ba ly do tu choi deu la dieu nguoi van hanh CAN biet: the do
                // dang gan voi mot chiec xe. Nuot chung thanh "khong thuc hien
                // duoc" thi ho bam lai vai lan roi bo cuoc.
                thongBao((kq.d && kq.d.error) ? kq.d.error : 'Không đổi được trạng thái.', true);
                loadCards();
                return;
            }
            thongBao('Thẻ ' + kq.d.card_code + (bat ? ' đã dùng lại.' : ' đã ngừng dùng.'), false);
            loadCards();
        })
        .catch(function (e) { thongBao('Không gọi được máy chủ: ' + e.message, true); });
}

// ===================== NHAP EXCEL =====================
var lastPreview = null;

function openImport() {
    document.getElementById('importModal').classList.remove('hidden');
    document.getElementById('importModal').classList.add('flex');
}
function closeImport() {
    document.getElementById('importModal').classList.add('hidden');
    document.getElementById('importModal').classList.remove('flex');
    document.getElementById('impSummary').classList.add('hidden');
    document.getElementById('impRows').classList.add('hidden');
    document.getElementById('btnDownloadErr').classList.add('hidden');
    document.getElementById('btnCommit').disabled = true;
    document.getElementById('importFile').value = '';
    lastPreview = null;
}

function send(url, then) {
    var f = document.getElementById('importFile').files[0];
    if (!f) { alert('Chưa chọn file.'); return; }
    var fd = new FormData();
    fd.append('file', f);
    fetch(url, { method: 'POST', body: fd })
        .then(function (r) { return r.json(); })
        .then(then)
        .catch(function (e) { alert('Lỗi: ' + e.message); });
}

function doPreview() { send('/Cards/Preview', showResult); }

function doImport() {
    if (!lastPreview || !lastPreview.accepted) return;

    // Noi ro ca hai con so truoc khi ghi. Cap nhat GHI DE ho so the da co, nen
    // nguoi bam phai thay truoc con so do chu khong chi thay tong.
    var msg = 'Nạp ' + lastPreview.to_insert + ' thẻ mới';
    if (lastPreview.to_update > 0)
        msg += ' và cập nhật hồ sơ ' + lastPreview.to_update + ' thẻ đã có';
    if (!confirm(msg + ' vào hệ thống?')) return;
    send('/Cards/Import', function (d) {
        showResult(d);
        if (!d.error) { loadCards(); document.getElementById('btnCommit').disabled = true; }
    });
}

function showResult(d) {
    var sum = document.getElementById('impSummary');
    sum.classList.remove('hidden');

    if (d.error) {
        sum.className = 'p-3.5 rounded-lg border text-xs';
        sum.style.cssText = 'background:rgba(239,68,68,.10);border-color:rgba(239,68,68,.30);color:#fca5a5;';
        sum.textContent = d.error;
        document.getElementById('btnCommit').disabled = true;
        document.getElementById('impRows').classList.add('hidden');
        return;
    }

    lastPreview = d;
    // CSS da bien dich san va purge, khong the ghep ten lop Tailwind dong --
    // lop khong ton tai thi mat mau ma khong bao loi. Dung inline style.
    var good = d.accepted > 0;
    var boxStyle = good
        ? 'background:rgba(16,185,129,.10);border-color:rgba(16,185,129,.30);'
        : 'background:rgba(245,158,11,.10);border-color:rgba(245,158,11,.30);';
    var hdColor = good ? '#6ee7b7' : '#fcd34d';
    var h = '<div class="p-3.5 rounded-lg border text-xs space-y-1.5" style="' + boxStyle + '">';

    var title = d.committed
        ? ('Đã nạp ' + d.written + ' thẻ mới' + (d.updated > 0 ? ', cập nhật ' + d.updated + ' thẻ' : ''))
        : ('Sẽ nạp ' + d.to_insert + ' thẻ mới' + (d.to_update > 0 ? ', cập nhật ' + d.to_update + ' thẻ' : ''));
    h += '<div class="font-bold text-sm" style="color:' + hdColor + ';">' + title + '</div>';

    // Bao ca duong di cua tung dong: bao nhieu dong trong sheet, bao nhieu bi
    // loai vi khac nhom, bao nhieu con lai. Khong co dong nay thi "994 dong
    // thanh 128 the" nhin nhu mat du lieu.
    h += '<div class="font-mono text-[11px] text-slate-300">' +
         'sheet ' + d.total_data_rows + ' dòng · khác nhóm ' + d.other_group_rows +
         ' · nhóm ' + esc(d.group) + ' ' + d.read_rows +
         ' · hợp lệ ' + d.accepted + ' · bỏ qua ' + d.rejected + '</div>';

    if (d.guessed_weight > 0) {
        h += '<div class="font-mono text-[11px]" style="color:#fcd34d;">' +
             d.guessed_weight + ' thẻ không có phân loại tải trọng → mặc định 2200KG, ' +
             'gắn nhãn lô riêng để lọc lại sau</div>';
    }

    h += '<div class="font-mono text-[11px] text-slate-500">lô nhập: ' + esc(d.label) + '</div>';
    h += '<div class="font-mono text-[11px] text-slate-500">sheet: ' + esc(d.sheet_name) + '</div>';
    if ((d.by_reason || []).length) {
        h += '<div class="pt-1.5 mt-1.5 border-t border-slate-700 space-y-0.5">';
        d.by_reason.forEach(function (r) {
            // padStart khong co o trinh duyet cu; dem thu cong cho chac.
            var n = String(r.count);
            while (n.length < 3) n = '&nbsp;' + n;
            h += '<div class="font-mono text-[11px]" style="color:#fcd34d;">' +
                 n + '&nbsp;&nbsp;' + esc(r.reason) + '</div>';
        });
        h += '</div>';
    }
    h += '</div>';
    sum.className = '';
    sum.innerHTML = h;

    // Chi liet ke dong BI BO. Dong hop le khong can xem tung cai -- con so da du,
    // va 470 dong dung se chon mat vai dong sai can chu y.
    var bad = (d.rows || []).filter(function (r) { return !r.ok; });
    var box = document.getElementById('impRows');
    if (bad.length) {
        var t = '<div class="text-[11px] text-slate-400 mb-1.5 font-semibold">Dòng bị bỏ qua</div>' +
                '<div style="max-height:14rem; overflow-y:auto; border:1px solid #334155; border-radius:.5rem;">' +
                '<table class="w-full text-[11px] font-mono"><tbody>';
        // Hien them bien so va ten khach: 7 dong trong file 21/09 KHONG co ma
        // dinh danh lan ten dinh danh, nen thieu hai cot nay thi dong bao loi
        // khong chi ra duoc no la the nao de con doi chieu voi khach.
        bad.forEach(function (r) {
            t += '<tr style="border-bottom:1px solid #293548;">' +
                 '<td class="px-2.5 py-1.5 text-slate-600">dòng ' + r.line + '</td>' +
                 '<td class="px-2.5 py-1.5 text-slate-300">' + esc(r.card_code || '(trống)') + '</td>' +
                 '<td class="px-2.5 py-1.5 text-slate-500">' + esc(r.card_no || '(trống)') + '</td>' +
                 '<td class="px-2.5 py-1.5 text-slate-400">' + esc(r.plate) + '</td>' +
                 '<td class="px-2.5 py-1.5 text-slate-500">' + esc(r.customer_name) + '</td>' +
                 '<td class="px-2.5 py-1.5 text-amber-400">' + esc(r.reject) + '</td></tr>';
        });
        t += '</tbody></table></div>';
        box.innerHTML = t;
        box.classList.remove('hidden');
        document.getElementById('btnDownloadErr').classList.remove('hidden');
    } else {
        box.classList.add('hidden');
        document.getElementById('btnDownloadErr').classList.add('hidden');
    }

    document.getElementById('btnCommit').disabled = d.committed || d.accepted === 0;
}

function downloadErrors() {
    if (!lastPreview) return;
    var bad = (lastPreview.rows || []).filter(function (r) { return !r.ok; });

    // Van xuat CSV chu khong xuat .xlsx: sinh file .xlsx phai lam o server (bo
    // ghi nam trong C#), ma day la danh sach de gui lai cho ben cap du lieu, mo
    // bang Excel la doc duoc. Giu BOM o dau de Excel khong lam hong dau tieng Viet.
    var csv = '﻿dong,ma_dinh_danh,ten_dinh_danh,bien_so,ten_phuong_tien,' +
              'ten_khach_hang,phan_loai_tai_trong,ngay_het_han,ly_do_bo_qua\r\n';
    bad.forEach(function (r) {
        csv += [r.line, r.card_code, r.card_no, r.plate, r.vehicle_name,
                r.customer_name, r.weight_text, r.expiry_date, r.reject]
                 .map(function (v) { return '"' + String(v === null || v === undefined ? '' : v).replace(/"/g, '""') + '"'; })
                 .join(',') + '\r\n';
    });
    var a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8;' }));
    a.download = 'dong_bi_bo_qua.csv';
    a.click();
    URL.revokeObjectURL(a.href);
}

document.addEventListener('DOMContentLoaded', loadCards);
</script>
