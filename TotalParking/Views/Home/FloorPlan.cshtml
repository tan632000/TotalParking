<!-- Interactive CAD Map & Tooltip CSS Stylesheet -->
<style>
    /* SVG Pointer Lines */
    .pointer-line {
        stroke: rgba(148, 163, 184, 0.3);
        stroke-width: 1.5;
        stroke-dasharray: 4 4;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    /* Highlight states for lines */
    .pointer-line.active {
        stroke: #FACC15;
        stroke-width: 2.5;
        stroke-dasharray: 0;
        filter: drop-shadow(0 0 4px rgba(250, 204, 21, 0.6));
    }

    /* Interactive SVG Polygons */
    .zone-link {
        cursor: pointer;
        outline: none;
    }

    .zone-polygon {
        fill: rgba(255, 255, 255, 0);
        stroke: transparent;
        stroke-width: 2.5;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Zone dang duoc dieu huong toi.
       Dung class RIENG, khong dung .active cua hover: hai thu phai doc lap.
       Neu dung chung thi khi nhan vien tro chuot sang zone khac roi bo ra,
       lop hover se xoa luon dau hieu dieu huong — mat thong tin dang can nhat. */
    .zone-polygon.routed {
        fill: rgba(34, 197, 94, 0.18);
        stroke: rgb(34, 197, 94);
        stroke-width: 3.5;
        animation: routedPulse 1.4s ease-in-out infinite;
    }

    @@keyframes routedPulse {
        0%, 100% { filter: drop-shadow(0 0 6px rgba(34, 197, 94, 0.55)); }
        50%      { filter: drop-shadow(0 0 18px rgba(34, 197, 94, 0.95)); }
    }

    .zone-callout.routed {
        border-color: rgb(34, 197, 94) !important;
        box-shadow: 0 0 16px rgba(34, 197, 94, 0.55) !important;
    }

    /* Bang theo doi xe vao */
    .routing-feed {
        max-height: 320px;
        overflow-y: auto;
    }

    .routing-row {
        display: grid;
        grid-template-columns: 62px 1fr 78px 74px;
        gap: 8px;
        align-items: center;
        padding: 6px 8px;
        border-bottom: 1px solid rgba(51, 65, 85, 0.6);
        font-size: 11px;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    }

    .routing-row.fresh {
        animation: freshFlash 2s ease-out 1;
    }

    @@keyframes freshFlash {
        0%   { background: rgba(34, 197, 94, 0.28); }
        100% { background: transparent; }
    }

    .routing-badge {
        display: inline-block;
        padding: 1px 6px;
        border-radius: 3px;
        font-weight: 700;
        font-size: 10px;
        text-align: center;
    }

    .badge-routed      { background: rgba(34, 197, 94, 0.18);  color: rgb(74, 222, 128); }
    .badge-nocapacity  { background: rgba(245, 158, 11, 0.18); color: rgb(251, 191, 36); }
    .badge-manual      { background: rgba(59, 130, 246, 0.18); color: rgb(96, 165, 250); }
    .badge-rejected    { background: rgba(239, 68, 68, 0.18);  color: rgb(248, 113, 113); }
    .badge-none        { background: rgba(100, 116, 139, 0.18); color: rgb(148, 163, 184); }

    /* Polygons glow borders on active/hover */
    .zone-polygon.zone-1.active, .zone-polygon.zone-1:hover {
        fill: rgba(234, 179, 8, 0.15);
        stroke: rgb(234, 179, 8);
        filter: drop-shadow(0 0 8px rgba(234, 179, 8, 0.5));
    }

    .zone-polygon.zone-2.active, .zone-polygon.zone-2:hover {
        fill: rgba(148, 163, 184, 0.15);
        stroke: rgb(148, 163, 184);
        filter: drop-shadow(0 0 8px rgba(148, 163, 184, 0.5));
    }

    .zone-polygon.zone-3.active, .zone-polygon.zone-3:hover {
        fill: rgba(249, 115, 22, 0.15);
        stroke: rgb(249, 115, 22);
        filter: drop-shadow(0 0 8px rgba(249, 115, 22, 0.5));
    }

    .zone-polygon.zone-4.active, .zone-polygon.zone-4:hover {
        fill: rgba(168, 85, 247, 0.15);
        stroke: rgb(168, 85, 247);
        filter: drop-shadow(0 0 8px rgba(168, 85, 247, 0.5));
    }

    .zone-polygon.zone-5.active, .zone-polygon.zone-5:hover {
        fill: rgba(6, 182, 212, 0.15);
        stroke: rgb(6, 182, 212);
        filter: drop-shadow(0 0 8px rgba(6, 182, 212, 0.5));
    }

    .zone-polygon.zone-6.active, .zone-polygon.zone-6:hover {
        fill: rgba(34, 197, 94, 0.15);
        stroke: rgb(34, 197, 94);
        filter: drop-shadow(0 0 8px rgba(34, 197, 94, 0.5));
    }

    /* SCADA CAD Overlay Labels style */
    .map-label {
        font-family: 'Courier New', monospace;
        font-weight: bold;
        font-size: 13px;
        pointer-events: none;
        user-select: none;
        transition: all 0.3s;
    }
    
    .map-label-1 { fill: rgb(234, 179, 8); text-shadow: 0 0 4px rgba(234, 179, 8, 0.4); }
    .map-label-2 { fill: rgb(148, 163, 184); text-shadow: 0 0 4px rgba(148, 163, 184, 0.4); }
    .map-label-3 { fill: rgb(249, 115, 22); text-shadow: 0 0 4px rgba(249, 115, 22, 0.4); }
    .map-label-4 { fill: rgb(168, 85, 247); text-shadow: 0 0 4px rgba(168, 85, 247, 0.4); }
    .map-label-5 { fill: rgb(6, 182, 212); text-shadow: 0 0 4px rgba(6, 182, 212, 0.4); }
    .map-label-6 { fill: rgb(34, 197, 94); text-shadow: 0 0 4px rgba(34, 197, 94, 0.4); }

    .zone-interactive:hover .map-label {
        font-size: 15px;
    }

    /* HTML Callout Cards (Fixed absolute coordinates relative to aspect-ratio frame) */
    .zone-callout {
        position: absolute;
        width: 145px;
        padding: 8px;
        background: rgba(15, 23, 42, 0.85);
        backdrop-filter: blur(3px);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 6px;
        cursor: pointer;
        user-select: none;
        z-index: 30;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.4);
        transform: translate(-50%, -50%) scale(1);
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Callout Card Inner Typography */
    .callout-header {
        font-size: 9px;
        font-weight: 800;
        text-transform: uppercase;
        color: #94A3B8;
        border-b: 1px solid rgba(255, 255, 255, 0.1);
        padding-bottom: 3px;
        margin-bottom: 4px;
        letter-spacing: 0.05em;
    }

    .callout-detail {
        font-size: 9px;
        font-family: monospace;
        color: #CBD5E1;
        line-height: 1.3;
    }

    .callout-density {
        font-size: 9px;
        font-weight: 700;
        margin-top: 4px;
        padding-top: 3px;
        border-t: 1px solid rgba(255, 255, 255, 0.06);
        color: #38BDF8;
    }

    /* Callout Card Active / Hover (Yellow Mockup Style) */
    .zone-callout.active, .zone-callout:hover {
        background: rgb(250, 204, 21);
        border: 2px solid rgb(15, 23, 42);
        color: rgb(15, 23, 42);
        transform: translate(-50%, -50%) scale(1.08);
        box-shadow: 0 10px 25px rgba(250, 204, 21, 0.6);
        z-index: 40;
    }

    .zone-callout.active .callout-header, .zone-callout:hover .callout-header {
        color: rgb(15, 23, 42);
        font-weight: 900;
        border-b-color: rgba(15, 23, 42, 0.25);
    }

    .zone-callout.active .callout-detail, .zone-callout:hover .callout-detail {
        color: rgb(15, 23, 42);
        font-weight: 600;
    }

    .zone-callout.active .callout-density, .zone-callout:hover .callout-density {
        color: rgb(15, 23, 42);
        font-weight: 900;
        border-t-color: rgba(15, 23, 42, 0.15);
    }
</style>

<!-- Javascript for Bidirectional Highlight Event Handling -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const interactives = document.querySelectorAll(".zone-interactive");

        interactives.forEach(elem => {
            elem.addEventListener("mouseenter", function () {
                const zone = this.getAttribute("data-zone");
                highlightZone(zone, true);
            });

            elem.addEventListener("mouseleave", function () {
                const zone = this.getAttribute("data-zone");
                highlightZone(zone, false);
            });
        });

        function highlightZone(zoneId, isActive) {
            const polygon = document.querySelector(`.zone-polygon.zone-${zoneId}`);
            const callout = document.querySelector(`.zone-callout[data-zone="${zoneId}"]`);
            const line = document.querySelector(`.pointer-line-${zoneId}`);
            const mapLabel = document.querySelector(`.map-label-${zoneId}`);

            if (isActive) {
                if (polygon) polygon.classList.add("active");
                if (callout) callout.classList.add("active");
                if (line) line.classList.add("active");
                if (mapLabel) mapLabel.style.fontSize = "16px";
            } else {
                if (polygon) polygon.classList.remove("active");
                if (callout) callout.classList.remove("active");
                if (line) line.classList.remove("active");
                if (mapLabel) mapLabel.style.fontSize = "13px";
            }
        }
    });
</script>

<!-- Điều hướng thời gian thực: poll snapshot rồi tô zone được chỉ định -->
<script>
    (function () {
        var URL = "@Url.Action("RoutingState", "Monitor")";
        var POLL_MS = 2000;

        // Nhớ event_id đã thấy để chỉ nháy sáng dòng MỚI. Không có nó thì mỗi
        // nhịp poll cả bảng lại nháy, và mắt không phân biệt được xe nào vừa vào.
        var seen = {};
        var firstLoad = true;
        var routedZone = null;
        var timer = null;

        var statusEl = document.getElementById("feed-status");
        var feedEl = document.getElementById("routing-feed");

        function setStatus(text, cls) {
            if (!statusEl) return;
            statusEl.textContent = text;
            statusEl.className = "text-[10px] font-mono " + cls;
        }

        // Tô zone đang được điều hướng tới. Dùng class .routed riêng, không dùng
        // .active — xem ghi chú ở phần CSS.
        function markRoutedZone(zoneId) {
            if (routedZone === zoneId) return;

            document.querySelectorAll(".zone-polygon.routed, .zone-callout.routed")
                .forEach(function (el) { el.classList.remove("routed"); });

            routedZone = zoneId;
            if (zoneId === null || zoneId === undefined) return;

            var poly = document.querySelector(".zone-polygon.zone-" + zoneId);
            var callout = document.querySelector('.zone-callout[data-zone="' + zoneId + '"]');
            if (poly) poly.classList.add("routed");
            if (callout) callout.classList.add("routed");
        }

        // Cập nhật con số mật độ trong callout bằng số thật từ DB.
        // Các con số cứng trong markup là mock lúc dựng giao diện.
        function updateCallouts(zones) {
            zones.forEach(function (z) {
                var callout = document.querySelector(
                    '.zone-callout[data-zone="' + z.zone_id + '"]');
                if (!callout) return;

                var details = callout.querySelectorAll(".callout-detail");
                if (details.length >= 2) {
                    details[0].textContent = "+ Pallet trống: " + z.free_mech;
                    details[1].textContent = "+ Tầng dưới: " + z.free_tier0;
                }

                var density = callout.querySelector(".callout-density");
                if (density) {
                    density.textContent = z.total === 0
                        ? "Chưa có dữ liệu block"
                        : "Mật độ: " + z.in_use + "/" + z.total + " (" + z.used_pct + "%)";
                }
            });
        }

        function badgeFor(outcome) {
            switch (outcome) {
                case "ROUTED":      return ["badge-routed", "ĐÃ CHỈ"];
                case "NO_CAPACITY": return ["badge-nocapacity", "HẾT CHỖ"];
                case "MANUAL":      return ["badge-manual", "CHỜ NV"];
                case "REJECTED":    return ["badge-rejected", "TỪ CHỐI"];
                default:            return ["badge-none", "—"];
            }
        }

        function renderFeed(recent) {
            if (!feedEl) return;

            if (!recent.length) {
                feedEl.innerHTML =
                    '<div class="routing-row text-slate-500">' +
                    '<div>--:--:--</div><div>chưa có xe nào</div><div></div><div></div></div>';
                return;
            }

            feedEl.innerHTML = recent.map(function (v) {
                var b = badgeFor(v.outcome);
                // Lần tải đầu không nháy: cả bảng đều "mới" với trình duyệt
                // nhưng không có xe nào vừa vào thật.
                var isFresh = !firstLoad && !seen[v.event_id];
                seen[v.event_id] = true;

                var name = v.vehicle || v.category || "(không rõ)";
                var cls = v.weight_class ? v.weight_class : "?";
                var zone = v.zone_code
                    ? '<span class="text-emerald-400 font-bold">' + v.zone_code + "</span>"
                    : '<span class="text-slate-600">—</span>';

                return '<div class="routing-row' + (isFresh ? " fresh" : "") + '">' +
                       "<div class=\"text-slate-400\">" + v.at + "</div>" +
                       "<div class=\"text-slate-200 truncate\" title=\"" +
                           (v.reason || "") + '">' + name +
                           ' <span class="text-slate-500">· ' + cls + "</span></div>" +
                       '<div><span class="routing-badge ' + b[0] + '">' + b[1] + "</span></div>" +
                       "<div>" + zone + "</div>" +
                       "</div>";
            }).join("");
        }

        function tick() {
            fetch(URL, { cache: "no-store" })
                .then(function (res) {
                    if (!res.ok) throw new Error("HTTP " + res.status);
                    return res.json();
                })
                .then(function (data) {
                    if (data.error) throw new Error(data.error);
                    updateCallouts(data.zones || []);
                    renderFeed(data.recent || []);
                    markRoutedZone(data.latest_zone);
                    firstLoad = false;
                    setStatus("cập nhật " + data.now, "text-emerald-500");
                })
                .catch(function (err) {
                    // Chưa chạy migration 05/07/08 là trạng thái bình thường lúc
                    // dựng hệ thống. Báo ra chứ không im lặng, và không dừng poll.
                    setStatus("lỗi: " + err.message, "text-amber-500");
                });
        }

        function start() {
            if (timer) return;
            tick();
            timer = setInterval(tick, POLL_MS);
        }

        function stop() {
            if (!timer) return;
            clearInterval(timer);
            timer = null;
        }

        // Tab ở nền thì ngừng poll. Trang này hay được mở rồi để đó cả ngày trên
        // màn hình phòng điều khiển; poll khi không ai xem chỉ tốn kết nối DB.
        document.addEventListener("visibilitychange", function () {
            if (document.hidden) stop(); else start();
        });

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", start);
        } else {
            start();
        }
    })();
</script>