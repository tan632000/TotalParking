@{
    Layout = "~/Views/Shared/_ScadaLayout.cshtml";
}

<div class="p-6 pb-12 min-h-[calc(100vh-3.5rem)] text-slate-100" style="background: rgb(15, 23, 42); font-family: 'Inter', system-ui, -apple-system, sans-serif;">
    <div class="space-y-6">
        <!-- Header -->
        <div class="flex justify-between items-center pb-4 border-b border-slate-800">
            <div>
                <h1 class="text-2xl font-bold tracking-tight">Ma Trận An Toàn &amp; Quản Lý Bypass (Safety Interlock)</h1>
                <p class="text-slate-400 text-sm mt-1">Giám sát các điều kiện Safety Interlock trước khi chạy và kiểm soát trạng thái Bypass cưỡng bức cảm biến.</p>
            </div>
        </div>

        <!-- Bypass Banner Warning -->
        <div id="bypassBanner" class="hidden flex items-center justify-between p-3 rounded-lg border border-amber-500/35 bg-amber-500/10 text-amber-300 animate-pulse">
            <div class="flex items-center gap-2.5">
                <span class="relative flex h-2 w-2">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"></span>
                </span>
                <span class="text-xs font-semibold uppercase tracking-wider font-mono">CÓ BYPASS ĐÃ ĐƯỢC GHI NHẬN TẠI HIỆN TRƯỜNG</span>
            </div>
            <span class="text-[10px] font-mono text-amber-400">Bản ghi trên máy này, không phải lệnh xuống thiết bị</span>
        </div>

        <!-- Main Layout Split -->
        <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
            <!-- Left 2 Columns: Safety Interlock Matrix -->
            <div class="xl:col-span-2 space-y-6">
                <div class="bg-slate-900/50 rounded-xl border border-slate-800 shadow-xl overflow-hidden">
                    <div class="p-4 bg-slate-900/80 border-b border-slate-800 flex justify-between items-center">
                        <h3 class="text-white text-sm font-bold flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-500"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path></svg>
                            Ma Trận Điều Kiện An Toàn Hệ Thống (Safety Interlock Matrix)
                        </h3>
                        @* Nhan cu ghi "Quet chu ky: 500ms" trong khi trang khong goi may chu lan
                           nao. Gio la nhip doc that, va bao ro khi khong doc duoc. *@
                        <span id="sf-nhip" class="text-[10px] font-mono text-slate-500">đang đọc…</span>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-xs font-mono text-left">
                            <thead class="border-b border-slate-800 bg-slate-850">
                                <tr>
                                    <th class="px-4 py-2.5 font-bold text-slate-400">STT</th>
                                    <th class="px-4 py-2.5 font-bold text-slate-400">Điều kiện an toàn</th>
                                    <th class="px-4 py-2.5 font-bold text-slate-400">Vị trí</th>
                                    <th class="px-4 py-2.5 font-bold text-slate-400">Trạng thái</th>
                                    <th class="px-4 py-2.5 font-bold text-slate-400">Hành động đề xuất</th>
                                </tr>
                            </thead>
                            <tbody id="interlockTableBody">
                                <!-- Dynamic JS render -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Right Column: Bypass Manager Form & Active Bypasses -->
            <div class="space-y-6">
                <!-- Form to Add Bypass -->
                <div class="bg-slate-900/50 rounded-xl border border-slate-800 p-5 shadow-xl space-y-4">
                    <h3 class="text-white text-sm font-bold flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-amber-500"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                        Ghi nhận Bypass đã thực hiện tại hiện trường
                    </h3>

                    <div class="space-y-3">
                        <div>
                            <label class="text-slate-500 text-[10px] font-mono uppercase block mb-1">Thiết bị / Cảm biến</label>
                            <select id="bypassDevice" class="w-full bg-slate-800/60 border border-slate-700/50 rounded px-2.5 py-1.5 text-xs text-slate-200 font-mono outline-none focus:border-blue-500 transition-colors">
                                <option value="SafeGuard">Photogate - Cảm biến an toàn</option>
                                <option value="LimitSwitch">LS-T3 - Cảm biến hành trình</option>
                                <option value="MotorOverload">Lift Motor - Quá tải động cơ nâng</option>
                            </select>
                        </div>
                        <div>
                            <label class="text-slate-500 text-[10px] font-mono uppercase block mb-1">Vị trí Block đỗ</label>
@* Bon lua chon cu la ten khoi bia. Bai that co 118 khoi danh so. *@
                            <select id="bypassBlock" class="w-full bg-slate-800/60 border border-slate-700/50 rounded px-2.5 py-1.5 text-xs text-slate-200 font-mono outline-none focus:border-blue-500 transition-colors">
                                <option value="">đang đọc…</option>
                            </select>
                        </div>
                        <div>
                            <label class="text-slate-500 text-[10px] font-mono uppercase block mb-1">Thời gian tự động tắt (Timeout)</label>
                            <select id="bypassTimeout" class="w-full bg-slate-800/60 border border-slate-700/50 rounded px-2.5 py-1.5 text-xs text-slate-200 font-mono outline-none focus:border-blue-500 transition-colors">
                                <option value="5">5 phút</option>
                                <option value="15">15 phút</option>
                                <option value="30">30 phút</option>
                                <option value="60">60 phút (1 giờ)</option>
                            </select>
                        </div>
                        <div>
                            <label class="text-slate-500 text-[10px] font-mono uppercase block mb-1">Lý do Bypass (Bắt buộc)</label>
                            <textarea id="bypassReason" class="w-full h-16 bg-slate-800/60 border border-slate-700/50 rounded px-2.5 py-1.5 text-xs text-slate-200 font-mono outline-none focus:border-blue-500 transition-colors resize-none" placeholder="Vd: Bảo trì cơ khí định kỳ, sensor báo lỗi giả..."></textarea>
                        </div>
                        @* Nut nay GHI LAI mot quyet dinh da xay ra ngoai hien truong. He thong
                           khong co duong nao gui lenh bypass xuong thiet bi: toan bo he
                           thong chi co 4 lenh ghi xuong PLC (PlcConnection.cs) va khong
                           lenh nao lien quan cam bien an toan. Nhan cu ghi "Kich hoat
                           Bypass" va bao "thanh cong" — nguoi van hanh co the tin rang
                           cam bien da duoc vo hieu hoa that. *@
                        <button onclick="addBypass()" title="Chỉ lưu lại trên máy này để người trực sau biết. Hệ thống không gửi lệnh bypass xuống thiết bị." class="w-full py-2 bg-amber-600 hover:bg-amber-500 text-slate-900 rounded text-xs font-bold shadow transition-colors flex items-center justify-center gap-1.5">
                            Ghi nhận Bypass
                        </button>
                        <p class="text-[10px] text-slate-500 leading-relaxed">Chỉ lưu lại trên máy này. Muốn vô hiệu hoá cảm biến thật phải thao tác tại tủ điện.</p>
                    </div>
                </div>

                <!-- Bypasses List -->
                <div class="bg-slate-900/50 rounded-xl border border-slate-800 p-5 shadow-xl space-y-4">
                    <h3 class="text-white text-sm font-bold flex items-center gap-2">
                        Danh sách Sensor đang Bypass
                    </h3>
                    <div id="activeBypassesList" class="space-y-3">
                        <!-- Rendered by JS -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Mock Safety Interlock Matrix Database
    // ===================== CO NGUON HAY KHONG =====================
    // `nguon` noi ro he thong co quan sat duoc dieu kien nay khong:
    //
    //   "canh_bao"  -> suy tu bang canh_bao that, doc qua /Alarm/List
    //   null        -> KHONG co cam bien nao noi vao SCADA
    //
    // Truoc day ca 13 dong deu mang mot trang thai viet cung (11 dong "OK", 1
    // "WAIT", 1 "FAIL" o mot khoi khong ton tai). Mot bang khoa lien dong bao
    // OK vi no duoc go san chu OK la loai sai nguy hiem nhat trong ca he thong:
    // nguoi van hanh doc bang nay TRUOC khi cho thiet bi chay.
    //
    // Vong quet PLC hien chi doc thanh ghi o do va trang thai ket noi. Khong co
    // photogate, light curtain, cam bien hien dien, encoder, phanh hay VFD nao
    // duoc dua ve SCADA — da tra information_schema, khong bang nao luu chung.
    let baseInterlocks = [
        { id: 1,  name: "E-Stop không bị nhấn",                loc: "Tất cả vị trí",  action: "Kiểm tra nút E-Stop tại các trạm",           key: "estop",     nguon: "canh_bao" },
        { id: 2,  name: "Cửa an toàn đã đóng",                 loc: "Cổng vào/ra",    action: "Kiểm tra cơ cấu sensor đóng cửa",            key: "door",      nguon: null },
        { id: 3,  name: "Light curtain không bị che",          loc: "Khu vực pallet", action: "Test & căn chỉnh tia quang photogate",       key: "curtain",   nguon: null },
        { id: 4,  name: "Không có người trong vùng nguy hiểm", loc: "Tầng hầm B1",    action: "Chờ tín hiệu clear từ sensor hiện diện",     key: "person",    nguon: null },
        { id: 5,  name: "Xe không quá khổ",                    loc: "Cổng vào",       action: "AI-VDS đo quét & duyệt chiều cao xe",        key: "oversized", nguon: null },
        { id: 6,  name: "Pallet đúng vị trí khóa",             loc: "Block chỉ định", action: "Sensor vị trí Encoder/Limit Switch xác nhận", key: "pallet",   nguon: null },
        { id: 7,  name: "Sensor hành trình hợp lệ",            loc: "Tất cả cơ cấu",  action: "Kiểm tra tín hiệu đầu vào limit switch",     key: "limit",     nguon: null },
        { id: 8,  name: "Khóa cơ khí đã nhả",                  loc: "Tất cả block",   action: "Kiểm tra actuator khóa cơ khí chống rơi",    key: "mechlock",  nguon: null },
        { id: 9,  name: "Phanh motor sẵn sàng",                loc: "Tất cả motor",   action: "Brake released confirmed (cuộn hút phanh)",  key: "brake",     nguon: null },
        { id: 10, name: "VFD không có lỗi",                    loc: "Tất cả VFD",     action: "Đọc mã lỗi trên màn hình LCD của biến tần",  key: "vfd",       nguon: null },
        { id: 11, name: "PLC đang kết nối",                    loc: "Tất cả block",   action: "Kiểm tra đường truyền tới PLC của block",    key: "plc",       nguon: "canh_bao" },
        { id: 12, name: "Không có lệnh xung đột",              loc: "Hệ thống",       action: "Clear hàng đợi lệnh điều phối",              key: "conflict",  nguon: null },
        { id: 13, name: "Block liền kề không gây nguy hiểm",   loc: "Block liền kề",  action: "Chờ block liền kề chạy xong chu kỳ",         key: "adjacent",  nguon: null }
    ];

    // ===================== NGUON DU LIEU =====================
    var URL_ALARM = "@Url.Action("List", "Alarm")";
    var NHIP_MS   = 15000;
    var canhBao   = [];
    var loiDoc    = null;

    function escS(v) {
        return String(v === null || v === undefined ? "" : v)
            .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;");
    }

    // Bypass ghi theo ten thiet bi; anh xa sang khoa dieu kien de mot ban ghi
    // hien dung dong cua no thay vi doan theo chuoi trong tung nhanh nhu truoc.
    const BYPASS_THEO_KHOA = {
        SafeGuard:     "curtain",
        LimitSwitch:   "limit",
        MotorOverload: "vfd"
    };

    function bypassCuaKhoa(khoa) {
        const ra = [];
        const bp = getBypasses();
        Object.keys(bp).forEach(function (blk) {
            (bp[blk] || []).forEach(function (dev) {
                if (BYPASS_THEO_KHOA[dev] === khoa) ra.push(blk);
            });
        });
        return ra;
    }

    function taiCanhBao() {
        return fetch(URL_ALARM, { cache: "no-store" })
            .then(function (r) {
                if (!r.ok) throw new Error("HTTP " + r.status);
                return r.json();
            })
            .then(function (d) {
                if (d && d.error) throw new Error(d.error);
                canhBao = (d && d.canh_bao) || [];
                loiDoc = null;
            })
            .catch(function (e) {
                // Khong doc duoc thi PHAI noi ra. Giu danh sach cu roi ve bang
                // binh thuong la cach te nhat: trang an toan trong nhu moi thu
                // deu on trong khi no dang mu.
                canhBao = [];
                loiDoc = e.message;
            })
            .then(function () { renderMatrix(); });
    }

    document.addEventListener("DOMContentLoaded", function() {
        initBypasses();
        renderMatrix();
        batDauDocCanhBao();
        napDanhSachKhoi();
        setInterval(checkSystemStates, 1000);
    });

    // Danh sach khoi cho o chon bypass, lay tu /Monitor/BlockMap.
    function napDanhSachKhoi() {
        const sel = document.getElementById("bypassBlock");
        if (!sel) return;
        fetch("@Url.Action("BlockMap", "Monitor")", { cache: "no-store" })
            .then(function (r) {
                if (!r.ok) throw new Error("HTTP " + r.status);
                return r.json();
            })
            .then(function (d) {
                const ds = (d && d.blocks) || [];
                if (!ds.length) throw new Error("không có khối nào");
                sel.innerHTML = ds.slice().sort(function (a, b) { return a.block_no - b.block_no; })
                    .map(function (b) {
                        return '<option value="Khối ' + b.block_no + '">Khối ' + b.block_no +
                               ' (Z' + b.zone_id + ')</option>';
                    }).join("");
            })
            .catch(function (e) {
                sel.innerHTML = '<option value="">không đọc được danh sách khối</option>';
            });
    }

    var timerCB = null;
    function batDauDocCanhBao() {
        if (timerCB) return;
        taiCanhBao();
        timerCB = setInterval(taiCanhBao, NHIP_MS);
    }

    document.addEventListener("visibilitychange", function () {
        if (document.hidden) { if (timerCB) { clearInterval(timerCB); timerCB = null; } }
        else batDauDocCanhBao();
    });

    function getBypasses() {
        let raw = localStorage.getItem("occBypassedSensors");
        return raw ? JSON.parse(raw) : {};
    }

    function initBypasses() {
        let bypasses = getBypasses();
        renderBypassesList(bypasses);
    }

    function addBypass() {
        const device = document.getElementById("bypassDevice").value;
        const block = document.getElementById("bypassBlock").value;
        const timeout = parseInt(document.getElementById("bypassTimeout").value);
        const reason = document.getElementById("bypassReason").value.trim();

        if (!reason) {
            alert("Vui lòng nhập lý do Bypass!");
            return;
        }

        let bypasses = getBypasses();
        const blockKey = block.replace("Block ", ""); // Vd: "A-01", "B-04"
        
        if (!bypasses[blockKey]) bypasses[blockKey] = [];
        
        // Check if already bypassed
        if (bypasses[blockKey].includes(device)) {
            alert("Cảm biến này tại block đã được Bypass trước đó!");
            return;
        }

        bypasses[blockKey].push(device);
        localStorage.setItem("occBypassedSensors", JSON.stringify(bypasses));

        // Save detailed log
        let bypassLogs = localStorage.getItem("occBypassLogs") ? JSON.parse(localStorage.getItem("occBypassLogs")) : [];
        const expTime = new Date(Date.now() + timeout * 60 * 1000).toLocaleTimeString();
        bypassLogs.push({
            device,
            block,
            reason,
            user: "Supervisor_01",
            timestamp: new Date().toLocaleTimeString(),
            expiry: expTime
        });
        localStorage.setItem("occBypassLogs", JSON.stringify(bypassLogs));

        // Clear form
        document.getElementById("bypassReason").value = "";
        
        initBypasses();
        renderMatrix();
        alert("Đã ghi nhận bypass trên máy này. Hệ thống không gửi lệnh xuống thiết bị.");
    }

    function removeBypass(blockKey, device) {
        let bypasses = getBypasses();
        if (bypasses[blockKey]) {
            bypasses[blockKey] = bypasses[blockKey].filter(d => d !== device);
            if (bypasses[blockKey].length === 0) {
                delete bypasses[blockKey];
            }
        }
        localStorage.setItem("occBypassedSensors", JSON.stringify(bypasses));
        initBypasses();
        renderMatrix();
    }

    function renderBypassesList(bypasses) {
        const listContainer = document.getElementById("activeBypassesList");
        listContainer.innerHTML = "";
        
        let count = 0;
        for (const [block, devices] of Object.entries(bypasses)) {
            devices.forEach(dev => {
                count++;
                let devName = dev === "SafeGuard" ? "Photogate" : (dev === "LimitSwitch" ? "Limit Switch" : "Motor Overload");
                
                const div = document.createElement("div");
                div.className = "bg-slate-800/40 border border-slate-700/60 p-3 rounded-lg flex justify-between items-start";
                div.innerHTML = `
                    <div>
                        <div class="font-bold text-amber-400 text-xs">${devName} – Block ${block}</div>
                        <div class="text-[10px] text-slate-500 mt-1 font-mono">Bởi: Supervisor_01</div>
                    </div>
                    <button onclick="removeBypass('${block}', '${dev}')" class="px-2 py-0.5 rounded text-[10px] font-bold bg-red-600/20 text-red-400 hover:bg-red-600/40 border border-red-500/25 transition-colors">
                        Gỡ bỏ
                    </button>
                `;
                listContainer.appendChild(div);
            });
        }

        const banner = document.getElementById("bypassBanner");
        if (count > 0) {
            banner.classList.remove("hidden");
        } else {
            banner.classList.add("hidden");
        }
    }

    function checkSystemStates() {
        renderMatrix();
    }

    function renderMatrix() {
        const tbody = document.getElementById("interlockTableBody");
        tbody.innerHTML = "";

        const nhan = document.getElementById("sf-nhip");
        if (nhan) {
            nhan.textContent = loiDoc
                ? ("không đọc được cảnh báo: " + loiDoc)
                : ("đọc cảnh báo mỗi " + (NHIP_MS / 1000) + "s · " + canhBao.length + " bản ghi");
            nhan.className = "text-[10px] font-mono " + (loiDoc ? "text-red-400" : "text-slate-500");
        }

        // Doc bypass tu localStorage cua chinh trang nay (ban ghi tai cho).
        let bypasses = getBypasses();

        // ===================== NGUON DUY NHAT LA canh_bao =====================
        // Ban truoc doc activeAlarms trong localStorage, tuc la phu thuoc vao
        // viec nguoi dung da mo trang Dashboard truoc do hay chua. Mo thang
        // trang nay dau tien thi ma tran khong co du lieu nao.
        //
        // Ba phep suy dan cu — photogate, motor, limit switch — do chuoi mo ta
        // cua nhung canh bao GIA do triggerMockFault sinh ra. Ham do da bi go,
        // va khong ma loi that nao (PLC-CONN-01, SLOT-DUP-01, SU-CO-KHAN) noi
        // ve cam bien quang hay cong tac hanh trinh. Giu lai chi la giu ba phep
        // kiem khong bao gio dung toi.
        const suCo   = canhBao.filter(a => a.ma_loi === "SU-CO-KHAN"  && !a.het_luc);
        const matPlc = canhBao.filter(a => a.ma_loi === "PLC-CONN-01" && !a.het_luc);

        baseInterlocks.forEach(item => {
            // Mac dinh la CHUA GIAM SAT, khong phai OK. Day la thay doi quan
            // trong nhat cua ca trang: mot dieu kien khong quan sat duoc phai
            // noi la khong biet, chu khong duoc bao an toan.
            let status = "CHUA_GIAM_SAT";
            let note   = item.action;

            // Khong doc duoc canh bao thi KHONG duoc bao OK. Mot trang an toan
            // hien OK trong luc no dang mu la truong hop te nhat: nguoi truc doc
            // bang nay TRUOC khi cho thiet bi chay, va "OK" o day nghia la
            // "da kiem tra, khong co van de" chu khong phai "khong biet".
            if (item.nguon === "canh_bao" && loiDoc) {
                status = "CHUA_GIAM_SAT";
                note = "Không đọc được cảnh báo từ máy chủ — không xác định được điều kiện này.";
            } else if (item.nguon === "canh_bao") {
                if (item.key === "estop") {
                    status = suCo.length ? "FAIL" : "OK";
                    note = suCo.length
                        ? ("Có " + suCo.length + " sự cố khẩn chưa xử lý: " +
                           suCo.map(a => a.thiet_bi || "?").join(", "))
                        : "Không có sự cố khẩn nào đang mở trong cơ sở dữ liệu.";
                } else if (item.key === "plc") {
                    status = matPlc.length ? "FAIL" : "OK";
                    note = matPlc.length
                        ? (matPlc.length + " khối đang mất kết nối PLC")
                        : "Không có cảnh báo mất kết nối PLC nào đang mở.";
                }
            }

            // Bypass la BAN GHI TAI CHO, khong phai lenh. Van hien de nguoi truc
            // biet co nguoi da bao cao bypass, nhung khong duoc bien mot dieu
            // kien "chua giam sat" thanh "an toan".
            const dsBypass = bypassCuaKhoa(item.key);
            if (dsBypass.length) {
                status = "BYPASSED";
                note = "Đã ghi nhận bypass tại hiện trường: " + dsBypass.join(", ");
            }

            let mau, chu;
            if (status === "OK") {
                mau = "text-emerald-400"; chu = "\u25cf OK";
            } else if (status === "FAIL") {
                mau = "text-rose-400"; chu = "\u25cf FAIL";
            } else if (status === "BYPASSED") {
                mau = "text-amber-400"; chu = "\u25cf BYPASS";
            } else {
                mau = "text-slate-500"; chu = "\u25cb chưa giám sát";
            }

            const tr = document.createElement("tr");
            tr.className = "border-b border-slate-800/40 hover:bg-slate-800/10";
            tr.innerHTML =
                '<td class="px-4 py-2.5 text-slate-500">' + item.id + '</td>' +
                '<td class="px-4 py-2.5 text-slate-200">' + escS(item.name) + '</td>' +
                '<td class="px-4 py-2.5 text-slate-400">' + escS(item.loc) + '</td>' +
                '<td class="px-4 py-2.5 font-bold ' + mau + '">' + chu + '</td>' +
                '<td class="px-4 py-2.5 text-slate-400">' + escS(note) + '</td>';
            tbody.appendChild(tr);
        });
    }
</script>
