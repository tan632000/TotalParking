            <table class="w-full text-left border-collapse text-xs">
                <thead>
                    <tr class="border-b border-slate-700">
                        <th class="py-1.5 pr-2 text-slate-500 font-medium text-[10px] uppercase tracking-wider">Lúc</th>
                        <th class="py-1.5 pr-2 text-slate-500 font-medium text-[10px] uppercase tracking-wider">Phương tiện</th>
                        <th class="py-1.5 pr-2 text-slate-500 font-medium text-[10px] uppercase tracking-wider">Hạng tải</th>
                        <th class="py-1.5 text-slate-500 font-medium text-[10px] uppercase tracking-wider">Kết quả</th>
                    </tr>
                </thead>
                <tbody id="dash-recent-tbody"></tbody>
            </table>
        </div>
    </div>
