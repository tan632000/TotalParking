<script>

    // ===================== CANH BAO THAT TU MAY CHU =====================
    // Truoc day khoi nay SINH canh bao gia ngay trong trinh duyet: ba kho cau
    // viet cung, mot vong setInterval 15 giay boc ngau nhien, mot bo sinh thu
    // nam suy tu palletCycleData, va ba canh bao bia chen khi danh sach ngan.
    // Ket qua: mot ma loi bia ghep voi zone va block boc ngau nhien — trong
    // khi he thong dung Omron FINS/TCP va CSDL khong co dong nao mang ma SYS-*.
    //
    // Nguy hiem nhat la no dung canh mot header DA hien so THAT: so dung dung
    // canh noi dung sai la tinh huong kho phat hien nhat.
    var NHIP_CANH_BAO_MS = 15000;
    var API_ALARM_LIST   = "@Url.Action("List", "Alarm")";
    var API_ALARM_ACK    = "@Url.Action("Ack", "Alarm")";
    var CAU_LOI_CANH_BAO = "Không đọc được cảnh báo từ máy chủ";

    // CHI chua canh bao CHUA XAC NHAN. Bang, ba bo dem va bieu ngu dung chung
    // dung mang nay — tron hai tap la tao ra canh "bo dem 14 dung tren bang 2
    // dong", dung loai loi khoi nay sinh ra de diet.
    let activeAlarms = [];
    let loiCanhBao = null;

    // nguon -> nhom hien co cua Dashboard. Gia tri la KHONG duoc lang le roi vao
    // nhom 2: de mot gia tri ENUM them sau nay lo ra thay vi bi giau.
    var NHOM_THEO_NGUON = { operation: 1, hardware: 2, maintenance: 3 };

    // Cot "Nguon phat": ghep tu ba truong, BO QUA phan thieu.
    // block_no la null voi canh bao SU-CO-KHAN, nen ghep thang se cho ra
    // "Block null" tren man hinh van hanh.
    function nguonPhat(c) {
        var phan = [];
        if (c.zone_id !== null && c.zone_id !== undefined) phan.push("Z" + c.zone_id);
        if (c.block_no !== null && c.block_no !== undefined) phan.push("Block " + c.block_no);
        if (c.thiet_bi) phan.push(c.thiet_bi);
        return phan.length ? phan.join(" · ") : "—";
    }

    function escCb(v) {
        return String(v === null || v === undefined ? "" : v)
            .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;");
    }

    // Don rac gia con ket trong localStorage, MOT LAN khi trang tai.
    //
    // Index tung la noi duy nhat cat mang nay (gioi han 8 phan tu) va ghi de no
    // moi lan tai trang. Thoi ghi ma khong don thi Diagnostics va Safety dong
    // bang vinh vien tren rac — o "su co dang cho xu ly khan cap" nhap nhay mai
    // khong tu het.
    //
    // KHONG removeItem: OperationControl van ghi ban ghi E-Stop vao khoa nay, va
    // ma tran an toan cua Safety do dung chuoi do.
    function donRacCanhBaoGia() {
        try {
            var tho = localStorage.getItem('activeAlarms');
            if (!tho) return;
            var ds = JSON.parse(tho);
            if (!Array.isArray(ds)) return;
            var giu = ds.filter(function (a) {
                if (!a) return false;
                if (a.code === "SU-CO-KHAN") return true;
                if (a.msg && String(a.msg).indexOf("E-Stop") >= 0) return true;
                return !/^(SYS-FLT|OP-ERR|MNT-DUE)-/.test(String(a.code || ""));
            });
            localStorage.setItem('activeAlarms', JSON.stringify(giu));
        } catch (e) {
            // localStorage co the nem o cua so an danh. Khong don duoc thi thoi;
            // khong duoc lam hong phan con lai cua trang.
        }
    }

    function renderAlarmsTable() {
        const tbody = document.getElementById('alarms-live-tbody');
        if (!tbody) return;
        tbody.innerHTML = '';

        // Khong doc duoc KHAC rong. Cau bao loi rieng, khong dung lai cau
        // "He thong van hanh an toan" — nguoi van hanh tin cau do nghia la sach.
        if (loiCanhBao) {
            tbody.innerHTML =
                '<tr><td colspan="6" class="py-8 text-center text-red-400">' +
                escCb(CAU_LOI_CANH_BAO) + ': ' + escCb(loiCanhBao) + '</td></tr>';
            return;
        }

        if (activeAlarms.length === 0) {
            tbody.innerHTML =
                '<tr><td colspan="6" class="py-8 text-center text-slate-500 italic">' +
                'Không có cảnh báo hoạt động. Hệ thống vận hành an toàn.</td></tr>';
            return;
        }

        // Sap xep theo xay_ra_luc (yyyy-MM-dd HH:mm:ss) chu KHONG theo HH:mm:ss:
        // qua nua dem thi 23:58 hom qua se xep tren 00:05 hom nay.
        const sorted = [...activeAlarms].sort(
            (a, b) => String(b.xay_ra_luc).localeCompare(String(a.xay_ra_luc)));

        sorted.forEach(function (alm) {
            var nhom = NHOM_THEO_NGUON[alm.nguon];
            var typeBadge = "", rowClass = "", codeColor = "";

            if (nhom === 1) {
                typeBadge = '<span class="px-1.5 py-0.5 rounded text-[9px] font-bold bg-amber-500/10 border border-amber-500/30 text-amber-400">LỖI THAO TÁC</span>';
                rowClass = "hover:bg-amber-950/10 transition-colors";
                codeColor = "text-amber-500";
            } else if (nhom === 2) {
                typeBadge = '<span class="px-1.5 py-0.5 rounded text-[9px] font-bold bg-red-500/15 border border-red-500/30 text-red-400 animate-pulse">LỖI THIẾT BỊ</span>';
                rowClass = "hover:bg-red-950/10 transition-colors";
                codeColor = "text-red-500 font-bold";
            } else if (nhom === 3) {
                typeBadge = '<span class="px-1.5 py-0.5 rounded text-[9px] font-bold bg-cyan-500/10 border border-cyan-500/30 text-cyan-400">ĐẾN HẠN BẢO TRÌ</span>';
                rowClass = "hover:bg-cyan-950/10 transition-colors";
                codeColor = "text-cyan-500";
            } else {
                // Gia tri nguon la: hien nguyen van thay vi giau vao mot nhom.
                typeBadge = '<span class="px-1.5 py-0.5 rounded text-[9px] font-bold bg-slate-800 border border-slate-700 text-slate-300">' +
                            escCb(alm.nguon) + '</span>';
                rowClass = "hover:bg-slate-800/40 transition-colors";
                codeColor = "text-slate-400";
            }

            // Hien DU ngay gio. Cat con HH:mm:ss thi mot su co tu ba hom truoc
            // hien "08:15:02" va truc ban doc thanh "sang nay" — truoc day vo hai
            // vi moi canh bao deu do trinh duyet vua sinh ra, gio thi bang chua
            // toan bo dong chua xac nhan trong CSDL, khong gioi han tuoi.
            var gio = String(alm.xay_ra_luc || "");
            const tr = document.createElement('tr');
            tr.id = 'alarm-tr-' + alm.id;
            tr.className = rowClass + ' border-b border-slate-900/60';
            tr.innerHTML =
                '<td class="py-3 px-3 text-slate-400 text-[11px] font-mono">' + escCb(gio) + '</td>' +
                '<td class="py-3 px-3 ' + codeColor + ' font-bold font-mono">' + escCb(alm.ma_loi) + '</td>' +
                '<td class="py-3 px-3">' + typeBadge + '</td>' +
                '<td class="py-3 px-3 text-slate-300 font-semibold font-mono">' + escCb(nguonPhat(alm)) + '</td>' +
                '<td class="py-3 px-3 text-slate-200 max-w-sm truncate" title="' + escCb(alm.mo_ta) + '">' + escCb(alm.mo_ta) + '</td>' +
                '<td class="py-3 px-3 text-center">' +
                '<button onclick="ackAlarm(' + alm.id + ')" class="px-2 py-1 bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white rounded text-[10px] font-bold transition-all border border-slate-750 font-mono">Xác nhận</button>' +
                '</td>';
            tbody.appendChild(tr);
        });
    }

    function updateCounters() {
        var dem = { 1: 0, 2: 0, 3: 0 };
        activeAlarms.forEach(function (a) {
            var n = NHOM_THEO_NGUON[a.nguon];
            if (n) dem[n]++;
        });
        var dat = function (id, v) {
            var e = document.getElementById(id);
            if (e) e.textContent = loiCanhBao ? "—" : v;
        };
        dat('active-operator-count', dem[1]);
        dat('active-system-count',   dem[2]);
        dat('active-maint-count',    dem[3]);
    }

    function updateGlobalBanner() {
        const banner = document.getElementById('global-alarm-banner');
        const countSpan = document.getElementById('global-alarm-banner-count');
        const detailSpan = document.getElementById('global-alarm-banner-detail');
        if (!banner || !countSpan || !detailSpan) return;

        // Khi LOI thi PHAI hien. An nghia la "khong co gi".
        if (loiCanhBao) {
            banner.classList.remove('hidden');
            countSpan.textContent = CAU_LOI_CANH_BAO + ':';
            detailSpan.textContent = loiCanhBao;
            return;
        }

        if (activeAlarms.length === 0) {
            banner.classList.add('hidden');
            countSpan.textContent = '0 cảnh báo đang hoạt động:';
            detailSpan.textContent = 'Không có cảnh báo hoạt động';
            return;
        }

        banner.classList.remove('hidden');
        countSpan.textContent = activeAlarms.length + ' cảnh báo đang hoạt động:';
        const moiNhat = [...activeAlarms].sort(
            (a, b) => String(b.xay_ra_luc).localeCompare(String(a.xay_ra_luc)))[0];
        detailSpan.textContent =
            '[' + moiNhat.ma_loi + '] ' + moiNhat.mo_ta + ' (' + nguonPhat(moiNhat) + ')';
    }

    function veCanhBao() {
        renderAlarmsTable();
        updateCounters();
        updateGlobalBanner();
    }

    function taiCanhBao() {
        return fetch(API_ALARM_LIST, { cache: "no-store" })
            .then(function (r) {
                if (!r.ok) throw new Error("HTTP " + r.status);
                return r.json();
            })
            .then(function (d) {
                if (d && d.error) throw new Error(d.error);
                // KHONG dung `|| []`: mot than {} tra ve cung HTTP 200 se cho
                // mang rong va bang hien "He thong van hanh an toan" dung luc
                // may chu dang mu.
                if (!d || !Array.isArray(d.canh_bao)) throw new Error("thiếu dữ liệu");
                loiCanhBao = null;
                activeAlarms = d.canh_bao.filter(function (c) { return c.chua_xac_nhan; });
                veCanhBao();
            })
            .catch(function (e) {
                loiCanhBao = e.message;
                activeAlarms = [];
                veCanhBao();
            });
    }

    // Ten tu khai — he thong chua co dang nhap, giong nut ACK o trang Canh bao.
    function ackAlarm(id) {
        var ten = prompt("Tên người xác nhận:");
        if (!ten || !ten.trim()) return;

        var than = new URLSearchParams();
        than.append("id", id);
        than.append("nguoi", ten.trim());

        fetch(API_ALARM_ACK, { method: "POST", body: than })
            .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, status: r.status, d: d }; }); })
            .then(function (kq) {
                if (!kq.ok && kq.status !== 409)
                    alert("Không xác nhận được: " + ((kq.d && kq.d.error) || kq.status));
                return taiCanhBao();
            })
            .catch(function (e) { alert("Không gọi được máy chủ: " + e.message); });
    }

    // Guard if (!timer) / timer = null: thieu no thi moi lan visibilitychange
    // bao hien ma khong co lan an tuong ung se sinh them mot interval va mat
    // handle cu — man hinh tuong mo vai ngay se co hang chuc poller.
    var timerCanhBao = null;

    function initAlarms() {
        donRacCanhBaoGia();
        if (!timerCanhBao) {
            taiCanhBao();
            timerCanhBao = setInterval(taiCanhBao, NHIP_CANH_BAO_MS);
        }
    }

    document.addEventListener("visibilitychange", function () {
        if (document.hidden) {
            if (timerCanhBao) { clearInterval(timerCanhBao); timerCanhBao = null; }
        } else {
            initAlarms();
        }
    });

    // Initialize alarms on page load
    document.addEventListener("DOMContentLoaded", () => {
        initAlarms();
    });
</script>
</div>

@* =====================================================================
   DỮ LIỆU THẬT CHO DASHBOARD — specs/monitoring-real-data task-01

   Khối này đặt SAU toàn bộ khối alarm ở trên và không chạm vào nó.
   Alarm ĐÃ đọc từ GET /Alarm/List (packet dashboard-canh-bao-that). Khối này vì
   activeAlarms là hợp đồng localStorage liên trang (CLAUDE.md mục 2).

   Khuôn fetch/render/poll sao chép từ FloorPlan.cshtml:471,581-600,
   KHÁC một điểm: khi lỗi phải đặt ô số về em dash chứ không giữ số cũ.
   Giữ số cũ khi mất nguồn là nói dối người trực.
   ===================================================================== *@
<script>
    (function () {
        "use strict";

        var URL_CAPACITY = "@Url.Action("RoutingState", "Monitor")";
        var URL_DEVICE   = "@Url.Action("Summary", "DeviceStatus")";
        var URL_BLOCKS   = "@Url.Action("BlockMap", "Monitor")";
        var POLL_MS      = 5000;
        var GACH         = "—";   // em dash, dùng làm dấu "chưa có số"

        var timer = null;

        function el(id) { return document.getElementById(id); }

        function dat(id, giaTri) {
            var e = el(id);
            if (e) e.textContent = giaTri;
        }

        // Xoá sạch mọi ô số. Gọi khi mất nguồn — xem chú thích đầu khối.
        function xoaHet() {
            dat("kpi-total", GACH);
            dat("kpi-inuse", GACH);
            dat("kpi-free", GACH);
            dat("kpi-pct", GACH);
            dat("kpi-khoi", GACH);

            // Luoi khoi cung phai sach. Truoc day cho nay la 9 the viet cung
            // (ten khoi bia kem ty le lap day), khong ham nao ghi de, nen khi may chu
            // chet thi cac con so KPI o tren doi thanh dau gach trong khi ban do
            // khoi ngay duoi van bao 86 xe — nguoi truc doc cai nao?
            var luoi = el("dashBlocksGrid");
            if (luoi) {
                luoi.innerHTML = '<div class="col-span-full text-center text-red-400 ' +
                                 'text-xs py-6">Không đọc được danh sách khối.</div>';
            }
            dat("dashKhoiLoi", GACH);
        }

        function datTrangThai(chu, mau) {
            var e = el("dash-status");
            if (!e) return;
            e.textContent = chu;
            e.style.color = mau;
        }

        // ------------------------------------------------------------ khối
        // Bai that co 118 khoi danh so 1..118. Truoc day cho nay hien 9 the mang
        // ten theo khuon "Block <chu><so>" voi ty le lap day viet cung trong HTML.
        // Chung dung ngay canh so THAT (112/112 thiet bi, 12/12 LED) nen khong
        // cach nao phan biet bang mat.
        function veKhoi(blocks) {
            var luoi = el("dashBlocksGrid");
            if (!luoi) return;

            if (blocks.length === 0) {
                luoi.innerHTML = '<div class="col-span-full text-center text-slate-500 ' +
                                 'text-xs py-6">Chưa có khối nào trong cơ sở dữ liệu.</div>';
                dat("dashKhoiLoi", GACH);
                return;
            }

            var soMat = 0;
            var html = blocks.slice().sort(function (a, b) {
                return a.block_no - b.block_no;
            }).map(function (b) {
                var oCoXe = b.occupied || 0;
                var tongO = b.slots || 0;
                var pct = tongO > 0 ? Math.round(oCoXe / tongO * 100) : 0;
                if (!b.online) soMat++;

                // Mat ket noi KHAC voi trong: so o cua mot khoi khong doc duoc la
                // so doc duoc LAN CUOI, khong phai hien trang. Phai to mau khac.
                var mauCham = b.online ? "rgb(22, 163, 74)" : "rgb(220, 38, 38)";
                var vien = b.online ? "rgba(22, 163, 74, 0.267)" : "rgba(220, 38, 38, 0.4)";
                var nhan = b.online
                    ? '<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold" ' +
                      'style="background: rgb(22, 163, 74); color: white; font-size: 11px;">Bình thường</span>'
                    : '<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold" ' +
                      'style="background: rgb(220, 38, 38); color: white; font-size: 11px;">Mất kết nối</span>';

                // The <a> chu khong phai <button>: no thuc su di den trang zone.
                // Mot <button> khong lam gi la mot loi hua suong voi nguoi dung.
                return '<a href="/Home/Zones/' + b.zone_id + '" ' +
                       'class="rounded-lg p-3 text-left transition-all hover:scale-[1.02] hover:shadow-lg block" ' +
                       'style="background: rgb(15, 23, 42); border: 1px solid ' + vien + ';">' +
                         '<div class="flex items-center justify-between mb-1">' +
                           '<span style="color: rgb(248, 250, 252); font-size: 11px; font-weight: 600;">Khối ' +
                             b.block_no + '</span>' +
                           '<span class="w-2 h-2 rounded-full" style="background: ' + mauCham + ';"></span>' +
                         '</div>' +
                         '<div style="color: rgb(148, 163, 184); font-size: 10px;">Z' + b.zone_id + '</div>' +
                         '<div class="flex items-center justify-between mt-2">' +
                           '<span style="color: rgb(22, 163, 74); font-size: 13px; font-weight: 700;">' +
                             pct + '%</span>' +
                           '<span style="color: rgb(100, 116, 139); font-size: 10px;">' +
                             oCoXe + '/' + tongO + '</span>' +
                         '</div>' +
                         '<div class="h-1 rounded-full mt-1" style="background: rgb(51, 65, 85);">' +
                           '<div class="h-1 rounded-full" style="width: ' + pct +
                             '%; background: rgb(22, 163, 74);"></div>' +
                         '</div>' +
                         '<div class="mt-1.5">' + nhan + '</div>' +
                       '</a>';
            }).join("");

            luoi.innerHTML = html;
            dat("dashKhoiLoi", soMat === 0
                ? blocks.length + " khối, tất cả đang đọc được"
                : soMat + "/" + blocks.length + " khối mất kết nối");
        }

        // ---------------------------------------------------------- sức chứa
        function veSucChua(zones, soKhoi) {
            var tong = 0, dangDung = 0;
            for (var i = 0; i < zones.length; i++) {
                tong     += zones[i].total  || 0;
                dangDung += zones[i].in_use || 0;
            }

            // tong = 0 nghĩa là chưa khai báo block, không phải bãi hết chỗ.
            // Chia cho 0 ở đây sẽ ra NaN và hiện "NaN%" trên màn hình vận hành.
            if (tong === 0) { xoaHet(); return; }

            dat("kpi-total", tong);
            dat("kpi-inuse", dangDung);
            // Σtotal − Σin_use. Không dùng free_mech + free_tier0 + free_ground:
            // ba trường đó mỗi cái đã trừ InUse rồi (VehicleRouting.cs:61-65).
            dat("kpi-free", tong - dangDung);
            dat("kpi-pct", Math.round(dangDung / tong * 100) + "%");

            // Số KHỐI, không phải số ô. Ô này trước đây ghi cứng số 9 từ bản
            // demo vì thiếu id nên không ai cập nhật — Dashboard hiện sai suốt.
            dat("kpi-khoi", (typeof soKhoi === "number") ? soKhoi : GACH);
        }

        function veXeVao(recent) {
            var tbody = el("dash-recent-tbody");
            if (!tbody) return;
            tbody.innerHTML = "";
            for (var i = 0; i < recent.length; i++) {
                var r = recent[i];
                var tr = document.createElement("tr");
                tr.setAttribute("data-event-id", r.event_id || "");
                tr.className = "border-b border-slate-800/60";
                tr.innerHTML =
                    '<td class="py-1.5 pr-2 text-slate-400 font-mono text-[10px]">' + (r.at || "") + '</td>' +
                    '<td class="py-1.5 pr-2 text-slate-200">' + (r.vehicle || "") + '</td>' +
                    '<td class="py-1.5 pr-2 text-slate-400">' + (r.weight_class || "") + '</td>' +
                    '<td class="py-1.5 text-slate-400">' + (r.outcome || "") + '</td>';
                tbody.appendChild(tr);
            }
        }

        // ------------------------------------------------------ sức khoẻ thiết bị
        var MAU = {
            ok:          { nen: "rgb(22, 163, 74)",   chu: "rgb(134, 239, 172)" },
            partial:     { nen: "rgb(217, 119, 6)",   chu: "rgb(253, 224, 71)"  },
            down:        { nen: "rgb(220, 38, 38)",   chu: "rgb(252, 165, 165)" },
            unmonitored: { nen: "rgb(100, 116, 139)", chu: "rgb(148, 163, 184)" }
        };

        function veMotThietBi(slug, nhom) {
            var dot  = el("dev-" + slug + "-dot");
            var text = el("dev-" + slug + "-text");
            if (!dot || !text) return;

            if (!nhom) {
                dot.style.background = MAU.unmonitored.nen;
                text.style.color     = MAU.unmonitored.chu;
                text.textContent     = "chưa giám sát";
                return;
            }
            var m = MAU[nhom.health] || MAU.unmonitored;
            dot.style.background = m.nen;
            text.style.color     = m.chu;
            text.textContent     = nhom.detail || nhom.health || GACH;
        }

        function veThietBi(groups) {
            var theoKhoa = {};
            for (var i = 0; i < groups.length; i++) theoKhoa[groups[i].key] = groups[i];

            veMotThietBi("plc", theoKhoa.plc);
            veMotThietBi("camera", theoKhoa.camera);
            // HMI không có nguồn dữ liệu nào trong SCADA -> luôn "chưa giám sát".
            veMotThietBi("hmi", null);

            // LED và PGS là hai nhóm riêng nhưng dùng chung một hàng hiển thị.
            var led = theoKhoa.led, pgs = theoKhoa.pgs;
            if (led || pgs) {
                var xau = (led && led.health === "down") || (pgs && pgs.health === "down")
                    ? "down"
                    : ((led && led.health === "partial") || (pgs && pgs.health === "partial")
                        ? "partial" : "ok");
                veMotThietBi("ledpgs", {
                    health: xau,
                    detail: "LED " + (led ? led.online + "/" + led.total : "?") +
                            " · PGS " + (pgs ? pgs.online + "/" + pgs.total : "?")
                });
            } else {
                veMotThietBi("ledpgs", null);
            }
        }

        // ---------------------------------------------------------------- poll
        function tick() {
            var xongSucChua = fetch(URL_CAPACITY, { cache: "no-store" })
                .then(function (res) {
                    if (!res.ok) throw new Error("HTTP " + res.status);
                    return res.json();
                })
                .then(function (d) {
                    if (d.error) throw new Error(d.error);
                    veSucChua(d.zones || [], d.so_khoi);
                    veXeVao(d.recent || []);
                    return d.now;
                });

            var xongKhoi = fetch(URL_BLOCKS, { cache: "no-store" })
                .then(function (res) {
                    if (!res.ok) throw new Error("HTTP " + res.status);
                    return res.json();
                })
                .then(function (d) {
                    if (d.error) throw new Error(d.error);
                    if (!Array.isArray(d.blocks)) throw new Error("thiếu danh sách khối");
                    veKhoi(d.blocks);
                });

            var xongThietBi = fetch(URL_DEVICE, { cache: "no-store" })
                .then(function (res) {
                    if (!res.ok) throw new Error("HTTP " + res.status);
                    return res.json();
                })
                .then(function (d) { veThietBi(d.groups || []); });

            Promise.all([xongSucChua, xongKhoi, xongThietBi])
                .then(function (kq) {
                    datTrangThai("cập nhật " + (kq[0] || ""), "rgb(52, 211, 153)");
                })
                .catch(function (err) {
                    // KHÁC FloorPlan: xoá số chứ không giữ lại. Số cũ trông y hệt
                    // số đúng, nên để nguyên là để người trực tin vào dữ liệu chết.
                    xoaHet();
                    datTrangThai("lỗi: " + err.message, "rgb(251, 191, 36)");
                });
        }

        function batDau() { if (!timer) { tick(); timer = setInterval(tick, POLL_MS); } }
        function dungLai() { if (timer) { clearInterval(timer); timer = null; } }

        // Tab ở nền thì ngừng poll — trang này hay được mở rồi để cả ngày.
        document.addEventListener("visibilitychange", function () {
            if (document.hidden) dungLai(); else batDau();
        });

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", batDau);
        } else {
            batDau();
        }
    })();
</script>
