@{
    Layout = "~/Views/Shared/_ScadaLayout.cshtml";
}

<div class="p-6 pb-12 min-h-[calc(100vh-3.5rem)] text-slate-100" style="background: rgb(15, 23, 42); font-family: 'Inter', system-ui, -apple-system, sans-serif;">
    <div class="space-y-6">
        <div class="mb-4 rounded-lg border border-amber-800/40 bg-amber-950/20 px-4 py-3">
            <div class="text-amber-400 text-xs font-bold mb-1">Chưa có hệ thống tài khoản</div>
            <p class="text-[11px] text-slate-400 leading-relaxed">Ứng dụng hiện không có lớp xác thực: không đăng nhập, không phân quyền, và không ghi lại ai đã thao tác gì. Nhật ký thật duy nhất đang có là tệp ghi thao tác PLC trong App_Data, chưa được đưa lên giao diện.</p>
        </div>

        <!-- Header -->
        <div class="flex justify-between items-center pb-4 border-b border-slate-800">
            <div>
                <h1 class="text-2xl font-bold tracking-tight">Hỗ trợ từ xa & Phân quyền người dùng</h1>
                <p class="text-slate-400 text-sm mt-1">Quản lý ma trận quyền truy cập của người vận hành, giám sát phiên làm việc và tra cứu nhật ký Audit Log.</p>
            </div>
        </div>

        <!-- User Roles Permission Matrix Section -->
        <div class="bg-slate-900/50 rounded-xl border border-slate-800 p-5 shadow-xl">
            <h3 class="text-white text-sm font-bold mb-4 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield text-blue-500"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path></svg>
                Ma trận phân quyền hệ thống (User Permission Matrix)
            </h3>
            
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-5 gap-4">
                <!-- Admin -->
                <div class="bg-slate-900/80 rounded-lg border border-rose-500/20 p-4 hover:border-rose-500/40 transition-all">
                    <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded border text-[10px] font-mono font-bold bg-rose-950/60 border-rose-700/50 text-rose-300 mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        Administrator
                    </div>
                    <ul class="space-y-2 text-[11px] font-mono text-slate-400">
                        <li class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>Toàn quyền hệ thống</li>
                        <li class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>Forced Mode (Admin)</li>
                        <li class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>Quản lý người dùng</li>
                        <li class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>Cấu hình cổng API</li>
                    </ul>
                </div>

                <!-- Supervisor -->
                <div class="bg-slate-900/80 rounded-lg border border-violet-500/20 p-4 hover:border-violet-500/40 transition-all">
                    <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded border text-[10px] font-mono font-bold bg-violet-950/60 border-violet-700/50 text-violet-300 mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        Supervisor
                    </div>
                    <ul class="space-y-2 text-[11px] font-mono text-slate-400">
                        <li class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-violet-500"></span>Reset / Xác nhận cảnh báo</li>
                        <li class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-violet-500"></span>Xem tất cả các phân khu</li>
                        <li class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-violet-500"></span>Tạo & Xuất báo cáo</li>
                        <li class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-violet-500"></span>Xác nhận điều khiển nguy hiểm</li>
                    </ul>
                </div>

                <!-- Maintenance -->
                <div class="bg-slate-900/80 rounded-lg border border-amber-500/20 p-4 hover:border-amber-500/40 transition-all">
                    <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded border text-[10px] font-mono font-bold bg-amber-950/60 border-amber-700/50 text-amber-300 mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        Maintenance
                    </div>
                    <ul class="space-y-2 text-[11px] font-mono text-slate-400">
                        <li class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>Chế độ bảo trì</li>
                        <li class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>Kiểm tra cảm biến/VFD</li>
                        <li class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>Xem chi tiết Block</li>
                        <li class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>Xử lý Work Order</li>
                    </ul>
                </div>

                <!-- Operator -->
                <div class="bg-slate-900/80 rounded-lg border border-blue-500/20 p-4 hover:border-blue-500/40 transition-all">
                    <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded border text-[10px] font-mono font-bold bg-blue-950/60 border-blue-700/50 text-blue-300 mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        Operator
                    </div>
                    <ul class="space-y-2 text-[11px] font-mono text-slate-400">
                        <li class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>Dashboard Giám sát</li>
                        <li class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>Đọc thông tin cảnh báo</li>
                        <li class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>Điều hướng giao thông</li>
                        <li class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>Quản lý quẹt thẻ</li>
                    </ul>
                </div>

                <!-- Remote Support -->
                <div class="bg-slate-900/80 rounded-lg border border-teal-500/20 p-4 hover:border-teal-500/40 transition-all">
                    <div class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded border text-[10px] font-mono font-bold bg-teal-950/60 border-teal-700/50 text-teal-300 mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        Remote Support
                    </div>
                    <ul class="space-y-2 text-[11px] font-mono text-slate-400">
                        <li class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-teal-500"></span>Chỉ đọc (Read-Only)</li>
                        <li class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-teal-500"></span>Không được điều khiển</li>
                        <li class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-teal-500"></span>Đọc logs chẩn đoán</li>
                        <li class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-teal-500"></span>Giới hạn phiên 1 giờ</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Active Users Online Section -->
    @* Ba the "tai khoan dang truc tuyen" deu bia: ten nguoi dung, gio dang
       nhap va dia chi IP. Ung dung khong co lop xac thuc nao nen khong the
       biet ai dang mo trang. *@
    <div class="bg-slate-900/50 rounded-xl border border-slate-800 p-5 shadow-xl">
        <h3 class="text-white text-sm font-bold mb-4">Tài khoản đang kết nối trực tuyến</h3>
        <div class="text-center text-slate-500 text-[11px] py-8">
            Hệ thống chưa có đăng nhập nên không theo dõi được phiên làm việc nào.
        </div>
    </div>

        <!-- Audit Log Section -->
        <div class="bg-slate-900/50 rounded-xl border border-slate-800 overflow-hidden shadow-2xl">
            <div class="px-5 py-4 border-b border-slate-800 flex justify-between items-center bg-slate-900/80">
                <div class="flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                    <span class="text-white text-sm font-bold">Nhật ký Audit Log vận hành (Remote Audit History)</span>
                </div>
                <select id="auditRoleFilter" onchange="filterAuditLogs()" class="bg-slate-850 border border-slate-700/50 rounded px-2.5 py-1 text-xs text-slate-300 font-mono outline-none">
                    <option value="all">Tất cả vai trò</option>
                    <option value="Admin">Quản trị</option>
                    <option value="Supervisor">Giám sát</option>
                    <option value="Maintenance">Bảo trì</option>
                    <option value="Operator">Vận hành viên</option>
                    <option value="Remote Support">Hỗ trợ từ xa</option>
                </select>
            </div>
            
            <div class="overflow-x-auto">
                <table class="w-full text-xs font-mono">
                    <thead class="border-b border-slate-800 bg-slate-850">
                        <tr>
                            <th class="text-left text-slate-500 px-4 py-3 font-bold whitespace-nowrap">Thời gian</th>
                            <th class="text-left text-slate-500 px-4 py-3 font-bold whitespace-nowrap">Người dùng</th>
                            <th class="text-left text-slate-500 px-4 py-3 font-bold whitespace-nowrap">Vai trò</th>
                            <th class="text-left text-slate-500 px-4 py-3 font-bold whitespace-nowrap">Vị trí ảnh hưởng</th>
                            <th class="text-left text-slate-500 px-4 py-3 font-bold whitespace-nowrap">Lệnh gửi</th>
                            <th class="text-left text-slate-500 px-4 py-3 font-bold whitespace-nowrap">Kết quả</th>
                            <th class="text-left text-slate-500 px-4 py-3 font-bold">Lý do ghi nhận / Ghi chú</th>
                        </tr>
                    </thead>
                    <tbody id="auditTableBody">
                        <tr><td colspan="7" class="px-4 py-10 text-center text-slate-500 text-[11px]">
                            Chưa có nhật ký thao tác. Hệ thống chưa có lớp đăng nhập nên không ghi được ai đã làm gì.
                        </td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    // Filtering audit logs based on selected role
    function filterAuditLogs() {
        const selectedRole = document.getElementById("auditRoleFilter").value;
        const rows = document.querySelectorAll(".audit-row");
        
        rows.forEach(row => {
            const role = row.getAttribute("data-role");
            if (selectedRole === "all" || role === selectedRole) {
                row.style.display = "";
            } else {
                row.style.display = "none";
            }
        });
    }
</script>