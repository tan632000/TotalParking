@{
    Layout = "~/Views/Shared/_ScadaLayout.cshtml";
}

<div class="p-6 pb-12 min-h-[calc(100vh-3.5rem)] text-slate-100" style="background: rgb(15, 23, 42); font-family: 'Inter', system-ui, -apple-system, sans-serif;">
    <div class="space-y-6">
        <!-- Header -->
        <div class="flex justify-between items-center pb-4 border-b border-slate-800">
            <div>
                <h1 class="text-2xl font-bold tracking-tight">Cây Thiết Bị &amp; Quản Lý Tài Sản (Asset Tree)</h1>
                <p class="text-slate-400 text-sm mt-1">Cấu trúc phần cứng SCADA đọc từ vòng poll PLC: địa chỉ mạng, tình trạng kết nối và bố cục thanh ghi của từng khối.</p>
            </div>
        </div>

        <!-- Main Layout Split -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Left Column: Asset Tree View -->
            <div class="bg-slate-900/50 rounded-xl border border-slate-800 p-5 shadow-xl space-y-4">
                <h3 class="text-white text-sm font-bold flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-500"><rect width="6" height="6" x="16" y="16" rx="1"></rect><rect width="6" height="6" x="2" y="16" rx="1"></rect><rect width="6" height="6" x="9" y="2" rx="1"></rect><path d="M12 8v8"></path><path d="M12 12H5"></path><path d="M12 12h10"></path></svg>
                    Cấu trúc phân cấp thiết bị
                </h3>

                <!-- Tree View Structure -->
                <div class="font-mono text-xs select-none">
                    <div class="space-y-1">
                        <div class="flex items-center gap-2 py-1 font-bold text-slate-200">
                            <span class="text-blue-500">🏢</span>
                            <span>TotalParking SCADA</span>
                        </div>
            @* Cay cu co hai khoi bia trong mot zone bia. Bai that co 112 PLC
               tren sau zone, va /PlcStatus biet dia chi, trang thai ket noi va
               bo cuc thanh ghi cua tung cai. *@
            <div id="assetTree" class="space-y-1 text-xs font-mono">
                <div class="text-slate-500 py-6 text-center">Đang đọc danh sách thiết bị…</div>
            </div>
                    </div>
                </div>
            </div>

            <!-- Right 2 Columns: Asset Details & Telemetry -->
            <div id="assetDetail" class="lg:col-span-2 space-y-6">
                <!-- Info Display -->
                <div class="bg-slate-900/50 rounded-xl border border-slate-800 p-6 shadow-xl space-y-6">
                    <div class="flex justify-between items-start pb-4 border-b border-slate-800">
                        <div>
                            <h2 id="assetName" class="text-lg font-bold text-white">Chọn một thiết bị</h2>
                            <p id="assetCode" class="text-slate-500 text-xs font-mono mt-1">Mã thiết bị: —</p>
                        </div>
                        <span id="assetStatus" class="px-2.5 py-0.5 rounded border border-slate-700 bg-slate-800 text-slate-400 text-xs font-bold font-mono">
                            TRẠNG THÁI: —
                        </span>
                    </div>

                    <!-- Telemetry grid -->
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        <div class="bg-slate-800/20 border border-slate-800 p-4 rounded-xl">
                            <span class="text-slate-500 text-[10px] uppercase font-mono block">Runtime tích lũy</span>
                            <span id="telemetryRuntime" class="text-lg font-mono font-bold text-slate-200 mt-1">—</span>
                        </div>
                        <div class="bg-slate-800/20 border border-slate-800 p-4 rounded-xl">
                            <span class="text-slate-500 text-[10px] uppercase font-mono block">Số chu kỳ đỗ xe</span>
                            <span id="telemetryCycles" class="text-lg font-mono font-bold text-slate-200 mt-1">—</span>
                        </div>
                        <div class="bg-slate-800/20 border border-slate-800 p-4 rounded-xl">
                            <span class="text-slate-500 text-[10px] uppercase font-mono block">Nhiệt độ cuộn dây</span>
                            <span id="telemetryTemp" class="text-lg font-mono font-bold text-slate-200 mt-1">—</span>
                        </div>
                    </div>

                    <!-- Asset metadata specifications -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                        <div class="space-y-3">
                            <h4 class="text-slate-400 text-xs font-bold font-mono uppercase tracking-wider">Thông số kỹ thuật</h4>
                            <div class="space-y-2 text-[11px] font-mono">
                                <div class="flex justify-between border-b border-slate-800/50 pb-1">
                                    <span class="text-slate-550">Hãng sản xuất:</span>
                                    <span id="specVendor" class="text-slate-350">—</span>
                                </div>
                                <div class="flex justify-between border-b border-slate-800/50 pb-1">
                                    <span class="text-slate-550">Model động cơ:</span>
                                    <span id="specModel" class="text-slate-350">—</span>
                                </div>
                                <div class="flex justify-between border-b border-slate-800/50 pb-1">
                                    <span class="text-slate-550">Số Serial:</span>
                                    <span id="specSerial" class="text-slate-350">—</span>
                                </div>
                                <div class="flex justify-between pb-1">
                                    <span class="text-slate-550">Ngày lắp đặt:</span>
                                    <span id="specDate" class="text-slate-350">—</span>
                                </div>
                            </div>
                        </div>

                        <!-- Maintenance planning -->
                        <div class="space-y-3">
                            <h4 class="text-slate-400 text-xs font-bold font-mono uppercase tracking-wider">Lịch trình bảo dưỡng</h4>
                            <div class="space-y-2 text-[11px] font-mono">
                                <div class="flex justify-between border-b border-slate-800/50 pb-1">
                                    <span class="text-slate-550">Bảo trì gần nhất:</span>
                                    <span id="maintLast" class="text-slate-350">—</span>
                                </div>
                                <div class="flex justify-between border-b border-slate-800/50 pb-1">
                                    <span class="text-slate-550">Dự kiến bảo trì tiếp theo:</span>
                                    <span id="maintNext" class="text-slate-350">—</span>
                                </div>
                                <div class="flex justify-between pb-1">
                                    <span class="text-slate-550">Vật tư thay thế đi kèm:</span>
                                    <span id="specParts" class="text-slate-350">—</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // ===================== CAY THIET BI THAT =====================
    // Ban truoc dung san mot co so du lieu thiet bi bia: gio chay, so chu ky,
    // nhiet do, ten hang, so se-ri va ngay bao tri cho vai thiet bi o hai khoi
    // khong ton tai. Khong truong nao trong so do co nguon — CSDL khong co bang
    // tai san, va vong quet PLC khong doc nhiet do hay gio chay.
    //
    // Nhung co mot cay thiet bi THAT: 112 PLC, moi cai gan voi mot khoi, co dia
    // chi mang, trang thai ket noi, bo cuc thanh ghi va lan doc the gan nhat.
    // Do la thu trang nay hien bay gio.
    (function () {
        "use strict";

        var URL_PLC   = "@Url.Action("Index", "PlcStatus")";
        // /PlcStatus khong tra zone_id — no chi biet block_no va duong mang.
        // Ghep them tu /Monitor/BlockMap de cay chia dung sau zone thay vi don
        // ca 112 PLC vao mot nhom "Zone 0".
        var URL_BLOCK = "@Url.Action("BlockMap", "Monitor")";
        var zoneTheoKhoi = {};
        var NHIP_MS = 20000;
        var GACH    = "\u2014";

        var theoKhoi = {};
        var dangChon = null;

        function el(id) { return document.getElementById(id); }
        function dat(id, v) { var e = el(id); if (e) e.textContent = v; }

        function esc(v) {
            return String(v === null || v === undefined ? "" : v)
                .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;");
        }

        function veCay(ds) {
            var cay = el("assetTree");
            if (!cay) return;

            if (!ds.length) {
                cay.innerHTML = '<div class="text-slate-500 py-6 text-center">Chưa có thiết bị nào được khai báo.</div>';
                return;
            }

            // Gom theo zone de cay co hai tang nhu ban cu, nhung bang so that.
            var zone = {};
            ds.forEach(function (b) {
                var z = b.zone_id || 0;
                (zone[z] = zone[z] || []).push(b);
            });

            cay.innerHTML = Object.keys(zone).sort(function (a, b) { return a - b; })
                .map(function (z) {
                    var ds2 = zone[z].sort(function (a, b) { return a.block_no - b.block_no; });
                    var mat = ds2.filter(function (b) { return !b.online; }).length;
                    return '<div class="mb-2">' +
                             '<div class="text-slate-300 font-bold py-1 flex items-center justify-between">' +
                               '<span>' + (z === "0" || z === "null" ? "Chưa rõ zone" : "Zone " + esc(z)) + '</span>' +
                               '<span class="text-[10px] font-normal ' + (mat ? "text-rose-400" : "text-slate-600") + '">' +
                                 ds2.length + ' PLC' + (mat ? ' · ' + mat + ' mất kết nối' : '') + '</span>' +
                             '</div>' +
                             // ===================== XEP THEO HANG =====================
                             // Ban dau moi PLC chiem tron mot dong (w-full), nen 112 khoi
                             // thanh 112 dong va phai cuon rat dai moi nhin het mot zone.
                             // Gio xep thanh luoi chip: zone 37 khoi chi con vai hang.
                             //
                             // So cot dat bang style noi tuyen chu KHONG bang lop
                             // grid-cols-* cua Tailwind. scada.css la ban trich xuat: no
                             // chi co .grid-cols-1, -2, -3 o muc goc, khong co
                             // .grid-cols-4. Mot lop khong ton tai thi khong bao loi, no
                             // chi im lang khong lam gi, nen luoi roi ve mac dinh mot cot
                             // — dung cai canh moi PLC mot dong ma doi bo cuc de bo di.
                             //
                             // Sau cot co dinh, khong dung auto-fill. Do thuc te cho thay
                             // cot zone rong gan het trang (839px o cua so 1100, 1659px o
                             // 1920), nen auto-fill chia ra 14 den 29 cot — mot zone 16
                             // khoi thanh mot vach ngang dai, kho do mat theo.
                             //
                             // minmax(0,56px) cho cot co chieu rong toi da 56px va co
                             // phep co lai khi cua so hep, nen sau chip van nam tron mot
                             // hang tren man nho chu khong tran ra ngoai.
                             '<div class="pl-2" style="display:grid;' +
                               'grid-template-columns:repeat(6,minmax(0,56px));gap:4px;">' +
                             ds2.map(function (b) {
                                 var cham = b.online ? "rgb(34,197,94)" : "rgb(220,38,38)";
                                 var chon = b.block_no === dangChon;
                                 return '<button type="button" onclick="chonThietBi(' + b.block_no + ')" ' +
                                        'title="PLC khối ' + b.block_no + ' — ' + esc(b.endpoint || "") +
                                          (b.online ? " — đang kết nối" : " — mất kết nối") + '" ' +
                                        'class="flex items-center justify-center gap-1 rounded py-1 transition-colors ' +
                                          (chon ? "bg-blue-600/25 border border-blue-500/60 text-blue-200"
                                                : "border border-slate-800 text-slate-400 hover:bg-slate-800/50") + '">' +
                                          '<span class="w-1.5 h-1.5 rounded-full shrink-0" style="background:' + cham + ';"></span>' +
                                          '<span class="text-[11px]">' + b.block_no + '</span>' +
                                        '</button>';
                             }).join("") +
                             '</div>' +
                           '</div>';
                }).join("");
        }

        // ===================== CUON TOI BANG CHI TIET =====================
        // Trang nay xep mot cot, nen bang chi tiet nam duoi cay 112 chip. Bam
        // mot chip xong ma khong cuon thi man hinh khong doi gi, va nguoi dung
        // tuong nut hong trong khi du lieu da duoc dien san o duoi.
        function cuonToiChiTiet() {
            var khung = el("assetDetail");
            var tieuDe = el("assetName");
            if (!khung || !tieuDe) return;

            // Thanh dau trang duoc ghim cung (position:fixed, cao 56px) nen no
            // KHONG chiem cho trong luong cuon. Cuon dung bang chieu cao cua no
            // thi tieu de bang chi tiet se nam lot sau thanh do.
            var LE_TREN = 56 + 12;

            // Tieu de da nam trong tam nhin thi thoi. Thieu kiem tra nay, bam
            // chip thu hai se keo trang giat nguoc len mot lan nua vo co.
            var o = tieuDe.getBoundingClientRect();
            if (o.top >= LE_TREN && o.top <= window.innerHeight - 40) return;

            var dich = khung.getBoundingClientRect().top + window.pageYOffset - LE_TREN;

            // Do trinh duyet co hieu behavior:"smooth" hay khong. Trinh duyet cu
            // khong hieu se coi ca doi tuong la toa do x va nhay ve dau trang.
            if ("scrollBehavior" in document.documentElement.style) {
                window.scrollTo({ top: dich, behavior: "smooth" });
            } else {
                window.scrollTo(0, dich);
            }
        }

        window.chonThietBi = function (blockNo) {
            var b = theoKhoi[blockNo];
            if (!b) return;

            // Ve lai cay de chip dang chon duoc to sang. Khong lam thi nguoi dung
            // bam xong khong biet minh dang xem khoi nao trong 112 chip giong nhau.
            dangChon = blockNo;
            veCay(Object.keys(theoKhoi).map(function (k) { return theoKhoi[k]; }));

            dat("assetName", "PLC khối " + blockNo);
            dat("assetCode", b.endpoint || GACH);

            var st = el("assetStatus");
            if (st) {
                st.textContent = b.online ? "TRẠNG THÁI: ĐANG KẾT NỐI" : "TRẠNG THÁI: MẤT KẾT NỐI";
                st.className = "px-2 py-0.5 rounded text-[10px] font-bold border " + (b.online
                    ? "border-emerald-500/40 bg-emerald-500/10 text-emerald-400"
                    : "border-rose-500/40 bg-rose-500/10 text-rose-400");
            }

            // Bon o duoi day KHONG co nguon: he thong khong doc gio chay, so chu
            // ky hay nhiet do tu thiet bi, va khong co bang tai san nao ghi hang
            // san xuat hay so se-ri. Noi thang thay vi dien mot con so nghe hop ly.
            dat("telemetryRuntime", "chưa ghi nhận");
            dat("telemetryCycles",  "chưa ghi nhận");
            dat("telemetryTemp",    "chưa đo");
            dat("specVendor",       "chưa ghi nhận");
            dat("specModel",        b.layout ? ("Bố cục thanh ghi: " + b.layout) : "chưa ghi nhận");
            dat("specSerial",       b.endpoint ? ("Địa chỉ: " + b.endpoint) : "chưa ghi nhận");
            dat("specDate",         "chưa ghi nhận");
            dat("specParts",        b.registers
                                        ? ("Thanh ghi thẻ " + (b.registers.card || "?"))
                                        : "chưa ghi nhận");
            dat("maintLast",        b.last_ok  ? ("Bắt tay gần nhất: " + b.last_ok)  : "chưa ghi nhận");
            dat("maintNext",        b.last_scan ? ("Quét ô gần nhất: " + b.last_scan) : "chưa ghi nhận");

            // Cuon SAU khi da dien xong moi o. Cuon truoc thi nguoi dung nhin
            // thay bang con mang so cua khoi vua chon truoc do.
            cuonToiChiTiet();
        };

        function tick() {
            // Doc zone TRUOC roi moi doc PLC: neu ve cay xong moi biet zone thi
            // nguoi dung thay cay nhay mot lan tu "Zone 0" sang so dung.
            fetch(URL_BLOCK, { cache: "no-store" })
                .then(function (r) { return r.ok ? r.json() : null; })
                .then(function (d) {
                    ((d && d.blocks) || []).forEach(function (b) {
                        zoneTheoKhoi[b.block_no] = b.zone_id;
                    });
                })
                .catch(function () { /* thieu zone thi cay van chay, chi kem chia nhom */ })
                .then(docPlc);
        }

        function docPlc() {
            return fetch(URL_PLC, { cache: "no-store" })
                .then(function (r) {
                    if (!r.ok) throw new Error("HTTP " + r.status);
                    return r.json();
                })
                .then(function (d) {
                    if (d && d.error) throw new Error(d.error);
                    var ds = (d && d.blocks) || [];
                    theoKhoi = {};
                    ds.forEach(function (b) {
                        b.zone_id = zoneTheoKhoi[b.block_no] || null;
                        theoKhoi[b.block_no] = b;
                    });
                    veCay(ds);
                })
                .catch(function (e) {
                    var cay = el("assetTree");
                    if (cay) {
                        cay.innerHTML = '<div class="text-red-400 py-6 text-center">Không đọc được danh sách thiết bị: ' +
                                        esc(e.message) + '</div>';
                    }
                });
        }

        window.toggleNode = function () { /* cay hien phang, khong con nut gap */ };

        var timer = null;
        function batDau() { if (timer) return; tick(); timer = setInterval(tick, NHIP_MS); }

        document.addEventListener("visibilitychange", function () {
            if (document.hidden) { if (timer) { clearInterval(timer); timer = null; } }
            else batDau();
        });

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", batDau);
        } else {
            batDau();
        }
    })();
</script>
