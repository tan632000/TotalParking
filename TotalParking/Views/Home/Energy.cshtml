@{
    Layout = "~/Views/Shared/_ScadaLayout.cshtml";
}

<div class="p-6 pb-12 min-h-[calc(100vh-3.5rem)] text-slate-100" style="background: rgb(15, 23, 42); font-family: 'Inter', system-ui, -apple-system, sans-serif;">
    <div class="space-y-6">
        <div class="mb-4 rounded-lg border border-amber-800/40 bg-amber-950/20 px-4 py-3">
            <div class="text-amber-400 text-xs font-bold mb-1">Chưa có dữ liệu điện năng</div>
            <p class="text-[11px] text-slate-400 leading-relaxed">Hệ thống không đấu nối đồng hồ đo điện nào. Vòng quét PLC chỉ lấy trạng thái ô đỗ, tình trạng kết nối và hạng tải; cơ sở dữ liệu không có bảng nào lưu điện năng, công suất hay chi phí. Mọi con số trên trang này vì vậy để trống.</p>
        </div>

        <!-- Header -->
        <div class="flex justify-between items-center pb-4 border-b border-slate-800">
            <div>
                <h1 class="text-2xl font-bold tracking-tight">Giám sát Điện năng (Energy Monitoring)</h1>
                <p class="text-slate-400 text-sm mt-1">Theo dõi điện năng tiêu thụ tổng thể, peak load, công suất động cơ và ước tính chi phí vận hành.</p>
            </div>
            <div class="flex gap-2">
                
            </div>
        </div>

        <!-- Energy KPIs -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="bg-slate-900/50 border border-slate-800 rounded-xl p-4 shadow-md">
                <div class="text-slate-500 text-[10px] font-mono uppercase tracking-wider">ĐIỆN NĂNG TIÊU THỤ THÁNG</div>
                <div class="text-blue-400 text-2xl font-mono font-bold mt-1">—</div>
                <div class="text-[10px] text-emerald-400 font-mono mt-1">chưa có dữ liệu đo đếm</div>
            </div>
            <div class="bg-slate-900/50 border border-slate-800 rounded-xl p-4 shadow-md">
                <div class="text-slate-500 text-[10px] font-mono uppercase tracking-wider">CÔNG SUẤT ĐỈNH (PEAK LOAD)</div>
                <div class="text-amber-500 text-2xl font-mono font-bold mt-1">—</div>
                <div class="text-[10px] text-slate-500 font-mono mt-1">chưa có dữ liệu đo đếm</div>
            </div>
            <div class="bg-slate-900/50 border border-slate-800 rounded-xl p-4 shadow-md">
                <div class="text-slate-500 text-[10px] font-mono uppercase tracking-wider">HỆ SỐ CÔNG SUẤT (POWER FACTOR)</div>
                <div class="text-emerald-400 text-2xl font-mono font-bold mt-1">—</div>
                <div class="text-[10px] text-emerald-500 font-mono mt-1">chưa có dữ liệu đo đếm</div>
            </div>
            <div class="bg-slate-900/50 border border-slate-800 rounded-xl p-4 shadow-md">
                <div class="text-slate-500 text-[10px] font-mono uppercase tracking-wider">CHI PHÍ ĐIỆN ƯỚC TÍNH</div>
                <div class="text-violet-400 text-2xl font-mono font-bold mt-1">—</div>
                <div class="text-[10px] text-slate-500 font-mono mt-1">chưa có dữ liệu đo đếm</div>
            </div>
        </div>

        <!-- Telemetry Details -->
        <div class="bg-slate-900/50 rounded-xl border border-slate-800 p-5 shadow-xl space-y-4">
            <h3 class="text-white text-sm font-bold flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-yellow-500"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                Phân bổ điện năng theo Block
            </h3>
            
            <div class="text-center text-slate-500 text-[11px] py-10">Hệ thống chưa đo điện năng theo từng khối.</div>
        </div>
    </div>
</div>
