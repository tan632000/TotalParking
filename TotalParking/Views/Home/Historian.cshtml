@{
    Layout = "~/Views/Shared/_ScadaLayout.cshtml";
}

<div class="p-6 pb-12 min-h-[calc(100vh-3.5rem)] text-slate-100" style="background: rgb(15, 23, 42); font-family: 'Inter', system-ui, -apple-system, sans-serif;">
    <div class="space-y-6">
        <!-- Header -->
        <div class="flex justify-between items-center pb-4 border-b border-slate-800">
            <div>
                <h1 class="text-2xl font-bold tracking-tight">Biểu Đồ Xu Hướng Kỹ Thuật (Historian &amp; Trends)</h1>
                <p class="text-slate-400 text-sm mt-1">Giám sát đồ thị xu hướng thời gian thực của dòng điện motor, nhiệt độ cuộn dây và tần số biến tần VFD.</p>
            </div>
        </div>

        <!-- Controls panel -->
        <div class="flex flex-wrap gap-4 items-center bg-slate-900/50 border border-slate-800 rounded-xl p-4 shadow-lg">
            <select id="trendBlock" class="bg-slate-800/60 border border-slate-700/50 rounded px-3 py-1.5 text-xs text-slate-350 font-mono outline-none focus:border-blue-500">
                @* Hai lua chon cu la ten khoi bia. Bai that co 118 khoi danh so. *@
                <option value="">đang đọc…</option>
            </select>

            <select id="trendMetric" onchange="changeMetric()" class="bg-slate-800/60 border border-slate-700/50 rounded px-3 py-1.5 text-xs text-slate-350 font-mono outline-none focus:border-blue-500">
                <option value="current">Dòng điện Motor Nâng (Ampe)</option>
                <option value="temp">Nhiệt độ Động cơ (°C)</option>
                <option value="frequency">Tần số biến tần VFD (Hz)</option>
            </select>

            <span class="text-slate-500 text-xs font-mono ml-auto" id="liveVal">Giá trị hiện tại: --</span>
        </div>

        <!-- Trend Chart Area -->
        <div class="bg-slate-900/50 rounded-xl border border-slate-800 p-5 shadow-2xl space-y-4">
            <div class="flex justify-between items-center">
                <h3 id="chartTitle" class="text-white text-sm font-bold font-mono">Đồ thị Dòng điện Motor nâng (Real-time Trend)</h3>
                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[9px] font-mono font-bold bg-blue-500/10 text-blue-400">
                    <span class="w-1.5 h-1.5 rounded-full bg-blue-400 animate-ping"></span>
                    CHƯA CÓ TÍN HIỆU
                </span>
            </div>
            
            <div class="relative w-full h-[320px] bg-slate-950/60 border border-slate-900 rounded-lg overflow-hidden flex items-center justify-center">
                <canvas id="trendCanvas" class="w-full h-full block"></canvas>
            </div>
        </div>
    </div>
</div>

<script>
    // ===================== VI SAO TRANG NAY TRONG =====================
    // Ban truoc SINH NGAU NHIEN ca ba duong cong bang bo sinh so ngau nhien:
    //
    //   dong dien   : 12-14 A binh thuong, 24-27 A khi "loi"
    //   nhiet do    : 56-60 C binh thuong, 112-115 C khi "loi"
    //   tan so VFD  : 48-50 Hz
    //
    // va dung san mot kich ban "motor qua nhiet" o mot khoi co dinh. Day la
    // trang ky su dung de chan doan xu huong: mot duong cong bia co the dan
    // toi ket luan co motor sap chay va cho dung thiet bi dang chay binh thuong.
    //
    // He thong KHONG thu thap telemetry nao. Da tra information_schema cho moi
    // cot ten chua temp/current/freq/runtime/cycle/maint trong ca CSDL: chi ra
    // dung `parking_slot.cycle_count`, va bang do co 0 dong. Vong quet PLC hien
    // chi doc thanh ghi o do, trang thai ket noi va hang tai.
    //
    // Nen trang nay noi thang la chua co du lieu, thay vi ve mot duong cong.
    (function () {
        "use strict";

        function dat(id, chu) {
            var e = document.getElementById(id);
            if (e) e.textContent = chu;
        }

        function veTrong() {
            var c = document.getElementById("trendCanvas");
            if (!c) return;
            var khung = c.parentElement;
            if (!khung) return;
            khung.innerHTML =
                '<div class="flex flex-col items-center justify-center h-full min-h-[240px] text-center px-6">' +
                  '<div class="text-slate-400 text-sm font-bold mb-2">Chưa thu thập dữ liệu xu hướng</div>' +
                  '<p class="text-[11px] text-slate-500 leading-relaxed max-w-md">' +
                    'Hệ thống chưa đọc dòng điện, nhiệt độ hay tần số biến tần từ thiết bị. ' +
                    'Vòng quét PLC hiện chỉ lấy trạng thái ô đỗ, tình trạng kết nối và hạng tải, ' +
                    'và cơ sở dữ liệu không có bảng nào lưu các đại lượng trên.' +
                  '</p>' +
                  '<p class="text-[10px] text-slate-600 mt-3">' +
                    'Muốn xem số liệu có thật, dùng trang Báo cáo &amp; thống kê hoặc Alarm &amp; Event.' +
                  '</p>' +
                '</div>';
        }

        // Van giu o chon de nguoi dung thay he thong DU KIEN theo doi nhung dai
        // luong nao, nhung khong ve gia tri nao.
        window.changeMetric = function () {
            var sel = document.getElementById("trendMetric");
            var ten = sel ? sel.options[sel.selectedIndex].text : "";
            dat("chartTitle", ten ? ("Đồ thị " + ten + " — chưa có dữ liệu") : "Chưa có dữ liệu");
            dat("liveVal", "—");
        };

        // O chon khoi van lay danh sach THAT, du chua co so lieu nao de ve:
        // nguoi dung can thay dung nhung khoi ma he thong biet.
        function napKhoi() {
            var sel = document.getElementById("trendBlock");
            if (!sel) return;
            fetch("@Url.Action("BlockMap", "Monitor")", { cache: "no-store" })
                .then(function (r) {
                    if (!r.ok) throw new Error("HTTP " + r.status);
                    return r.json();
                })
                .then(function (d) {
                    var ds = (d && d.blocks) || [];
                    if (!ds.length) throw new Error("trống");
                    sel.innerHTML = ds.slice().sort(function (a, b) { return a.block_no - b.block_no; })
                        .map(function (b) {
                            return '<option value="' + b.block_no + '">Khối ' + b.block_no +
                                   ' (Zone ' + b.zone_id + ')</option>';
                        }).join("");
                })
                .catch(function () {
                    sel.innerHTML = '<option value="">không đọc được danh sách khối</option>';
                });
        }

        document.addEventListener("DOMContentLoaded", function () {
            veTrong();
            napKhoi();
            window.changeMetric();
        });
    })();
</script>
