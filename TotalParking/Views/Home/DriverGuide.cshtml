@{
    Layout = "~/Views/Shared/_ScadaLayout.cshtml";
}

@{
    // Chong cache cho anh so do. Truoc day the <img> khong co tham so nao, nen sua
    // anh xong thi trinh duyet van dung ban cu trong cache — sua o dia ma man hinh
    // khong doi, rat mat cong tim.
    //
    // Lay theo LAN SUA CUOI cua file chu khong theo DateTime.Now nhu scada.css:
    // anh nang gan 8 MB, dung Now thi moi lan tai trang deu phai tai lai tu dau.
    // Theo mtime thi chi tai lai dung khi anh that su doi.
    //
    // Nen la anh cua man Mat bang he thong: dai vang tren anh la loi xe, va mang
    // duong di cua man nay (App_Data/driver_lanes.json) duoc so hoa theo chinh no.
    var mapPath = Server.MapPath("~/Images/zones_map.jpeg");
    var mapVer  = System.IO.File.Exists(mapPath)
                ? System.IO.File.GetLastWriteTimeUtc(mapPath).Ticks
                : 0L;
}

@*
    Màn hình treo cho tài xế đang dừng ở barrier.

    ===================== TRANG NÀY KHÔNG QUYẾT ĐỊNH GÌ CẢ =====================
    Không chọn block, không tính đường đi, không tự xét quyết định nào còn hạn.
    Tất cả đến từ /Monitor/DriverRoute dưới dạng ba trạng thái ROUTE / MESSAGE /
    WAITING, và trang chỉ vẽ đúng thứ được gửi tới. Nếu luật chọn block được chép
    xuống đây thì màn hình và cơ sở dữ liệu sẽ nói hai điều khác nhau, đúng lúc
    tài xế đang tin vào màn hình.

    Cả `viewBox` cũng lấy từ `view_w`/`view_h` trong phản hồi chứ không ghi cứng:
    khung toạ độ được khai báo đúng một chỗ, trong DriverLaneMap. Độ dày nét, bán
    kính vòng và cỡ chữ cũng tính theo `view_w`, nên đổi ảnh nền khác khung không
    làm nét vẽ to hay nhỏ đi.
*@

<div class="p-2 text-slate-100"
     style="background: rgb(15, 23, 42); font-family: 'Inter', system-ui, -apple-system, sans-serif;">

    @*
        Trang NAY DUOC PHEP CUON, nen khong ep so do vao chieu cao man hinh nua.
        Ep vao thi phai chon: hoac de trong hai ben, hoac xen bot tren duoi. Bo
        rang buoc do di thi so do lay TRON be ngang va cao tu nhien theo ti le —
        to nhat va ro nhat co the, khong xen mat gi.

        Bang chu chuyen thanh mot thanh ngang BAM TREN (`position: sticky`). Doi
        lai 4rem chieu cao, so do duoc them ~232px be ngang, va so block van nam
        trong tam mat ke ca khi tai xe cuon xuong.

        Bo cuc dat bang inline style, khong dung class responsive cua Tailwind:
        `Content/scada.css` la ban CSS trich xuat san va khong chua chung.
    *@
    <div id="dg-bar"
         class="rounded-lg border border-slate-700/60"
         @* top = 3.5rem chu khong phai 0: header cua _ScadaLayout la `fixed` cao
            h-14, nen dan thanh nay vao dinh cuon thi no truot xuong DUOI header va
            so block bi cat mat nua tren. *@
         style="position: sticky; top: 3.5rem; z-index: 20; background: rgb(13, 27, 46);
                display: flex; align-items: center; gap: 1.5rem; padding: .5rem 1rem;">
        <div style="min-width: 0;">
            <div id="dg-kicker" class="text-xs font-mono uppercase tracking-widest text-slate-500">
                Đang chờ xe
            </div>
            <div id="dg-big" class="font-bold leading-none text-slate-400" style="font-size: 3rem;">
                —
            </div>
        </div>
        <div style="flex: 1 1 0; min-width: 0;">
            <div id="dg-sub" class="text-sm text-slate-400 leading-snug">
                Màn hình sẽ hiện vị trí đỗ ngay khi camera nhận diện xe.
            </div>
            <div id="dg-warn" class="mt-1 hidden text-xs font-mono text-amber-400 leading-snug"></div>
        </div>
        <div class="text-[10px] font-mono text-slate-600" style="white-space: nowrap;">
            Cập nhật lúc <span id="dg-now">--:--:--</span>
        </div>
    </div>

    <div class="rounded-lg border border-slate-700/60 overflow-hidden"
         style="background: rgb(13, 27, 46); margin-top: .5rem;">
        @*
            Anh chiem tron be ngang, cao tu nhien. Lop SVG phu dung len tren voi
            cung kich thuoc, va vi khung `viewBox` co dung ti le cua anh nen hai
            lop luon chong khit — khong con phep xen nao de lech nhau.

            Anh de nguyen do dam. Lam mo di chi de trang trong hon, doi lai net ve
            nhat di dung luc tai xe dang phai doc no tu trong xe.
        *@
        <div id="dg-stage" class="relative w-full">
            <img src="@Url.Content("~/Images/zones_map.jpeg")?v=@mapVer" alt="Sơ đồ bãi xe"
                 style="display: block; width: 100%; height: auto;" />
            <svg id="dg-map" class="absolute inset-0 w-full h-full"
                 preserveAspectRatio="xMidYMid meet"
                 xmlns="http://www.w3.org/2000/svg"></svg>
        </div>
    </div>
</div>

<script>
(function () {
    'use strict';

    var NS       = 'http://www.w3.org/2000/svg';
    // D10: hỏi lại 2 giây một lần. Đủ để quyết định mới lên màn hình trong 3 giây
    // mà không cần kênh đẩy; toàn bộ hệ thống hiện tại đều làm theo kiểu này.
    var POLL_MS  = 2000;

    // ===================== VE SO BLOCK DE LEN SO DO =====================
    // Anh nen in san so block, nhung vai so in SAI (block 17 in "9", 18 in "10",
    // 10 in "18", 32 in "20"). Tai xe tin so in tren anh se toi nham cho. Vi vay
    // trang tu ve so block DUNG (payload.block_no) canh vong khoanh dich.
    //
    // Vi tri vong va so la diem cuoi cua route = vi tri block trong
    // driver_lanes.json, da duoc nguoi dung xac nhan tren anh phu khi so hoa.

    var svg    = document.getElementById('dg-map');
    var kicker = document.getElementById('dg-kicker');
    var big    = document.getElementById('dg-big');
    var sub    = document.getElementById('dg-sub');
    var warn   = document.getElementById('dg-warn');
    var nowEl  = document.getElementById('dg-now');

    // Khung toa do lay tu phan hoi chu khong ghi cung, theo I1.
    function ensureFrame(payload) {
        svg.setAttribute('viewBox', '0 0 ' + payload.view_w + ' ' + payload.view_h);
    }

    // Xoá đường đi và vòng tròn đích. Gọi ở MỌI nhánh không phải ROUTE.
    //
    // Đây là chỗ dễ sai nhất của một màn hình poll: khi không còn gì để vẽ, cách
    // làm lười là "không vẽ nữa", và nét cũ nằm lại trên màn hình. Tài xế tiếp
    // theo sẽ lái theo đường của chiếc xe trước.
    //
    function clearRoute() {
        ['dg-path', 'dg-dot', 'dg-num'].forEach(function (id) {
            var e = document.getElementById(id);
            if (e && e.parentNode) e.parentNode.removeChild(e);
        });
    }

    function drawRoute(payload) {
        clearRoute();
        ensureFrame(payload);

        // Moi kich thuoc tinh theo be ngang khung, khong ghi cung so pixel: cung
        // mot con so 14 thi day tren khung 1594 nhung manh tren khung 4800.
        // Vong dich phai NHO hon khoang cach giua hai block: tren zones_map hai
        // tam block gan nhau nhat cach ~95 px (khung 4800), trung vi ~138 px. Vong
        // to hon se khoanh ca block ben canh. Mep ngoai = ringR + ringW/2 ~ 77 px.
        var w       = payload.view_w;
        var strokeW = Math.round(w * 0.0088);
        var ringR   = Math.round(w * 0.014);
        var ringW   = Math.round(w * 0.004);
        var fontPx  = Math.round(w * 0.03);
        var shadow  = 'filter: drop-shadow(0 0 ' + Math.round(w * 0.0044) + 'px rgba(15,23,42,.95));';

        var d = '';
        for (var i = 0; i < payload.route.length; i++) {
            var p = payload.route[i];
            d += (i === 0 ? 'M' : 'L') + p.x + ' ' + p.y;
        }

        // ĐÚNG MỘT phần tử path. Độ tương phản với nền bản vẽ lấy bằng drop-shadow
        // chứ không vẽ thêm một nét viền thứ hai: hai phần tử cùng hình dạng thì
        // bất cứ ai soi DOM cũng phải dừng lại hỏi đâu mới là đường đi thật.
        var path = document.createElementNS(NS, 'path');
        path.setAttribute('id', 'dg-path');
        path.setAttribute('d', d);
        path.setAttribute('fill', 'none');
        path.setAttribute('stroke', '#22c55e');
        path.setAttribute('stroke-width', strokeW);
        path.setAttribute('stroke-linecap', 'round');
        path.setAttribute('stroke-linejoin', 'round');
        path.setAttribute('style', shadow);
        svg.appendChild(path);

        var last = payload.route[payload.route.length - 1];

        // VONG TRON RONG, khong phai dia dac: dia dac che mat chinh block dich
        // tren anh nen. Vong tron khoanh lay no thay vi dan len tren.
        var ring = document.createElementNS(NS, 'circle');
        ring.setAttribute('id', 'dg-dot');
        ring.setAttribute('cx', last.x);
        ring.setAttribute('cy', last.y);
        ring.setAttribute('r', ringR);
        ring.setAttribute('fill', 'none');
        ring.setAttribute('stroke', '#22c55e');
        ring.setAttribute('stroke-width', ringW);
        ring.setAttribute('style', shadow);
        svg.appendChild(ring);

        // So block DUNG, dat ngay tren vong (hoac duoi vong neu sat mep tren).
        // Vien toi ve truoc phan chu (paint-order) de doc duoc tren nen ban ve.
        var numY = last.y - ringR - ringW;
        if (numY - fontPx < 0) numY = last.y + ringR + ringW + fontPx;
        var num = document.createElementNS(NS, 'text');
        num.setAttribute('id', 'dg-num');
        num.setAttribute('x', last.x);
        num.setAttribute('y', numY);
        num.setAttribute('text-anchor', 'middle');
        num.setAttribute('font-size', fontPx);
        num.setAttribute('font-weight', '800');
        num.setAttribute('fill', '#22c55e');
        num.setAttribute('stroke', 'rgb(15,23,42)');
        num.setAttribute('stroke-width', Math.round(fontPx * 0.18));
        num.setAttribute('paint-order', 'stroke');
        num.textContent = payload.block_no;
        svg.appendChild(num);
    }

    function render(payload) {
        nowEl.textContent = payload.now;

        if (payload.state === 'ROUTE') {
            drawRoute(payload);
            kicker.textContent = 'Mời vào block';
            big.textContent = payload.block_no;
            big.className = 'mt-3 font-bold leading-none text-emerald-400';
            big.style.fontSize = '3rem';
            sub.textContent = 'Đi theo đường màu xanh trên sơ đồ.';

            // Nói ra khi số ô trống là suy luận chứ không phải quan sát, thay vì
            // im lặng để người xem tưởng con số nào cũng chắc như nhau.
            if (payload.occupancy_verified) {
                warn.classList.add('hidden');
            } else {
                warn.textContent = 'PLC chua bao cao block nay trong 5 phut — so o trong la uoc tinh.';
                warn.classList.remove('hidden');
            }
            return;
        }

        clearRoute();
        ensureFrame(payload);
        warn.classList.add('hidden');
        big.style.fontSize = '3rem';

        if (payload.state === 'MESSAGE') {
            kicker.textContent = 'Khong the dieu huong';
            big.textContent = payload.outcome;
            // Bang chi rong 14rem. 'REJECTED' vua khit, nhung 'NO_CAPACITY' dai hon
            // va se tran ra ngoai neu de nguyen co chu. Thu nho theo do dai thay vi
            // cho chu bi cat: mot ma loi hien ra mot nua thi khong con la thong tin.
            big.style.fontSize = (payload.outcome || '').length > 8 ? '1.75rem' : '2.5rem';
            big.style.wordBreak = 'break-word';
            big.className = 'mt-3 font-bold leading-none text-amber-400';
            sub.textContent = payload.reason || 'Moi lien he nhan vien dieu hanh.';
            return;
        }

        kicker.textContent = 'Đang chờ xe';
        big.textContent = '—';
        big.className = 'mt-3 font-bold leading-none text-slate-400';
        sub.textContent = 'Màn hình sẽ hiện vị trí đỗ ngay khi camera nhận diện xe.';
    }

    function poll() {
        fetch('/Monitor/DriverRoute', { cache: 'no-store' })
            .then(function (r) {
                if (!r.ok) throw new Error('HTTP ' + r.status);
                return r.json();
            })
            .then(render)
            .catch(function () {
                // Một nhịp hỏi hụt KHÔNG được xoá màn hình. Site khởi động lại mất
                // vài giây; xoá đường đi vì lý do đó là biến sự cố của máy chủ
                // thành một chỉ dẫn sai cho người đang đứng nhìn.
            });
    }

    poll();
    setInterval(poll, POLL_MS);
})();
</script>
