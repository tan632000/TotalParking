@{
    ViewBag.Title = "Bảo trì hệ thống";
    Layout = "~/Views/Shared/_ScadaLayout.cshtml";
}
@* ===================== BỐ CỤC THEO BẢN ĐỒ KHỐI =====================
   Cùng khuôn với trang Điều khiển vận hành (OperationControl.cshtml): chọn
   Zone, lưới thẻ khối bên trái, bấm khối nào thì bảng bên phải hiện thông tin
   của khối đó — ở đây là lỗi và động cơ (specs/d3-loi-va-dem-dong-co, task 03).

   Nội dung bịa cũ đã bỏ: tab "Chẩn đoán lỗi từ xa" sinh nhiệt độ động cơ bằng số
   ngẫu nhiên, nút "Xuất Work Order" không làm gì, và hai ô chọn Zone A–C /
   mức độ không nối vào đâu. Hai khối số liệu THẬT (độ tin cậy kết nối PLC, sức
   khoẻ vòng đọc ô) được giữ nguyên ở cuối trang. *@
<div class="p-5 pb-10 min-h-[calc(100vh-3.5rem)] text-slate-100">
    <div class="space-y-5">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-3 pb-4 border-b border-slate-700/50">
            <div>
                <h1 class="text-lg font-semibold text-slate-100">Bảo trì hệ thống</h1>
                <p class="text-xs text-slate-400">Bấm vào một khối để xem lỗi và động cơ của khối đó</p>
            </div>
            <span id="bt-cap-nhat" class="text-[10px] font-mono text-slate-500">đang đọc…</span>
        </div>

        <div class="flex flex-wrap items-center gap-4 p-4 bg-slate-900/40 rounded-xl border border-slate-800/80">
            <div class="flex items-center gap-2">
                <label for="bt-zone" class="text-xs text-slate-400 font-semibold uppercase tracking-wider">Phân khu (Zone):</label>
                <select id="bt-zone" onchange="btDoiZone()" class="bg-slate-800 border border-slate-700/60 rounded px-3 py-1 text-xs text-slate-200 focus:outline-none focus:border-blue-500"></select>
            </div>
            <div class="flex items-center gap-2">
                <label for="bt-khoi" class="text-xs text-slate-400 font-semibold uppercase tracking-wider">Chọn khối:</label>
                <select id="bt-khoi" onchange="btDoiKhoi()" class="bg-slate-800 border border-slate-700/60 rounded px-3 py-1 text-xs text-slate-200 focus:outline-none focus:border-blue-500"></select>
            </div>
            <div class="flex items-center gap-3 text-[10px] text-slate-400 ml-auto">
                <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded inline-block" style="border:1px solid rgb(239,68,68);background:rgba(239,68,68,.12);"></span>Đang có lỗi</span>
                <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded inline-block" style="border:1px solid rgba(34,197,94,.35);"></span>Bình thường</span>
                <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full inline-block" style="background:rgb(220,38,38);"></span>Mất kết nối PLC</span>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
            <div class="lg:col-span-2">
                <div class="rounded-xl p-5 shadow-xl" style="background:rgba(13,27,46,.95);border:1px solid rgba(51,65,85,.5);">
                    <div class="flex justify-between items-center mb-4">
                        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400">Danh sách khối — <span id="bt-zone-ten">…</span></h2>
                        <span id="bt-luoi-nhan" class="text-[10px] font-mono bg-slate-800 text-slate-400 px-2 py-0.5 rounded border border-slate-700">đang đọc…</span>
                    </div>
                    <div id="bt-luoi" class="grid grid-cols-2 md:grid-cols-4 gap-3">
                        <div class="col-span-full text-center text-slate-500 text-xs py-6">Đang đọc…</div>
                    </div>
                </div>
            </div>

            <div class="space-y-4">
                <div class="rounded-xl p-4 shadow-xl border-l-4 border-blue-500" style="background:rgba(13,27,46,.95);border-top:1px solid rgba(51,65,85,.5);border-right:1px solid rgba(51,65,85,.5);border-bottom:1px solid rgba(51,65,85,.5);">
                    <h2 id="bt-tieu-de" class="text-sm font-bold text-white">Chưa chọn khối</h2>
                    <div id="bt-phu-de" class="text-[10px] font-mono text-slate-500 mt-1">Bấm một khối ở bản đồ bên trái.</div>
                </div>

                <div class="rounded-xl p-4" style="background:rgba(13,27,46,.95);border:1px solid rgba(51,65,85,.5);">
                    <div class="flex items-center justify-between mb-2">
                        <h3 class="text-[11px] font-bold uppercase tracking-wider text-red-400">Lỗi đang có</h3>
                        <span id="bt-loi-dem" class="text-[10px] font-mono text-slate-500"></span>
                    </div>
                    <div id="bt-loi-mo" class="text-[11px] text-slate-500">—</div>
                </div>

                <div class="rounded-xl p-4" style="background:rgba(13,27,46,.95);border:1px solid rgba(51,65,85,.5);">
                    <h3 class="text-[11px] font-bold uppercase tracking-wider text-slate-300 mb-2">Lịch sử lỗi <span class="text-slate-500 font-normal normal-case">(20 gần nhất)</span></h3>
                    <div id="bt-loi-ls" class="text-[11px] text-slate-500 max-h-72 overflow-y-auto">—</div>
                </div>

                <div class="rounded-xl p-4" style="background:rgba(13,27,46,.95);border:1px solid rgba(51,65,85,.5);">
                    <div class="flex items-center justify-between mb-2">
                        <h3 class="text-[11px] font-bold uppercase tracking-wider text-violet-300">Động cơ</h3>
                        <span id="bt-dc-nhan" class="text-[10px] font-mono text-slate-500"></span>
                    </div>
                    <div id="bt-dc-tong" class="text-[11px] text-slate-500">—</div>
                    <h4 class="text-[10px] font-bold uppercase tracking-wider text-slate-500 mt-4 mb-1">50 lượt chạy gần nhất</h4>
                    <div id="bt-dc-ls" class="text-[11px] text-slate-500 max-h-72 overflow-y-auto">—</div>
                </div>
            </div>
        </div>

        @* ---------------------------------------------------------- số liệu thật giữ lại *@
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 pt-2">
            <div class="bg-red-950/40 border border-red-700/50 rounded p-3">
                <div class="text-red-400 text-xs font-mono">Đang mất kết nối</div>
                <div class="text-red-300 text-2xl font-mono font-bold"><span id="mt-dangmat">…</span></div>
                <div class="text-red-500 text-[10px] font-mono">khối đang mất kết nối</div>
            </div>
            <div class="bg-orange-950/40 border border-orange-700/50 rounded p-3">
                <div class="text-orange-400 text-xs font-mono">Chập chờn</div>
                <div class="text-orange-300 text-2xl font-mono font-bold"><span id="mt-chapchon">…</span></div>
                <div class="text-orange-500 text-[10px] font-mono">khối mất nhiều lần</div>
            </div>
            <div class="bg-card border border-slate-700/50 rounded p-3">
                <div class="text-slate-400 text-xs font-mono">Khối có sự cố</div>
                <div class="text-slate-200 text-2xl font-mono font-bold"><span id="mt-sokhoi">…</span></div>
                <div class="text-slate-500 text-[10px] font-mono">khối / 30 ngày qua</div>
            </div>
            <div class="bg-card border border-slate-700/50 rounded p-3">
                <div class="text-slate-400 text-xs font-mono">Tổng thời gian mất</div>
                <div class="text-violet-300 text-2xl font-mono font-bold"><span id="mt-tonggio">…</span></div>
                <div class="text-slate-500 text-[10px] font-mono">cộng dồn trong 30 ngày</div>
            </div>
        </div>

        <div class="bg-card rounded border border-slate-700/50 p-4">
            <div class="flex items-center justify-between mb-3">
                <h3 class="text-slate-300 text-sm font-semibold">Sức khoẻ vòng đọc ô đỗ</h3>
                <span id="sk-tomtat" class="text-[10px] font-mono text-slate-500">đang đọc…</span>
            </div>
            <div id="sk-noidung" class="text-center text-slate-500 text-[11px] py-10">Đang đọc…</div>
        </div>

        <div class="bg-card rounded border border-slate-700/50 overflow-hidden">
            <div class="px-4 py-2.5 border-b border-slate-700/50">
                <span class="text-slate-300 text-xs font-semibold">Khối cần kiểm tra kết nối PLC, xếp theo mức độ (30 ngày)</span>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-xs font-mono">
                    <thead class="border-b border-slate-700/60 bg-slate-800/50">
                        <tr>
                            <th class="text-left text-slate-500 px-3 py-2.5 font-medium whitespace-nowrap">Zone</th>
                            <th class="text-left text-slate-500 px-3 py-2.5 font-medium whitespace-nowrap">Khối</th>
                            <th class="text-left text-slate-500 px-3 py-2.5 font-medium whitespace-nowrap">Địa chỉ PLC</th>
                            <th class="text-left text-slate-500 px-3 py-2.5 font-medium whitespace-nowrap">Số lần mất</th>
                            <th class="text-left text-slate-500 px-3 py-2.5 font-medium whitespace-nowrap">Tổng thời gian mất</th>
                            <th class="text-left text-slate-500 px-3 py-2.5 font-medium whitespace-nowrap">Lần lâu nhất</th>
                            <th class="text-left text-slate-500 px-3 py-2.5 font-medium whitespace-nowrap">Gần nhất</th>
                            <th class="text-left text-slate-500 px-3 py-2.5 font-medium whitespace-nowrap">Dạng hỏng</th>
                            <th class="text-left text-slate-500 px-3 py-2.5 font-medium whitespace-nowrap">Gợi ý kiểm tra</th>
                        </tr>
                    </thead>
                    <tbody id="mt-body">
                        <tr><td colspan="9" class="px-3 py-10 text-center text-slate-500 text-[11px]">Đang đọc…</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@* ===================== BẢN ĐỒ KHỐI: LỖI VÀ ĐỘNG CƠ =====================
   Đọc /Monitor/BlockMap (danh sách khối cơ khí), /BaoTri/LoiTheoKhoi (tô
   thẻ), /BaoTri/Loi và /BaoTri/DongCo (bảng bên phải). Chỉ đọc. *@
<script>
    (function () {
        "use strict";

        var URL_KHOI     = "@Url.Action("BlockMap", "Monitor")";
        var URL_ZONE     = "@Url.Action("DanhSachZone", "BaoCao")";
        var URL_DEM_LOI  = "@Url.Action("LoiTheoKhoi", "BaoTri")";
        var URL_LOI      = "@Url.Action("Loi", "BaoTri")";
        var URL_DONG_CO  = "@Url.Action("DongCo", "BaoTri")";
        var NHIP_MS      = 15000;
        var GACH         = "—";

        var khoiTheoSo   = {};    // block_no -> ban ghi BlockMap
        var khoiTheoZone = {};    // zone_id  -> [block_no]
        var loiTheoKhoi  = {};    // block_no -> so canh bao dang mo
        var tenZone      = {};    // zone_id  -> ten
        var khoiDangChon = null;

        function el(id) { return document.getElementById(id); }

        function esc(v) {
            return String(v === null || v === undefined ? "" : v)
                .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;");
        }

        function docJson(url) {
            return fetch(url, { cache: "no-store" }).then(function (r) {
                return r.json().catch(function () { return {}; }).then(function (d) {
                    if (!r.ok) throw new Error((d && d.error) || ("HTTP " + r.status));
                    if (d && d.error) throw new Error(d.error);
                    return d;
                });
            });
        }

        function baoLoi(id, e) {
            var x = el(id);
            if (x) x.innerHTML = '<span class="text-red-400">Không đọc được: ' + esc(e.message) + '</span>';
        }

        function zoneDangXem() {
            var s = el("bt-zone");
            return s && s.value ? parseInt(s.value, 10) : null;
        }

        // 125.4 giay -> "2 phút 5 giây". Nhin "125.4" nguoi truc phai tu chia.
        function chuGiay(giay) {
            if (giay === null || giay === undefined) return GACH;
            if (giay < 60) return giay + " giây";
            var p = Math.floor(giay / 60), g = Math.round(giay % 60);
            if (p < 60) return p + " phút" + (g ? " " + g + " giây" : "");
            return Math.floor(p / 60) + " giờ " + (p % 60) + " phút";
        }

        var MAU_MUC = {
            critical: "text-red-400 bg-red-950/30 border-red-800/40",
            high:     "text-orange-400 bg-orange-950/30 border-orange-800/40",
            medium:   "text-amber-400 bg-amber-950/30 border-amber-800/40",
            low:      "text-slate-400 bg-slate-800 border-slate-700"
        };

        // ------------------------------------------------------- luoi khoi
        function veLuoi() {
            var zone = zoneDangXem();
            var ds = (khoiTheoZone[zone] || []).map(function (n) { return khoiTheoSo[n]; });

            var ten = el("bt-zone-ten");
            if (ten) ten.textContent = tenZone[zone] || ("Zone " + zone);

            var coLoi = ds.filter(function (b) { return (loiTheoKhoi[b.block_no] || 0) > 0; }).length;
            var nhan = el("bt-luoi-nhan");
            if (nhan) nhan.textContent = ds.length ? (ds.length + " khối · " + coLoi + " khối đang có lỗi") : "zone này chưa có khối";

            var luoi = el("bt-luoi");
            if (!luoi) return;
            if (!ds.length) {
                luoi.innerHTML = '<div class="col-span-full text-center text-slate-500 text-xs py-6">Zone này chưa có khối cơ khí nào.</div>';
                return;
            }

            luoi.innerHTML = ds.map(function (b) {
                var soLoi = loiTheoKhoi[b.block_no] || 0;
                var chon  = b.block_no === khoiDangChon;
                var vien  = soLoi > 0 ? "rgb(239,68,68)" : "rgba(34,197,94,.35)";
                var nen   = soLoi > 0 ? "rgba(239,68,68,.12)" : "rgb(15,23,42)";
                var bong  = chon ? "box-shadow:0 0 0 2px rgb(59,130,246);" : "";
                var cham  = b.online ? "rgb(34,197,94)" : "rgb(220,38,38)";
                return '<button type="button" onclick="btChonKhoi(' + b.block_no + ')" ' +
                         'title="' + (b.online ? "PLC đang đọc được" : "PLC mất kết nối") + '" ' +
                         'class="text-left rounded-lg p-2.5 transition-all hover:brightness-125" ' +
                         'style="background:' + nen + ';border:1px solid ' + vien + ';' + bong + '">' +
                         '<div class="flex items-center justify-between mb-1">' +
                           '<span class="text-[11px] font-bold text-white">Khối ' + b.block_no + '</span>' +
                           '<span class="w-2 h-2 rounded-full" style="background:' + cham + ';"></span>' +
                         '</div>' +
                         (soLoi > 0
                           ? '<div class="text-[10px] font-bold text-red-400">' + soLoi + ' lỗi đang có</div>'
                           : '<div class="text-[10px] text-slate-500">không có lỗi</div>') +
                       '</button>';
            }).join("");
        }

        function dungDropdownKhoi() {
            var sel = el("bt-khoi");
            if (!sel) return;
            var ds = khoiTheoZone[zoneDangXem()] || [];
            sel.innerHTML = '<option value="">(chọn khối)</option>' + ds.map(function (n) {
                return '<option value="' + n + '">Khối ' + n + '</option>';
            }).join("");
            sel.value = ds.indexOf(khoiDangChon) >= 0 ? String(khoiDangChon) : "";
        }

        window.btDoiZone = function () {
            dungDropdownKhoi();
            veLuoi();
        };

        window.btDoiKhoi = function () {
            var sel = el("bt-khoi");
            if (sel && sel.value) btChonKhoi(parseInt(sel.value, 10));
        };

        // ------------------------------------------------------- mot khoi
        window.btChonKhoi = function (n) {
            khoiDangChon = n;
            var b = khoiTheoSo[n] || {};
            var sel = el("bt-khoi");
            if (sel) sel.value = String(n);
            var td = el("bt-tieu-de");
            if (td) td.textContent = "Khối " + n;
            var pd = el("bt-phu-de");
            if (pd) {
                pd.innerHTML = (tenZone[b.zone_id] ? esc(tenZone[b.zone_id]) + " · " : "") +
                               esc(b.slots) + " ô · " +
                               (b.online ? '<span class="text-emerald-400">PLC đang đọc được</span>'
                                         : '<span class="text-red-400">PLC mất kết nối</span>');
            }
            veLuoi();
            taiLoi(n, true);
            taiDongCo(n, true);
        };

        function dongLoi(x, coHet) {
            var mau = MAU_MUC[x.muc_do] || MAU_MUC.low;
            return '<div class="py-1.5 border-b border-slate-800/60">' +
                     '<div class="flex items-start justify-between gap-2">' +
                       '<span class="text-slate-200">' + esc(x.mo_ta) + '</span>' +
                       '<span class="shrink-0 border rounded px-1 text-[9px] ' + mau + '">' + esc(x.ma_loi) + '</span>' +
                     '</div>' +
                     '<div class="text-[10px] font-mono text-slate-500 mt-0.5">' +
                       esc(x.xay_ra_luc) +
                       (coHet ? (x.het_luc ? ' → hết ' + esc(x.het_luc) : ' → <span class="text-red-400">đang có</span>') : '') +
                     '</div>' +
                   '</div>';
        }

        function taiLoi(n, dangDoc) {
            // Xoa ca so dem: de lai "3 lỗi" cua khoi truoc canh tieu de khoi moi
            // la noi sai ve khoi dang xem.
            if (dangDoc) { el("bt-loi-mo").innerHTML = "Đang đọc…"; el("bt-loi-ls").innerHTML = "Đang đọc…"; el("bt-loi-dem").textContent = ""; }
            docJson(URL_LOI + "?block=" + n + "&limit=20").then(function (d) {
                if (khoiDangChon !== n) return;   // nguoi dung da chon khoi khac
                el("bt-loi-dem").textContent = d.dang_mo.length ? d.dang_mo.length + " lỗi" : "";
                el("bt-loi-mo").innerHTML = d.dang_mo.length
                    ? d.dang_mo.map(function (x) { return dongLoi(x, false); }).join("")
                    : '<span class="text-emerald-400">Không có lỗi nào đang mở.</span>';
                el("bt-loi-ls").innerHTML = d.lich_su.length
                    ? d.lich_su.map(function (x) { return dongLoi(x, true); }).join("")
                    : '<span class="text-slate-500">Khối này chưa từng có cảnh báo.</span>';
            }).catch(function (e) {
                if (khoiDangChon !== n) return;
                el("bt-loi-dem").textContent = "";
                baoLoi("bt-loi-mo", e); baoLoi("bt-loi-ls", e);
            });
        }

        function taiDongCo(n, dangDoc) {
            if (dangDoc) { el("bt-dc-tong").innerHTML = "Đang đọc…"; el("bt-dc-ls").innerHTML = "Đang đọc…"; el("bt-dc-nhan").textContent = ""; }
            docJson(URL_DONG_CO + "?block=" + n + "&limit=50").then(function (d) {
                if (khoiDangChon !== n) return;
                el("bt-dc-nhan").textContent = "khối " + d.loai_khoi + " ô";
                var ghiChu = d.co_du_lieu ? "" :
                    '<div class="mb-2 text-amber-400 text-[10px]">Chưa có dữ liệu: ' + esc(d.ly_do) + '.</div>';
                // Thoi gian hoat dong = so lan x thoi gian chuan cua loai (truot
                // 20 s, nang 24 s, hang rao 12 s) — may chu da nhan san. Nam cham
                // khong co thoi gian chuan nen chi hien so lan.
                function lanVaGio(soLan, giay) {
                    return esc(soLan) + ' lần' +
                           (giay === null || giay === undefined ? '' :
                            '<span class="text-slate-500"> · ' + esc(chuGiay(giay)) + '</span>');
                }

                var theLoai = (d.theo_loai || []).map(function (l) {
                    return '<div class="rounded border border-slate-700/60 bg-slate-900/60 p-2">' +
                             '<div class="text-[10px] text-slate-400">' + esc(l.ten_loai) +
                               (l.thoi_gian_chuan_giay ? ' <span class="text-slate-600">(' + esc(l.thoi_gian_chuan_giay) + ' s/lần)</span>' : '') +
                             '</div>' +
                             '<div class="text-[11px] text-slate-200 font-mono">Hôm nay: ' + lanVaGio(l.so_lan_hom_nay, l.thoi_gian_hom_nay_giay) + '</div>' +
                             '<div class="text-[11px] text-slate-200 font-mono">Tổng: ' + lanVaGio(l.so_lan_tong, l.thoi_gian_tong_giay) + '</div>' +
                           '</div>';
                }).join("");

                el("bt-dc-tong").innerHTML = ghiChu +
                    '<div class="grid grid-cols-2 gap-2 mb-3">' + theLoai + '</div>' +
                    '<table class="w-full font-mono text-[11px]"><thead><tr class="text-slate-500 text-[10px]">' +
                      '<th class="text-left py-1">Động cơ</th><th class="text-left py-1">Loại</th>' +
                      '<th class="text-right py-1">Hôm nay</th><th class="text-right py-1">Tổng</th>' +
                      '<th class="text-right py-1">Lần cuối</th></tr></thead><tbody>' +
                    d.tong_hop.map(function (x) {
                        return '<tr class="border-t border-slate-800/60 align-top">' +
                                 '<td class="py-1 text-slate-200" title="' + esc(x.bit) + '">' + esc(x.motor_code) + '</td>' +
                                 '<td class="py-1 text-slate-400">' + esc(x.ten_loai || GACH) + '</td>' +
                                 '<td class="py-1 text-right text-slate-300">' + lanVaGio(x.hom_nay, x.thoi_gian_hom_nay_giay) + '</td>' +
                                 '<td class="py-1 text-right text-slate-300">' + lanVaGio(x.tong, x.thoi_gian_tong_giay) + '</td>' +
                                 '<td class="py-1 text-right text-slate-500">' + esc(x.lan_cuoi ? x.lan_cuoi.substr(5, 11) : GACH) + '</td>' +
                               '</tr>';
                    }).join("") + '</tbody></table>';
                // Bo thoi luong do duoc: no khong phai thoi gian hoat dong da chot
                // (so lan x chuan), hien canh nhau chi gay nham.
                el("bt-dc-ls").innerHTML = d.lich_su.length
                    ? d.lich_su.map(function (x) {
                          return '<div class="flex justify-between py-1 border-b border-slate-800/60 font-mono">' +
                                   '<span class="text-slate-200">' + esc(x.motor_code) + '</span>' +
                                   '<span class="text-slate-400">' + esc(x.ten_loai || GACH) + '</span>' +
                                   '<span class="text-slate-500">' + esc(x.bat_dau.substr(5)) + '</span>' +
                                 '</div>';
                      }).join("")
                    : '<span class="text-slate-500">Chưa ghi nhận lượt chạy nào.</span>';
            }).catch(function (e) {
                if (khoiDangChon !== n) return;
                el("bt-dc-nhan").textContent = "";
                baoLoi("bt-dc-tong", e); baoLoi("bt-dc-ls", e);
            });
        }

        // ------------------------------------------------------- lam moi
        function tick() {
            Promise.all([docJson(URL_KHOI), docJson(URL_DEM_LOI)]).then(function (kq) {
                khoiTheoSo = {}; khoiTheoZone = {};
                (kq[0].blocks || []).forEach(function (b) {
                    khoiTheoSo[b.block_no] = b;
                    (khoiTheoZone[b.zone_id] = khoiTheoZone[b.zone_id] || []).push(b.block_no);
                });
                Object.keys(khoiTheoZone).forEach(function (z) {
                    khoiTheoZone[z].sort(function (a, b) { return a - b; });
                });
                loiTheoKhoi = {};
                (kq[1].items || []).forEach(function (x) { loiTheoKhoi[x.block_no] = x.dang_mo; });

                var cn = el("bt-cap-nhat");
                if (cn) { cn.textContent = "cập nhật " + (kq[1].now || ""); cn.className = "text-[10px] font-mono text-slate-500"; }
                dungDropdownKhoi();
                veLuoi();
                if (khoiDangChon !== null) { taiLoi(khoiDangChon, false); taiDongCo(khoiDangChon, false); }
            }).catch(function (e) {
                // Xoa luoi chu khong giu thẻ cu: mot luoi dung yen trong y het
                // mot bai khong co loi nao.
                var cn = el("bt-cap-nhat");
                if (cn) { cn.textContent = "không đọc được"; cn.className = "text-[10px] font-mono text-red-400"; }
                baoLoi("bt-luoi", e);
            });
        }

        function napZone() {
            return docJson(URL_ZONE).then(function (d) {
                var sel = el("bt-zone");
                (d.items || []).forEach(function (z) {
                    tenZone[z.zone_id] = z.ten;
                    if (sel) {
                        var o = document.createElement("option");
                        o.value = z.zone_id;
                        o.textContent = z.ten;
                        sel.appendChild(o);
                    }
                });
            }).catch(function () {
                // Khong co ten zone thi van ve duoc theo so zone tu BlockMap.
                var sel = el("bt-zone");
                if (sel) for (var z = 1; z <= 6; z++) {
                    var o = document.createElement("option"); o.value = z; o.textContent = "Zone " + z; sel.appendChild(o);
                }
            });
        }

        var timer = null;
        function batDau() { if (timer) return; tick(); timer = setInterval(tick, NHIP_MS); }

        document.addEventListener("visibilitychange", function () {
            if (document.hidden) { if (timer) { clearInterval(timer); timer = null; } }
            else batDau();
        });

        function khoiDong() { napZone().then(batDau); }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", khoiDong);
        } else {
            khoiDong();
        }
    })();
</script>

@* ===================== BAI TOAN: KHOI NAO CAN DI XEM TRUOC =====================
   Doc /BaoCao/DoTinCayKhoi — gom canh_bao PLC-CONN-01 theo khoi. *@
<script>
    (function () {
        "use strict";

        var URL_TC  = "@Url.Action("DoTinCayKhoi", "BaoCao")";
        var NHIP_MS = 30000;
        var GACH    = "\u2014";

        function el(id) { return document.getElementById(id); }
        function dat(id, v) { var e = el(id); if (e) e.textContent = v; }

        function esc(v) {
            return String(v === null || v === undefined ? "" : v)
                .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;");
        }

        // Phut -> chu de doc. Mot con so 2269 khong noi len dieu gi voi nguoi truc;
        // "1 ngay 13 gio" thi co.
        function chuThoiGian(phut) {
            if (!phut) return GACH;
            if (phut < 60) return phut + " phút";
            var gio = Math.floor(phut / 60), du = phut % 60;
            if (gio < 24) return gio + " giờ" + (du ? " " + du + " phút" : "");
            var ngay = Math.floor(gio / 24);
            return ngay + " ngày" + (gio % 24 ? " " + (gio % 24) + " giờ" : "");
        }

        var MAU = {
            dang_mat:   ["text-rose-400",    "bg-rose-950/20 border-rose-800/30",    "Đang mất"],
            chap_chon:  ["text-amber-400",   "bg-amber-950/20 border-amber-800/30",  "Chập chờn"],
            chet_lau:   ["text-orange-400",  "bg-orange-950/20 border-orange-800/30","Chết lâu"],
            thoang_qua: ["text-slate-400",   "bg-slate-800 border-slate-700",        "Thoáng qua"]
        };

        function ve(d) {
            dat("mt-dangmat",  d.dang_mat);
            dat("mt-chapchon", d.chap_chon);
            dat("mt-sokhoi",   d.so_khoi);
            dat("mt-tonggio",  d.tong_gio + "h");

            var body = el("mt-body");
            if (!body) return;

            if (!d.items.length) {
                body.innerHTML = '<tr><td colspan="9" class="px-3 py-10 text-center text-slate-500 text-[11px]">' +
                                 'Không khối nào mất kết nối trong ' + esc(d.so_ngay) + ' ngày qua.</td></tr>';
                return;
            }

            body.innerHTML = d.items.map(function (x) {
                var m = MAU[x.dang] || MAU.thoang_qua;
                return '<tr class="border-b border-slate-850 hover:bg-slate-800/20">' +
                         '<td class="px-3 py-2 text-slate-400">Z' + esc(x.zone_id) + '</td>' +
                         '<td class="px-3 py-2 text-slate-200 font-bold">Khối ' + esc(x.block_no) + '</td>' +
                         '<td class="px-3 py-2 text-slate-500">' + esc(x.ip || GACH) + '</td>' +
                         '<td class="px-3 py-2 text-slate-300">' + esc(x.so_lan) + '</td>' +
                         '<td class="px-3 py-2 text-slate-300">' + esc(chuThoiGian(x.tong_phut)) + '</td>' +
                         '<td class="px-3 py-2 text-slate-400">' + esc(chuThoiGian(x.lan_lau_nhat)) + '</td>' +
                         '<td class="px-3 py-2 text-slate-500">' + esc(x.gan_nhat) + '</td>' +
                         '<td class="px-3 py-2"><span class="' + m[0] + ' font-semibold ' + m[1] +
                           ' border px-1.5 py-0.5 rounded text-[10px]">' + m[2] + '</span></td>' +
                         '<td class="px-3 py-2 text-slate-400">' + esc(x.goi_y) + '</td>' +
                       '</tr>';
            }).join("");
        }

        function tick() {
            fetch(URL_TC + "?ngay=30", { cache: "no-store" })
                .then(function (r) {
                    if (!r.ok) throw new Error("HTTP " + r.status);
                    return r.json();
                })
                .then(function (d) {
                    if (d && d.error) throw new Error(d.error);
                    ve(d);
                })
                .catch(function (e) {
                    // Xoa het chu khong giu so cu: mot trang bao tri hien so cu
                    // trong y het mot he thong khong co van de gi.
                    ["mt-dangmat", "mt-chapchon", "mt-sokhoi", "mt-tonggio"].forEach(function (i) {
                        dat(i, GACH);
                    });
                    var b = el("mt-body");
                    if (b) {
                        b.innerHTML = '<tr><td colspan="9" class="px-3 py-10 text-center text-red-400 text-[11px]">' +
                                      'Không đọc được: ' + esc(e.message) + '</td></tr>';
                    }
                });
        }

        var timer = null;
        function batDau() { if (timer) return; tick(); timer = setInterval(tick, NHIP_MS); }

        document.addEventListener("visibilitychange", function () {
            if (document.hidden) { if (timer) { clearInterval(timer); timer = null; } }
            else batDau();
        });

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", batDau);
        } else {
            batDau();
        }
    })();
</script>

@* ===================== SUC KHOE VONG DOC O =====================
   Doc /BaoCao/SucKhoeVongDoc. Khac bai toan mat ket noi o bang tren: o day
   khoi van ket noi duoc nhung thanh ghi o khong duoc cap nhat. *@
<script>
    (function () {
        "use strict";

        var URL_SK  = "@Url.Action("SucKhoeVongDoc", "BaoCao")";
        var NHIP_MS = 30000;
        var GACH    = "—";

        function el(id) { return document.getElementById(id); }

        function esc(v) {
            return String(v === null || v === undefined ? "" : v)
                .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;");
        }

        function ve(d) {
            var tt = el("sk-tomtat");
            var nd = el("sk-noidung");

            // Vong quet chet la truong hop nguy hiem nhat va de bo sot nhat: moi
            // o van con gia tri cu, khong o nao "trong", chi co moc thoi gian la
            // cu dan. Nen kiem rieng thay vi chi dem o qua han.
            var quetChet = d.quet_cach_day_phut !== null && d.quet_cach_day_phut >= 5;

            if (tt) {
                tt.textContent = d.tong_o + " ô / " + d.tong_khoi + " khối · quét gần nhất " +
                                 (d.quet_gan_nhat || GACH) +
                                 (d.quet_cach_day_phut !== null
                                     ? " (" + d.quet_cach_day_phut + " phút trước)" : "");
                tt.className = "text-[10px] font-mono " + (quetChet ? "text-red-400" : "text-slate-500");
            }

            if (!nd) return;

            if (quetChet) {
                nd.innerHTML = '<div class="text-red-400 text-[11px] py-8">' +
                               'Vòng quét chưa chạy ' + esc(d.quet_cach_day_phut) + ' phút. ' +
                               'Mọi con số ô đỗ trên hệ thống đang là giá trị đọc được lần cuối, ' +
                               'không phải hiện trạng.</div>';
                return;
            }

            if (!d.khoi.length) {
                nd.innerHTML = '<div class="text-emerald-400 text-[11px] py-8">' +
                               'Tất cả ' + esc(d.tong_o) + ' ô ở ' + esc(d.tong_khoi) +
                               ' khối đều đọc được trong 5 phút gần đây.</div>';
                return;
            }

            nd.className = "text-left";
            nd.innerHTML =
                '<div class="text-amber-400 text-[11px] mb-2">' + d.khoi.length +
                  ' khối có ô không đọc được:</div>' +
                '<div class="space-y-1 font-mono text-[11px]">' +
                d.khoi.map(function (x) {
                    return '<div class="flex justify-between py-1 border-b border-slate-800/60">' +
                             '<span class="text-slate-300">Khối ' + esc(x.block_no) +
                               ' <span class="text-slate-600">(Z' + esc(x.zone_id) + ')</span></span>' +
                             '<span class="text-slate-400">' + esc(x.qua_han + x.chua_doc) + '/' +
                               esc(x.so_o) + ' ô · cũ nhất ' + esc(x.cu_nhat_phut) + ' phút</span>' +
                           '</div>';
                }).join("") +
                '</div>';
        }

        function tick() {
            fetch(URL_SK, { cache: "no-store" })
                .then(function (r) {
                    if (!r.ok) throw new Error("HTTP " + r.status);
                    return r.json();
                })
                .then(function (d) {
                    if (d && d.error) throw new Error(d.error);
                    ve(d);
                })
                .catch(function (e) {
                    var tt = el("sk-tomtat");
                    if (tt) { tt.textContent = GACH; tt.className = "text-[10px] font-mono text-red-400"; }
                    var nd = el("sk-noidung");
                    if (nd) {
                        nd.className = "text-center text-red-400 text-[11px] py-10";
                        nd.textContent = "Không đọc được: " + e.message;
                    }
                });
        }

        var timer = null;
        function batDau() { if (timer) return; tick(); timer = setInterval(tick, NHIP_MS); }

        document.addEventListener("visibilitychange", function () {
            if (document.hidden) { if (timer) { clearInterval(timer); timer = null; } }
            else batDau();
        });

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", batDau);
        } else {
            batDau();
        }
    })();
</script>
