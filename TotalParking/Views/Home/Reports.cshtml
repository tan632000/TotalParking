        display: none !important;
    }

    .report-panel.active {
        display: block !important;
    }

    /* SCADA glowing animations for maintenance frequency heatmap */
    @@keyframes heat-glow-red {
        0%, 100% { 
            box-shadow: 0 0 4px rgba(239, 68, 68, 0.15); 
            border-color: rgba(239, 68, 68, 0.4); 
            background-color: rgba(127, 29, 29, 0.2);
        }
        50% { 
            box-shadow: 0 0 12px rgba(239, 68, 68, 0.45); 
            border-color: rgba(239, 68, 68, 0.8); 
            background-color: rgba(127, 29, 29, 0.35);
        }
    }
    .pallet-glow-red {
        animation: heat-glow-red 2s infinite ease-in-out;
    }
</style>

<script>
    // Tab switching controller
    function switchReportTab(tabId) {
        // 1. Hide all panels
        const panels = document.querySelectorAll('.report-panel');
        panels.forEach(panel => {
            panel.classList.remove('active');
        });

        // 2. Deactivate all buttons
        const buttons = document.querySelectorAll('.report-tab-btn');
        buttons.forEach(btn => {
            btn.classList.remove('active');
        });

        // 3. Activate selected panel and button
        document.getElementById('panel-' + tabId).classList.add('active');
        document.getElementById('btn-' + tabId).classList.add('active');

        // Thanh loc chi dieu khien tab Mat do. Cac tab khac doc nguon khac va
        // khong nhan khoang ngay, nen de thanh loc hien o do se khien nguoi
        // dung doi ngay roi bam Xem lai ma khong thay gi thay doi.
        var loc = document.getElementById('loc-bar');
        if (loc) loc.style.display = (tabId === 'density') ? '' : 'none';
    }

    // ----------------------------------------------------------------- Tìm xe
    // Tra vị trí xe bằng DỮ LIỆU THẬT qua /VehicleFinder/Find.
    //
    // Bản trước của hàm này tra trong một mảng cứng gồm 3 xe, và với mọi truy vấn
    // không khớp thì SINH NGẪU NHIÊN một mã thẻ rồi luôn trả về
    // "Block A-01 / Pallet P08". Gõ gì cũng ra xe, không bao giờ báo không tìm
    // thấy — nhân viên sẽ đi tìm chiếc xe không tồn tại.
    //
    // Nguyên tắc ở đây: KHÔNG hiển thị thứ gì hệ thống không thật sự biết.
    // Chưa có dữ liệu bảng parking_slot nên không vẽ lưới pallet; nói thẳng là
    // mới định vị được tới block.
    let carFinderBusy = false;

    function escHtml(s) {
        if (s === null || s === undefined) return '';
        return String(s).replace(/[&<>"']/g, function (c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
    }

    function finderBox(iconColor, title, detail) {
        return `
            <div class="text-center space-y-2 py-6">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mx-auto ${iconColor}"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
                <div class="text-xs font-bold text-slate-300 font-mono">${escHtml(title)}</div>
                <div class="text-[11px] text-slate-500 font-mono">${escHtml(detail)}</div>
            </div>
        `;
    }

    function runCarFinder() {
        const input = document.getElementById('search-query-input');
        const container = document.getElementById('finder-result-container');
        const query = input.value.trim();

        if (!query) {
            container.innerHTML = finderBox('text-slate-700', 'Chưa nhập gì',
                'Nhập mã thẻ RFID, số thẻ hoặc biển số xe.');
            return;
        }
        if (carFinderBusy) return;
        carFinderBusy = true;

        container.innerHTML = finderBox('text-blue-400 animate-pulse', 'Đang tra cứu...',
            'Đang truy vấn cơ sở dữ liệu phiên gửi xe.');

        fetch('/VehicleFinder/Find?q=' + encodeURIComponent(query))
            .then(function (r) { return r.json().then(function (j) { return { status: r.status, body: j }; }); })
            .then(function (res) { renderCarFinder(res.body, query); })
            .catch(function (err) {
                container.innerHTML = finderBox('text-red-400', 'Không gọi được máy chủ',
                    String(err && err.message ? err.message : err));
            })
            .then(function () { carFinderBusy = false; });
    }

    function renderCarFinder(data, query) {
        const container = document.getElementById('finder-result-container');
        const outcome = data && data.outcome;

        if (outcome === 'card_unknown') {
            container.innerHTML = finderBox('text-amber-400', 'Không tìm thấy "' + query + '"',
                'Mã thẻ, số thẻ hoặc biển số này không có trong hệ thống. Kiểm tra lại cách nhập.');
            return;
        }
        if (outcome === 'no_session') {
            container.innerHTML = finderBox('text-amber-400', 'Thẻ hợp lệ nhưng không thấy xe trong ô nào',
                'Thẻ có trong danh sách đăng ký, nhưng vòng quét PLC không thấy mã thẻ này ở ô đỗ nào.');
            return;
        }
        if (outcome === 'db_error') {
            container.innerHTML = finderBox('text-red-400', 'Lỗi cơ sở dữ liệu',
                (data && data.message) || 'Không truy vấn được.');
            return;
        }
        if (outcome !== 'found' || !data.results || !data.results.length) {
            container.innerHTML = finderBox('text-amber-400', 'Không có kết quả',
                (data && data.message) || 'Không tìm thấy phiên gửi xe nào.');
            return;
        }

        const v = data.results[0];
        const live = v.is_active;

        // Đang trong bãi và đã lấy ra là hai câu trả lời khác hẳn nhau về nghiệp
        // vụ, nên phải khác nhau cả về màu lẫn chữ — không chỉ khác một dòng nhỏ.
        const badge = live
            ? `<span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 font-mono">
                   <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> ĐANG TRONG BÃI - ${escHtml(v.status)}
               </span>`
            : `<span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-slate-500/10 border border-slate-600/40 text-slate-400 font-mono">
                   <span class="w-1.5 h-1.5 rounded-full bg-slate-500"></span> ĐÃ LẤY RA - ${escHtml(v.status)}
               </span>`;

        const zoneText  = v.zone_id ? ('Zone ' + v.zone_id + (v.zone_name ? ' (' + v.zone_name + ')' : '')) : 'Chưa phân zone';
        const blockText = v.block_no ? ('Block ' + v.block_no) : 'Chưa phân block';
        const plateText = v.plate ? v.plate : 'Chưa có biển số';

        // Từ khi VehicleFinderRepository đọc thanh ghi, slot_label mang số ô và
        // địa chỉ thật ("Ô 01 (D400)"). Nhánh dưới giữ lại cho trường hợp máy chủ
        // cũ hoặc dữ liệu thiếu: thà nói chưa định vị được còn hơn vẽ một ô bịa.
        const slotText = v.slot_label
            ? v.slot_label
            : (v.slot_count ? 'Chưa định vị (block có ' + v.slot_count + ' ô)' : 'Chưa định vị');

        let historyHtml = '';
        if (data.results.length > 1) {
            let rows = '';
            for (let i = 1; i < data.results.length; i++) {
                const h = data.results[i];
                rows += `
                    <tr class="border-b border-slate-850/60">
                        <td class="py-1.5 pr-3 text-slate-400">${escHtml(h.created_at)}</td>
                        <td class="py-1.5 pr-3 text-slate-400">${h.block_no ? 'Block ' + h.block_no : '-'}</td>
                        <td class="py-1.5 pr-3 text-slate-500">${escHtml(h.status)}</td>
                        <td class="py-1.5 text-slate-500">${escHtml(h.duration)}</td>
                    </tr>`;
            }
            historyHtml = `
                <div class="mt-3 pt-3 border-t border-slate-850">
                    <div class="text-[10px] text-slate-500 font-mono uppercase tracking-wider mb-2">Các phiên trước của thẻ này</div>
                    <table class="w-full text-[10px] font-mono">
                        <thead><tr class="text-slate-600 border-b border-slate-850">
                            <th class="text-left font-normal pb-1 pr-3">Vào lúc</th>
                            <th class="text-left font-normal pb-1 pr-3">Vị trí</th>
                            <th class="text-left font-normal pb-1 pr-3">Trạng thái</th>
                            <th class="text-left font-normal pb-1">Thời lượng</th>
                        </tr></thead>
                        <tbody>${rows}</tbody>
                    </table>
                </div>`;
        }

        container.innerHTML = `
            <div class="w-full text-left p-4 bg-slate-900 rounded-lg border border-slate-800 space-y-4 shadow-2xl">
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-3 pb-3 border-b border-slate-800/60">
                    <div class="flex items-center gap-3">
                        <div class="p-2 ${live ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/25' : 'bg-slate-700/20 text-slate-400 border-slate-700/40'} rounded-md border">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"></path><circle cx="7" cy="17" r="2"></circle><path d="M9 17h6"></path><circle cx="17" cy="17" r="2"></circle></svg>
                        </div>
                        <div>
                            <h4 class="text-sm font-bold text-white tracking-wider font-mono">${escHtml(plateText)}</h4>
                            <div class="text-[10px] text-slate-500 font-mono mt-0.5">
                                Mã thẻ RFID: <span class="text-slate-300">${escHtml(v.card_code)}</span>
                                ${v.card_no ? ' &middot; Số thẻ: <span class="text-slate-300">' + escHtml(v.card_no) + '</span>' : ''}
                            </div>
                        </div>
                    </div>
                    <div class="text-right">${badge}</div>
                </div>

                <div class="grid grid-cols-2 md:grid-cols-4 gap-3 text-xs font-mono">
                    <div class="p-2.5 bg-slate-950/60 rounded border border-slate-850">
                        <span class="text-slate-500 text-[9px] uppercase tracking-wider block">Khu vực (Zone)</span>
                        <span class="text-slate-200 font-bold block mt-0.5">${escHtml(zoneText)}</span>
                    </div>
                    <div class="p-2.5 bg-slate-950/60 rounded border border-slate-850">
                        <span class="text-slate-500 text-[9px] uppercase tracking-wider block">Khối đỗ (Block)</span>
                        <span class="text-blue-400 font-bold block mt-0.5">${escHtml(blockText)}</span>
                    </div>
                    <div class="p-2.5 bg-slate-950/60 rounded border border-slate-850">
                        <span class="text-slate-500 text-[9px] uppercase tracking-wider block">Khay đỗ (Pallet)</span>
                        <span class="${v.slot_label ? 'text-yellow-400' : 'text-slate-500'} font-bold block mt-0.5">${escHtml(slotText)}</span>
                    </div>
                    <div class="p-2.5 bg-slate-950/60 rounded border border-slate-850">
                        <span class="text-slate-500 text-[9px] uppercase tracking-wider block">Thời lượng đỗ</span>
                        <span class="text-slate-200 font-bold block mt-0.5">${escHtml(v.duration)}</span>
                    </div>
                </div>

                <div class="flex flex-wrap gap-x-5 gap-y-1 text-[10px] text-slate-500 font-mono pt-1">
                    <span>Vào lúc: <span class="text-slate-400">${escHtml(v.created_at)}</span></span>
                    ${v.parked_at ? '<span>Đã cất xong: <span class="text-slate-400">' + escHtml(v.parked_at) + '</span></span>' : ''}
                    ${v.completed_at ? '<span>Lấy ra lúc: <span class="text-slate-400">' + escHtml(v.completed_at) + '</span></span>' : ''}
                    <span>Phiên #${v.session_id}</span>
                </div>
                ${historyHtml}
            </div>
        `;
    }

    function clearCarFinder() {
        document.getElementById('search-query-input').value = '';
        const container = document.getElementById('finder-result-container');
        container.innerHTML = `
            <div class="text-slate-550 space-y-2 py-4">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mx-auto text-slate-700"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
                <div class="text-xs font-mono">Nhập thông tin biển số hoặc số thẻ từ để dò vị trí pallet đỗ xe cơ khí thực tế.</div>
            </div>
        `;
    }

    function simulateReleaseCar(slot, block) {
        const btn = document.getElementById('btn-release-car');
        const progressBox = document.getElementById('release-progress-box');
        const progressBar = document.getElementById('release-progress-bar');
        const percentText = document.getElementById('release-percent-text');
        const statusText = document.getElementById('release-status-text');
        const timerText = document.getElementById('release-timer-text');
        
        btn.disabled = true;
        btn.className = "w-full sm:w-auto px-4 py-2 bg-slate-800 text-slate-500 text-xs font-bold rounded-lg cursor-not-allowed flex items-center justify-center gap-1.5 border border-slate-750";
        progressBox.classList.remove('hidden');

        let percent = 0;
        const interval = setInterval(() => {
            percent += 10;
            progressBar.style.width = percent + "%";
            percentText.innerText = percent + "%";

            if (percent === 30) {
                statusText.innerText = "PLC phản hồi: Mâm xoay đang hạ...";
                timerText.innerText = "Dự kiến: 2s";
            } else if (percent === 70) {
                statusText.innerText = "Cảm biến an toàn: Đường ra thông thoáng...";
                timerText.innerText = "Dự kiến: 1s";
            } else if (percent === 100) {
                clearInterval(interval);
                statusText.innerText = "Lấy xe thành công! Mâm đỗ đã hạ về mặt đất.";
                statusText.className = "text-emerald-400 font-bold";
                progressBar.className = "h-full bg-emerald-500 transition-all duration-300";
                timerText.innerText = "Hoàn thành";
                
                // Add log entry to history table dynamically
                // Khoi chen mot dong "RFID-Release" gia vao bang lich su da bi go.
                // Bang do gio doc /BaoCao/LichSuQuetThe, va mot dong bia chen tu
                // trinh duyet se dung ngay canh du lieu that ma khong phan biet
                // duoc. Lenh nha the that su xay ra se hien o nhip doc ke tiep.

                // Recalculate count
                filterHistoryTable();

                setTimeout(() => {
                    progressBox.classList.add('hidden');
                    btn.disabled = false;
                    btn.className = "w-full sm:w-auto px-4 py-2 bg-amber-600 hover:bg-amber-500 text-slate-950 text-xs font-bold rounded-lg transition-all flex items-center justify-center gap-1.5 shadow-lg shadow-amber-500/10";
                    statusText.className = "text-amber-400 font-bold";
                    statusText.innerText = "Đang gửi lệnh PLC xoay mâm...";
                    progressBar.className = "h-full bg-amber-500 transition-all duration-300";
                    progressBar.style.width = "0%";
                    percentText.innerText = "0%";
                }, 4000);
            }
        }, 300);
    }

    function filterHistoryTable() {
        const dateFrom = document.getElementById('history-date-from').value;
        const dateTo = document.getElementById('history-date-to').value;
        const searchText = document.getElementById('history-search-text').value.toUpperCase().trim();
        const action = document.getElementById('history-filter-action').value;
        const zone = document.getElementById('history-filter-zone').value;

        const table = document.getElementById('history-data-table');
        const trs = table.getElementsByTagName('tbody')[0].getElementsByTagName('tr');
        let count = 0;

        for (let i = 0; i < trs.length; i++) {
            const tr = trs[i];
            
            // Get data attributes or fallback to parsing row
            const rowTime = tr.getAttribute('data-time') || tr.cells[0].textContent.trim();
            const rowCard = (tr.getAttribute('data-card') || tr.cells[1].textContent.trim()).toUpperCase();
            const rowPlate = (tr.getAttribute('data-plate') || tr.cells[2].textContent.trim()).toUpperCase();
            // Doc tu chinh o "Ket qua" dang hien, khong tu thuoc tinh data-*:
            // cac dong ve tu may chu khong mang thuoc tinh do.
            const chuKetQua = tr.cells.length > 5 ? tr.cells[5].textContent : '';
            const rowAction = chuKetQua.includes('Thấy ở khối') ? 'found'
                            : chuKetQua.includes('Không thấy')  ? 'notfound' : 'other';
            const locationText = tr.cells[4].textContent.toUpperCase();
            
            // Extract Zone
            let rowZone = tr.getAttribute('data-zone') || '';
            if (!rowZone) {
                if (locationText.includes('ZONE 1') || locationText.includes('(A)')) rowZone = 'A';
                else if (locationText.includes('ZONE 2') || locationText.includes('(B)')) rowZone = 'B';
                else if (locationText.includes('ZONE 3') || locationText.includes('(C)')) rowZone = 'C';
                else if (locationText.includes('ZONE 4') || locationText.includes('(D)')) rowZone = 'D';
            }

            // Extract Date (from DD-MM-YYYY HH:mm:ss to YYYY-MM-DD)
            let rowDate = '';
            try {
                const datePart = rowTime.split(' ')[0];
                const parts = datePart.split('-');
                rowDate = `${parts[2]}-${parts[1]}-${parts[0]}`;
            } catch (e) {
                rowDate = '';
            }

            let match = true;

            // 1. Date From filter
            if (dateFrom && rowDate && rowDate < dateFrom) match = false;
            
            // 2. Date To filter
            if (dateTo && rowDate && rowDate > dateTo) match = false;

            // 3. Search text (Card or Plate)
            if (searchText) {
                if (rowCard.indexOf(searchText) === -1 && rowPlate.indexOf(searchText) === -1) {
                    match = false;
                }
            }

            // 4. Action type
            if (action !== 'all' && rowAction !== action) match = false;

            // 5. Status


            // 6. Zone
            if (zone !== 'all' && rowZone !== zone) match = false;

            if (match) {
                tr.style.display = "";
                count++;
            } else {
                tr.style.display = "none";
            }
        }

        document.getElementById('history-results-count').innerText = `Tìm thấy ${count} lượt gửi xe khớp với điều kiện`;
    }

    function resetHistoryFilters() {
        // Dat lai theo hom nay chu khong theo mot moc cung. Hai gia tri cu
        // la 01/06 va 16/06/2026, trong khi du lieu that bat dau tu thang 9 —
        // bam Loc la bang trong sach du ben duoi dang co hang tram dong.
        datNgayMacDinh('history-date-from', 'history-date-to');
        document.getElementById('history-search-text').value = '';
        document.getElementById('history-filter-action').value = 'all';
        document.getElementById('history-filter-status').value = 'all';
        document.getElementById('history-filter-zone').value = 'all';
        filterHistoryTable();
    }

</script>

@* ===================== SO LIEU THAT =====================
   Bon bang cua trang nay tung viet cung trong HTML. Hai bang duoi day co nguon
   that; hai bang con lai (bao tri, doanh thu) khong co bang nao trong CSDL nen
   giu trang thai rong thay vi noi bua vao mot nguon gan dung. *@
<script>
    (function () {
        "use strict";

        var URL_LICHSU = "@Url.Action("LichSuQuetThe", "BaoCao")";
        var URL_LOI    = "@Url.Action("NguyenNhanLoi", "BaoCao")";
        var NHIP_MS    = 20000;

        function el(id) { return document.getElementById(id); }

        function esc(v) {
            return String(v === null || v === undefined ? "" : v)
                .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;");
        }

        function bao(id, soCot, mau, chu) {
            var e = el(id);
            if (e) {
                e.innerHTML = '<tr><td colspan="' + soCot + '" class="px-3 py-8 text-center ' +
                              mau + ' text-[11px]">' + chu + '</td></tr>';
            }
        }

        // ------------------------------------------------ lich su quet the
        function veLichSu(d) {
            var body = el("bc-lichsu-body");
            if (!body) return;

            if (!d.items.length) {
                bao("bc-lichsu-body", 6, "text-slate-500", "Chưa có lượt tra cứu nào.");
                var d0 = el("history-results-count");
                if (d0) d0.textContent = "chưa có lượt tra cứu nào";
                return;
            }

            body.innerHTML = d.items.map(function (x) {
                // Day la nhat ky TIM XE, khong phai cho xe vao. Ban dau bang nay
                // gan nhan "Cho vao / Tu choi" — sai, va sai theo huong lam nguoi
                // truc tuong he thong dang chan the khach. plc_request ghi lai moi
                // luot tai xe quet the de hoi "xe toi o dau", va result_permit la
                // TIM THAY hay khong. Xem ghi chu tai BaoCaoRepository.
                //
                // Ba trang thai chu khong phai hai: null nghia la luot quet chua
                // duoc tra loi, khac han voi "khong thay xe".
                var ketQua;
                if (x.tim_thay === true) {
                    ketQua = '<span class="text-emerald-400 font-semibold bg-emerald-950/20 border border-emerald-800/30 px-1.5 py-0.5 rounded text-[10px]">Thấy ở khối ' +
                             esc(x.block_tra_ve) + '</span>';
                } else if (x.tim_thay === false) {
                    ketQua = '<span class="text-slate-400 font-semibold bg-slate-800 border border-slate-700 px-1.5 py-0.5 rounded text-[10px]">Không thấy xe</span>';
                } else {
                    ketQua = '<span class="text-amber-400 text-[10px]">chưa trả lời</span>';
                }

                // The la (khong co trong danh muc) phai nhin ra ngay: do la luc
                // hay co chuyen, va giau no di la giau dung phan dang xem.
                var maThe = x.ma_the
                    ? (x.so_the ? esc(x.so_the) : '<span class="text-amber-400">' + esc(x.ma_the) + ' (thẻ lạ)</span>')
                    : '<span class="text-slate-600">không đọc được</span>';

                return '<tr class="border-b border-slate-850 hover:bg-slate-800/20">' +
                         '<td class="px-3 py-2 text-slate-400">' + esc(x.luc) + '</td>' +
                         '<td class="px-3 py-2 text-slate-300">' + maThe + '</td>' +
                         '<td class="px-3 py-2 text-slate-300 font-bold">' +
                           (x.bien_so ? esc(x.bien_so) : '<span class="text-slate-600 font-normal">chưa có</span>') + '</td>' +
                         '<td class="px-3 py-2 text-slate-400">' +
                           (x.ten_xe ? esc(x.ten_xe) : '<span class="text-slate-600">—</span>') + '</td>' +
                         '<td class="px-3 py-2 text-slate-400">Khối ' + esc(x.block_no) +
                           (x.zone_id ? ' <span class="text-slate-500 font-normal">(Z' + esc(x.zone_id) + ')</span>' : '') + '</td>' +
                         '<td class="px-3 py-2">' + ketQua + '</td>' +
                       '</tr>';
            }).join("");

            var dem = el("history-results-count");
            if (dem) {
                dem.textContent = d.items.length + " lượt tra cứu gần nhất · " +
                                  d.tim_thay + " thấy xe · " + d.khong_thay + " không thấy";
            }
        }

        // ------------------------------------------------- nguyen nhan loi
        function veLoi(d) {
            var body = el("bc-loi-body");
            var bd   = el("bc-loi-bieudo");

            if (!d.items.length) {
                bao("bc-loi-body", 5, "text-slate-500", "Chưa có cảnh báo nào được ghi nhận.");
                if (bd) bd.innerHTML = '<div class="col-span-full text-center text-slate-500 text-[11px] py-10">Chưa có cảnh báo nào.</div>';
                return;
            }

            if (body) {
                body.innerHTML = d.items.map(function (x) {
                    return '<tr class="border-b border-slate-850 hover:bg-slate-800/20">' +
                             '<td class="px-3 py-2 text-slate-300 font-bold">' + esc(x.ma_loi) + '</td>' +
                             '<td class="px-3 py-2 text-slate-400">' + esc(x.muc_do) + '</td>' +
                             '<td class="px-3 py-2 text-slate-300">' + esc(x.so_lan) + '</td>' +
                             '<td class="px-3 py-2 text-slate-400">' + esc(x.ti_le) + '%</td>' +
                             '<td class="px-3 py-2 text-slate-400">' + esc(x.luy_ke) + '%</td>' +
                           '</tr>';
                }).join("");
            }

            if (bd) {
                // Chieu cao theo TY LE so voi nguyen nhan nhieu nhat, khong phai
                // theo con so tuyet doi: 1 lan tren tong 2 van la 50% cua bai.
                var lonNhat = d.items[0].so_lan || 1;
                bd.innerHTML = d.items.slice(0, 6).map(function (x) {
                    var cao = Math.max(8, Math.round(x.so_lan / lonNhat * 120));
                    return '<div class="text-center space-y-2">' +
                             '<span class="text-[10px] font-mono text-slate-400">' +
                               esc(x.so_lan) + ' lần (' + esc(x.ti_le) + '%)</span>' +
                             '<div class="w-full bg-blue-600 rounded-t-md mx-auto" style="height:' +
                               cao + 'px; max-width:60px;"></div>' +
                             '<div class="text-[10px] font-bold text-slate-300 truncate" title="' +
                               esc(x.ma_loi) + '">' + esc(x.ma_loi) + '</div>' +
                           '</div>';
                }).join("");
            }
        }

        // ---------------------------------------------------------- poll
        function tick() {
            fetch(URL_LICHSU + "?limit=50", { cache: "no-store" })
                .then(function (r) {
                    if (!r.ok) throw new Error("HTTP " + r.status);
                    return r.json();
                })
                .then(function (d) {
                    if (d.error) throw new Error(d.error);
                    veLichSu(d);
                })
                // Xoa bang chu khong giu dong cu: mot bang lich su dung yen trong
                // y het mot bai xe khong co luot nao.
                .catch(function (e) {
                    bao("bc-lichsu-body", 6, "text-red-400",
                        "Không đọc được lịch sử: " + esc(e.message));
                    var dl = el("history-results-count");
                    if (dl) dl.textContent = "không đọc được";
                });

            fetch(URL_LOI, { cache: "no-store" })
                .then(function (r) {
                    if (!r.ok) throw new Error("HTTP " + r.status);
                    return r.json();
                })
                .then(function (d) {
                    if (d.error) throw new Error(d.error);
                    veLoi(d);
                })
                .catch(function (e) {
                    bao("bc-loi-body", 5, "text-red-400",
                        "Không đọc được thống kê lỗi: " + esc(e.message));
                    var bd = el("bc-loi-bieudo");
                    if (bd) bd.innerHTML = '<div class="col-span-full text-center text-red-400 text-[11px] py-10">Không đọc được.</div>';
                });
        }

        // Guard if (timer): thieu no thi moi lan visibilitychange bao hien ma
        // khong co lan an tuong ung se sinh them mot interval va mat handle cu.
        var timer = null;
        function batDau() { if (timer) return; tick(); timer = setInterval(tick, NHIP_MS); }

        document.addEventListener("visibilitychange", function () {
            if (document.hidden) { if (timer) { clearInterval(timer); timer = null; } }
            else batDau();
        });

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", batDau);
        } else {
            batDau();
        }
    })();
</script>


@* ===================== TAB MAT DO: DU LIEU THAT =====================
   Doc /BaoCao/XeVaoTheoThu va /BaoCao/PhanLoaiXe. *@
<script>
    (function () {
        "use strict";

        var URL_THU  = "@Url.Action("XeVaoTheoThu", "BaoCao")";
        var URL_LOAI = "@Url.Action("PhanLoaiXe", "BaoCao")";
        var URL_ZONE = "@Url.Action("DanhSachZone", "BaoCao")";
        var GACH     = "\u2014";

        function el(id) { return document.getElementById(id); }

        function esc(v) {
            return String(v === null || v === undefined ? "" : v)
                .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;");
        }

        // Xoa luon nhan tom tat. Thieu buoc nay thi khi API chet, o so lieu
        // bao do con nhan phia tren van dung o "dang doc..." mai mai — nguoi
        // dung tuong trang con dang tai chu khong phai da hong.
        function loi(id, nhan, e) {
            var k = el(id);
            if (k) {
                k.innerHTML = '<div class="text-red-400 text-[11px] text-center py-8">' +
                              'Không đọc được: ' + esc(e.message) + '</div>';
            }
            var n = el(nhan);
            if (n) n.textContent = GACH;

            // Ca nhan khoang ngay nua. taiTabMatDo() dat no thanh "dang doc..."
            // truoc khi goi, va chi veThu() moi ghi de — ma veThu() khong chay
            // khi loi. Thieu dong nay thi thanh loc dung yen o "dang doc..."
            // mai mai trong khi hai o ben duoi da bao do.
            var ts = el("loc-trangthai");
            if (ts) ts.textContent = "không đọc được";
        }

        // ---------------------------------------- xe vao theo thu
        function veThu(d) {
            var tt = el("md-tomtat");
            if (tt) tt.textContent = d.tong_xe + " xe";

            // Nhac lai khoang may chu THUC SU dung. Nguoi dung go mot ngay sai
            // dinh dang hoac chon nguoc thi may chu tu sua, va neu khong hien
            // lai thi ho tuong minh dang xem khoang minh vua go.
            var ts = el("loc-trangthai");
            if (ts) {
                ts.textContent = d.tu + " → " + d.den +
                                 (d.zone ? " · Zone " + d.zone : " · tất cả Zone");
            }

            var k = el("md-thu");
            if (!k) return;

            if (!d.items.length) {
                k.innerHTML = '<div class="text-slate-500 text-[11px] text-center py-8">' +
                              'Chưa có xe nào vào bãi trong ' + esc(d.so_ngay) + ' ngày qua.</div>';
                return;
            }

            // Xep lai T2..CN. MySQL tra ve CN = 1 nen theo thu tu goc thi Chu
            // Nhat nhay len dau bang, nguoc voi cach doc lich cua nguoi dung.
            var xep = d.items.slice().sort(function (a, b) {
                return (a.thu === 1 ? 8 : a.thu) - (b.thu === 1 ? 8 : b.thu);
            });

            k.innerHTML = xep.map(function (x) {
                // Chi to mau ngay dong nhat va vang nhat. To mau theo nguong co
                // dinh thi phai biet truoc bai nay "bao nhieu xe la dong", ma
                // con so do khong ai dinh nghia.
                var mau = x.phan_tram === 100 ? "text-amber-400"
                        : (x.phan_tram <= 45 ? "text-emerald-400" : "text-blue-400");
                // Mau dat bang style noi tuyen. scada.css khong co bg-blue-500
                // lan bg-emerald-500 (chi co bg-amber-500), nen dung lop thi hai
                // mau kia ra trong suot va thanh ngang bien mat — dung loi ma
                // ban cu mac phai: chi ngay Thu Bay to amber la nhin thay thanh.
                var nen = x.phan_tram === 100 ? "rgb(245,158,11)"
                        : (x.phan_tram <= 45 ? "rgb(16,185,129)" : "rgb(59,130,246)");
                return '<div title="' + esc(x.ten) + ': ' + x.tong_xe + ' xe trong ' +
                         x.so_ngay + ' ngày">' +
                         '<div class="flex justify-between text-xs mb-1 font-mono">' +
                           '<span class="text-slate-300">' + esc(x.ten) + '</span>' +
                           '<span class="' + mau + ' font-bold">' + x.trung_binh + ' xe/ngày</span>' +
                         '</div>' +
                         '<div class="h-2 bg-slate-800 rounded-full overflow-hidden">' +
                           '<div class="h-full rounded-full" style="width:' + x.phan_tram +
                             '%;background:' + nen + ';"></div>' +
                         '</div>' +
                       '</div>';
            }).join("");
        }

        // ---------------------------------------- phan loai xe
        function veLoai(d) {
            var tt = el("md-tuchoi");
            if (tt) {
                // Loc theo zone lam con so tu choi thieu di, vi phan lon xe bi
                // tu choi khong mang zone_id. Noi ro thay vi de con so tran.
                tt.textContent = d.tong + " xe · " + d.tong_tu_choi + " bị từ chối" +
                                 (d.tu_choi_thieu_khi_loc_zone ? " (chỉ tính xe có zone)" : "");
            }

            var k = el("md-loai");
            if (!k) return;

            if (!d.items.length) {
                k.innerHTML = '<div class="text-slate-500 text-[11px] text-center py-8">' +
                              'Chưa có xe nào được phân loại.</div>';
                return;
            }

            k.innerHTML = d.items.map(function (x) {
                var cao = (x.cao_min && x.cao_max)
                            ? (x.cao_min === x.cao_max ? x.cao_min + "mm"
                                                       : x.cao_min + GACH + x.cao_max + "mm")
                            : "chưa đo được";
                return '<div class="flex items-center justify-between p-2.5 bg-slate-800/20 rounded-lg border border-slate-800">' +
                         '<div class="min-w-0">' +
                           '<div class="text-xs font-semibold text-slate-300 truncate">' + esc(x.nhan) + '</div>' +
                           '<div class="text-[10px] text-slate-500 font-mono">cao ' + esc(cao) +
                             (x.so_tu_choi ? ' · <span class="text-rose-400">' + x.so_tu_choi +
                                             ' bị từ chối</span>' : '') + '</div>' +
                         '</div>' +
                         '<span class="font-mono text-xs font-bold text-slate-300 shrink-0 pl-3">' +
                           x.ti_le + '% (' + x.so_xe + ' xe)</span>' +
                       '</div>';
            }).join("");
        }

        // url da mang san chuoi tham so, khong ghep them "?ngay=30" nhu ban
        // truoc: ghep them dau ? thu hai se lam may chu bo qua ca cum.
        function tai(url, ve, id, nhan) {
            fetch(url, { cache: "no-store" })
                .then(function (r) {
                    if (!r.ok) throw new Error("HTTP " + r.status);
                    return r.json();
                })
                .then(function (d) {
                    if (d && d.error) throw new Error(d.error);
                    ve(d);
                })
                .catch(function (e) { loi(id, nhan, e); });
        }

        // ---------------------------------------- thanh loc
        function haiSo(n) { return (n < 10 ? "0" : "") + n; }

        function chuoiNgay(d) {
            // Tu ghep yyyy-MM-dd thay vi toISOString(): toISOString doi sang UTC
            // truoc, nen o mui gio +7 thi moi thoi diem truoc 07:00 se lui mot
            // ngay va nguoi dung thay khoang loc thieu mat hom nay.
            return d.getFullYear() + "-" + haiSo(d.getMonth() + 1) + "-" + haiSo(d.getDate());
        }

        window.datNgayMacDinh = function (idTu, idDen) {
            var den = new Date();
            var tu  = new Date();
            tu.setDate(tu.getDate() - 29);      // 30 ngay ke ca hom nay
            var a = el(idTu), b = el(idDen);
            if (a) a.value = chuoiNgay(tu);
            if (b) b.value = chuoiNgay(den);
        };

        function thamSo() {
            var tu   = el("loc-tu"),  den = el("loc-den"), z = el("loc-zone");
            var q    = [];
            if (tu  && tu.value)  q.push("tu="  + encodeURIComponent(tu.value));
            if (den && den.value) q.push("den=" + encodeURIComponent(den.value));
            if (z   && z.value)   q.push("zone=" + encodeURIComponent(z.value));
            return q.length ? "?" + q.join("&") : "";
        }

        // O chon phan khu truoc day liet ke Zone A den Zone D kem ten tang ham.
        // Bai that co sau zone, doc tu bang zone.
        function napZone() {
            fetch(URL_ZONE, { cache: "no-store" })
                .then(function (r) { return r.ok ? r.json() : null; })
                .then(function (d) {
                    var sel = el("loc-zone");
                    if (!sel || !d || !d.items) return;
                    d.items.forEach(function (z) {
                        var o = document.createElement("option");
                        o.value = z.zone_id;
                        o.textContent = z.ten + " (" + z.ma + ")";
                        sel.appendChild(o);
                    });
                })
                .catch(function () { /* thieu danh sach zone thi van loc duoc theo ngay */ });
        }

        window.taiTabMatDo = function () {
            var q = thamSo();
            var tt = el("loc-trangthai");
            if (tt) tt.textContent = "đang đọc…";
            tai(URL_THU  + q, veThu,  "md-thu",  "md-tomtat");
            tai(URL_LOAI + q, veLoai, "md-loai", "md-tuchoi");
        };

        function batDau() {
            datNgayMacDinh("loc-tu", "loc-den");
            datNgayMacDinh("history-date-from", "history-date-to");
            napZone();
            taiTabMatDo();
        }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", batDau);
        } else {
            batDau();
        }
    })();
</script>
