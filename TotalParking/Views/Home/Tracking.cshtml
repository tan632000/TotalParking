@{
    Layout = "~/Views/Shared/_ScadaLayout.cshtml";
}

<div class="p-6 pb-12 min-h-[calc(100vh-3.5rem)] text-slate-100" style="background: rgb(15, 23, 42); font-family: 'Inter', system-ui, -apple-system, sans-serif;">
    <div class="space-y-6">
        <!-- Header -->
        <div class="flex justify-between items-center pb-4 border-b border-slate-800">
            <div>
                <h1 class="text-2xl font-bold tracking-tight">Truy vết Xe &amp; Pallet (Vehicle Tracking)</h1>
                <p class="text-slate-400 text-sm mt-1">Giám sát vị trí thời gian thực và lịch sử dịch chuyển khay đỗ trong hệ thống cơ khí.</p>
            </div>
            <div class="flex gap-2">
                @* Nut "Dong bo" cu chi bat mot hop thoai noi dang doc du lieu
                   tu PLC, va khong gui gi ca. Trang nay doc du lieu ngay khi bam
                   Dinh vi, nen khong can nut dong bo rieng. *@
            </div>
        </div>

        <!-- Simulated Tracking Map / Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Left Column: Search & Quick Tracking -->
            <div class="bg-slate-900/50 rounded-xl border border-slate-800 p-5 shadow-xl space-y-4">
                <h3 class="text-white text-sm font-bold flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-500"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
                    Tìm kiếm Xe &amp; Định vị nhanh
                </h3>
                <div class="space-y-3">
                    <div>
                        <label class="text-slate-500 text-[10px] font-mono uppercase block mb-1">Biển số hoặc Mã thẻ xe</label>
                        <input type="text" id="trackInput" class="w-full bg-slate-800/60 border border-slate-700/50 rounded px-2.5 py-1.5 text-xs text-slate-200 font-mono outline-none focus:border-blue-500 transition-colors" placeholder="Ví dụ: 30F-123.45 hoặc CARD_01">
                    </div>
                    <button id="trackBtn" onclick="timXe()" class="w-full py-2 bg-blue-600 hover:bg-blue-500 text-white rounded text-xs font-semibold shadow transition-colors">
                        Định vị vị trí xe
                    </button>
                    <div id="trackResult" class="text-[11px] text-slate-500 font-mono">Nhập biển số hoặc mã thẻ rồi bấm Định vị.</div>
                </div>

                <div class="border-t border-slate-800 pt-4">
                    <h4 class="text-slate-400 text-xs font-semibold mb-2">Trạng thái kết nối RFID Gate</h4>
                    @* Hai dong nay truoc day ghi cung mot trang thai mau xanh cho ca hai
                       dau doc, khong ham nao cham toi. Khong co nguon du lieu nao
                       cho chung: thiet bi gan nhat trong /DeviceStatus/Summary la
                       nhom "dispenser" (May phat the), va chinh no bao
                       health = "unmonitored", detail = "Chua dau noi vao SCADA".
                       Mot den trang thai luon xanh la loai du lieu gia nguy hiem
                       nhat — nguoi van hanh doc den truoc khi doc chu. *@
                    <div class="space-y-2 text-[11px] font-mono">
                        <div class="flex justify-between">
                            <span class="text-slate-500">Đầu đọc Cổng vào (In-Gate):</span>
                            <span class="text-slate-500">● chưa giám sát</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-slate-500">Đầu đọc Cổng ra (Out-Gate):</span>
                            <span class="text-slate-500">● chưa giám sát</span>
                        </div>
                    </div>
                    <p class="text-[10px] text-slate-600 mt-2 leading-relaxed">Đầu đọc RFID chưa đấu nối vào SCADA nên hệ thống không quan sát được trạng thái của chúng.</p>
                </div>
            </div>

            <!-- Right Column: Visual Timeline & Pallet Path Tracking -->
            <div class="lg:col-span-2 bg-slate-900/50 rounded-xl border border-slate-800 p-5 shadow-xl space-y-4">
                <h3 class="text-white text-sm font-bold flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-500"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                    Quy trình gửi xe (mô tả các bước)
                </h3>
                
                <div class="border border-slate-800 rounded-lg p-6 bg-slate-950/20">
                    <div class="relative pl-6 border-l-2 border-slate-700 space-y-6">
                        <!-- Step 1 -->
                        <div class="relative">
                            <div class="absolute -left-[31px] top-0.5 w-4.5 h-4.5 rounded-full border-2 border-blue-500 bg-slate-900 flex items-center justify-center">
                                <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
                            </div>
                            <div>
                                <h4 class="text-blue-400 text-xs font-bold font-mono">STEP 1: Quét RFID &amp; Phân loại cổng vào</h4>
                                <p class="text-slate-400 text-[10px] mt-0.5">Xe được phát hiện tại Cổng 1, chụp ảnh LPR biển số và gán khay đỗ an toàn.</p>
                            </div>
                        </div>

                        <!-- Step 2 -->
                        <div class="relative">
                            <div class="absolute -left-[31px] top-0.5 w-4.5 h-4.5 rounded-full border-2 border-emerald-500 bg-slate-900 flex items-center justify-center">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                            </div>
                            <div>
                                <h4 class="text-emerald-400 text-xs font-bold font-mono">STEP 2: Bàn nâng nhận khay đỗ (Lift Received)</h4>
                                <p class="text-slate-400 text-[10px] mt-0.5">Xác nhận cảm biến tải trọng khay đỗ, motor phanh nhả và bàn nâng di chuyển.</p>
                            </div>
                        </div>

                        <!-- Step 3 -->
                        <div class="relative">
                            <div class="absolute -left-[31px] top-0.5 w-4.5 h-4.5 rounded-full border-2 border-slate-700 bg-slate-900 flex items-center justify-center">
                                <span class="w-1.5 h-1.5 rounded-full bg-slate-700"></span>
                            </div>
                            <div>
                                <h4 class="text-slate-500 text-xs font-bold font-mono">STEP 3: Xếp khay vào ô đỗ chỉ định</h4>
                                <p class="text-slate-500 text-[10px] mt-0.5">Di chuyển ngang Pallet bằng cơ cấu Slide Runner của block Puzzle.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* Truoc dot nay trang Truy vet khong goi may chu lan nao. O tim chi hien mot
   hop thoai, va hai den RFID luon xanh. Gio o tim goi /VehicleFinder/Find —
   API do vua duoc sua de doc plc_slot_state thay vi bang parking_session rong,
   nen no tra loi duoc that. *@
<script>
    (function () {
        "use strict";

        var URL_FIND = "@Url.Action("Find", "VehicleFinder")";

        function esc(v) {
            return String(v === null || v === undefined ? "" : v)
                .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;");
        }

        function dat(html) {
            var e = document.getElementById("trackResult");
            if (e) e.innerHTML = html;
        }

        function hop(mau, tieuDe, than) {
            return '<div class="mt-1 p-2.5 rounded border border-slate-800 bg-slate-900/60">' +
                     '<div class="' + mau + ' text-[11px] font-bold mb-1">' + tieuDe + '</div>' +
                     '<div class="text-[10px] text-slate-400 leading-relaxed">' + than + '</div>' +
                   '</div>';
        }

        window.timXe = function () {
            var o = document.getElementById("trackInput");
            var q = o ? o.value.trim() : "";
            if (!q) { dat('<span class="text-amber-400">Chưa nhập biển số hoặc mã thẻ.</span>'); return; }

            dat('<span class="text-slate-500">Đang tra…</span>');

            fetch(URL_FIND + "?q=" + encodeURIComponent(q), { cache: "no-store" })
                .then(function (r) { return r.json().then(function (j) { return { ma: r.status, than: j }; }); })
                .then(function (kq) {
                    var d = kq.than || {};
                    if (d.outcome === "card_unknown") {
                        dat(hop("text-amber-400", 'Không tìm thấy "' + esc(q) + '"',
                                esc(d.message || "")));
                        return;
                    }
                    if (d.outcome === "no_session") {
                        dat(hop("text-amber-400", "Thẻ hợp lệ nhưng không thấy xe",
                                "Vòng quét PLC không thấy mã thẻ này ở ô đỗ nào. " +
                                "Xe đã ra khỏi bãi, hoặc thanh ghi chưa kịp cập nhật."));
                        return;
                    }
                    if (d.outcome === "db_error" || kq.ma >= 500) {
                        dat(hop("text-red-400", "Lỗi cơ sở dữ liệu", esc(d.message || "")));
                        return;
                    }
                    if (d.outcome !== "found" || !d.results || !d.results.length) {
                        dat(hop("text-amber-400", "Không có kết quả", esc(d.message || "")));
                        return;
                    }

                    // Mot ma the nam o nhieu khoi la chuyen co that va CanhBaoTheTrungService
                    // da sinh canh bao cho no. Hien ca danh sach chu khong chon dai mot
                    // cai: nguoi truc di kiem tra duoc, con chon sai thi ho di nham tang.
                    var nhieu = d.results.length > 1;
                    var than = d.results.map(function (v) {
                        return '<div class="py-1 border-t border-slate-850 first:border-t-0">' +
                                 '<div class="text-slate-200 font-mono">' +
                                   'Khối ' + esc(v.block_no) + ' · ' + esc(v.slot_label) + '</div>' +
                                 '<div class="text-slate-500">' +
                                   (v.zone_id ? 'Zone ' + esc(v.zone_id) : 'chưa phân zone') +
                                   ' · ' + esc(v.plate || v.card_no || v.card_code) +
                                   ' · ' + esc(v.duration) + '</div>' +
                               '</div>';
                    }).join("");

                    dat(hop("text-emerald-400",
                            nhieu ? "Thấy ở " + d.results.length + " vị trí — cần kiểm tra"
                                  : "Đang trong bãi",
                            than));
                })
                .catch(function (e) {
                    // Khong doc duoc thi noi that. Tra "khong tim thay" luc khong tra
                    // duoc la noi doi nguoi dang di tim xe.
                    dat(hop("text-red-400", "Không tra được", esc(e.message)));
                });
        };

        var o = document.getElementById("trackInput");
        if (o) {
            o.addEventListener("keydown", function (e) {
                if (e.key === "Enter") window.timXe();
            });
        }
    })();
</script>
