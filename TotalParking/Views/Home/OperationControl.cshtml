@{
    ViewBag.Title = "Trung tâm Điều khiển Vận hành (OCC)";
    Layout = "~/Views/Shared/_ScadaLayout.cshtml";
    var currentAction = "operationcontrol";
}

<!-- Custom Styles for OCC SCADA Dashboard -->
<style>
    /* Custom SCADA styling */
    .occ-container {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    
    .glowing-led {
        box-shadow: 0 0 12px currentColor;
    }
    
    .status-pulse {
        animation: pulse-ring 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }

    @@keyframes pulse-ring {
        0%, 100% {
            opacity: 1;
            transform: scale(1);
        }
        50% {
            opacity: .6;
            transform: scale(1.05);
        }
    }

    .alarm-flash {
        animation: alarm-flashing 1.2s infinite;
    }

    @@keyframes alarm-flashing {
        0%, 100% {
            background-color: rgba(239, 68, 68, 0.1);
            border-color: rgba(239, 68, 68, 0.5);
            box-shadow: 0 0 5px rgba(239, 68, 68, 0.1);
        }
        50% {
            background-color: rgba(239, 68, 68, 0.25);
            border-color: rgba(239, 68, 68, 0.9);
            box-shadow: 0 0 15px rgba(239, 68, 68, 0.4);
        }
    }

    /* SCADA dark themes */
    .bg-dark-panel {
        background: rgba(13, 27, 46, 0.95);
        border: 1px solid rgba(51, 65, 85, 0.5);
    }

    .bg-dark-card {
        background: rgba(30, 41, 59, 0.7);
        border: 1px solid rgba(71, 85, 105, 0.3);
    }
</style>

<div class="occ-container p-6 text-slate-100 min-h-screen pb-16">
    <!-- Header Area -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6 pb-5 border-b border-slate-700/50">
        <div>
            <div class="flex items-center gap-3">
                <div class="p-2 bg-blue-600/10 rounded border border-blue-500/30">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sliders text-blue-400"><line x1="4" x2="20" y1="21" y2="21"></line><line x1="4" x2="20" y1="14" y2="14"></line><line x1="4" x2="20" y1="7" y2="7"></line><line x1="9" x2="9" y1="18" y2="24"></line><line x1="15" x2="15" y1="11" y2="17"></line><line x1="10" x2="10" y1="4" y2="10"></line></svg>
                </div>
                <div>
                    <h1 class="text-xl font-bold tracking-tight text-slate-100 uppercase">Điều khiển vận hành</h1>
                    <p class="text-xs text-slate-400">Trung tâm điều khiển tập trung, giám sát lệnh PLC & điều phối khay đỗ</p>
                </div>
            </div>
        </div>
        <div class="flex items-center gap-3 self-stretch md:self-auto">
            <div class="flex items-center gap-2 bg-slate-900/60 border border-slate-800 rounded px-3 py-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-500 glowing-led text-emerald-500"></span>
                <span class="text-xs font-mono text-slate-300">PLC Link: OK</span>
            </div>
            <div class="flex items-center gap-2 bg-slate-900/60 border border-slate-800 rounded px-3 py-1.5">
                <span class="w-2 h-2 rounded-full bg-blue-500 glowing-led text-blue-500"></span>
                <span class="text-xs font-mono text-slate-300">Phiên vận hành</span>
            </div>
        </div>
    </div>

    <!-- Filters Area -->
    <div class="flex flex-wrap items-center gap-4 p-4 bg-slate-900/40 rounded-xl border border-slate-800/80 mb-6">
        <div class="flex items-center gap-2">
            <label class="text-xs text-slate-400 font-semibold uppercase tracking-wider">Phân khu (Zone):</label>
            <select id="occ-zone-select" onchange="onZoneChanged()" class="bg-slate-800 border border-slate-700/60 rounded px-3 py-1 text-xs text-slate-200 focus:outline-none focus:border-blue-500">
                <option value="1">Zone 1 (Hầm B1 CL1)</option>
                <option value="2">Zone 2 (Hầm B2 CL1)</option>
                <option value="3">Zone 3 (Hầm B3 CL1)</option>
                <option value="4">Zone 4 (Hầm B4 CL1)</option>
                <option value="5">Zone 5 (Hầm B5 CL1)</option>
                <option value="6">Zone 6 (Hầm B6 CL1)</option>
            </select>
        </div>
        <div class="flex items-center gap-2">
            <label class="text-xs text-slate-400 font-semibold uppercase tracking-wider">Chọn Block:</label>
            <select id="occ-block-select" onchange="onBlockDropdownChanged()" class="bg-slate-800 border border-slate-700/60 rounded px-3 py-1 text-xs text-slate-200 focus:outline-none focus:border-blue-500">
                <!-- Dynamically populated -->
            </select>
        </div>
    </div>

    <!-- Main Workspace Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        <!-- Left Side: Blocks Grid Panel -->
        <div>
            <!-- Truoc day cho nay la hai tab: "Ban do van hanh" va "Sequence
                 View". Tab thu hai chi dien hoat canh 9 buoc gui/lay xe cho cac
                 nut dieu phoi da bi go o dot nay, va trang thai rong cua no con
                 huong dan nguoi dung bam dung nhung nut do. -->
            <div class="px-5 py-3 border-b border-slate-800">
                <span class="text-xs font-bold uppercase tracking-wider text-blue-400">Bản đồ vận hành</span>
            </div>
            <!-- Content Tab A: Map View -->
            <div id="left-tab-content-map" class="space-y-6">
                <div class="bg-dark-panel rounded-xl p-5 shadow-xl">
                    <div class="flex justify-between items-center mb-4">
                        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400 flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-grid text-slate-400"><rect width="7" height="7" x="3" y="3" rx="1"></rect><rect width="7" height="7" x="14" y="3" rx="1"></rect><rect width="7" height="7" x="14" y="14" rx="1"></rect><rect width="7" height="7" x="3" y="14" rx="1"></rect></svg>
                            Danh Sách Block - Zone <span id="block-grid-zone-num">1</span>
                        </h2>
                        <span id="occ-grid-nhan" class="text-[10px] font-mono bg-slate-800 text-slate-400 px-2 py-0.5 rounded border border-slate-750">đang đọc…</span>
                    </div>
                @* Thanh so lieu THAT tu vong poll PLC. Truoc day luoi block ben
                   duoi la mo phong (doc occBlockStates trong localStorage) nen
                   thanh nay phai tach rieng de khong lan hai loai du lieu.
                   Tu dot go nut dieu khien, ca hai deu la du lieu that. *@
                    <div class="mb-4 p-3 rounded-lg bg-slate-950/60 border border-slate-800">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-400">
                                Số liệu thật từ PLC
                            </span>
                            <span id="occ-status" class="text-[10px] font-mono text-slate-500">đang tải…</span>
                        </div>
                        <div class="grid grid-cols-3 gap-3">
                            <div>
                                @* "đọc được dữ liệu" chứ không phải "online": đây là
                                   bắt tay FINS thật, khác hẳn dò TCP của DeviceStatus.
                                   Xem plan.md mục Từ vựng hiển thị. *@
                                <div class="text-[10px] text-slate-500">Block đọc được dữ liệu</div>
                                <div id="occ-block-doc-duoc" class="text-lg font-bold text-slate-100 font-mono">—</div>
                            </div>
                            <div>
                                @* PLC sống trên mạng nhưng is_active = 0 nên không nằm
                                   trong vòng poll. Bỏ qua nhóm này sẽ khiến kỹ thuật
                                   viên vừa đấu nối một block, không thấy nó, và kết
                                   luận nhầm là hỏng phần cứng. *@
                                <div class="text-[10px] text-slate-500">Chờ kích hoạt</div>
                                <div id="occ-block-cho-kich-hoat" class="text-lg font-bold text-amber-400 font-mono">—</div>
                            </div>
                            <div>
                                <div class="text-[10px] text-slate-500">Ô đang có xe</div>
                                <div id="occ-o-co-xe" class="text-lg font-bold text-slate-100 font-mono">—</div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Blocks Summary Grid -->
                    <div id="occ-blocks-grid" class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <!-- Cards will be populated dynamically -->
                    </div>
                </div>

                <!-- Storing / Occupancy Visual Grid of Selected Block -->
                <div class="bg-dark-panel rounded-xl p-5 shadow-xl">
                    <div class="flex justify-between items-center mb-4">
                        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400 flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-layout-grid text-slate-400"><rect width="7" height="7" x="3" y="3" rx="1"></rect><rect width="7" height="7" x="14" y="3" rx="1"></rect><rect width="7" height="7" x="14" y="14" rx="1"></rect><rect width="7" height="7" x="3" y="14" rx="1"></rect></svg>
                            Sơ Đồ Khay Đỗ Cơ Khí (Pallet Grid) - <span id="pallet-grid-block-title" class="text-blue-400">chưa chọn khối</span>
                        </h2>
                        <span class="text-[10px] font-mono text-slate-400">Tổng số: 12 khay</span>
                    </div>

                    <!-- Pallet Matrix (3x4 Layout) -->
                    <div id="occ-pallet-matrix" class="grid grid-cols-4 gap-3 bg-slate-950/40 p-4 rounded-lg border border-slate-800/80">
                        <!-- Populated dynamically -->
                    </div>

                    <div class="flex flex-wrap gap-4 mt-4 justify-center text-[10px] font-medium text-slate-400">
                        <div class="flex items-center gap-3"><div class="flex items-center gap-1.5"><span class="w-3 h-3 rounded inline-block" style="background-color: rgba(37, 99, 235, 0.15); border: 1px solid rgba(37, 99, 235, 0.45);"></span><span class="text-[10px] text-slate-400">Có xe</span></div><div class="flex items-center gap-1.5"><span class="w-3 h-3 rounded inline-block" style="background-color: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.45);"></span><span class="text-[10px] text-slate-400">Thẻ lạ</span></div><div class="flex items-center gap-1.5"><span class="w-3 h-3 rounded inline-block" style="background-color: rgba(15, 23, 42, 0.6); border: 1px solid rgba(51, 65, 85, 0.8);"></span><span class="text-[10px] text-slate-400">Trống</span></div></div>
                </div>
            </div>

        </div>

        <!-- Right Side: Detailed Control Cockpit Panel -->
        <div class="space-y-6">
            
            <!-- Block Status Cockpit -->
            <div class="bg-dark-panel rounded-xl p-5 shadow-xl border-l-4 border-blue-500" id="cockpit-panel">

            <!-- Bang nay gio CHI hien trang thai doc duoc tu may chu. Hai huy
                 hieu cu ("AUTO", "Mo khoa") la trang thai do nguoi dung tu dat
                 trong localStorage, khong phai che do that cua PLC. -->
            <div class="flex items-center justify-between mb-4">
                <div>
                    <h2 id="occ-panel-title" class="text-sm font-bold text-white">Khối —</h2>
                    <div class="flex items-center gap-2 mt-1">
                        <span id="occ-panel-conn" class="text-[10px] font-bold px-2 py-0.5 rounded border" style="border-color:rgba(100,116,139,.4);background:rgba(100,116,139,.1);color:rgb(148,163,184);">đang đọc…</span>
                    </div>
                </div>
            </div>



                <!-- Nut BAO SU CO la nut DUY NHAT tren trang nay cham toi may
                     chu (POST /Alarm/SuCoKhan). Moi nut dieu khien khac da bi go
                     o dot nay vi chung chi doi bien trong trinh duyet roi bao la
                     da gui lenh xuong PLC. Xu ly PLC that van phai co nguoi xuong
                     hien truong; duong ghi xuong thiet bi chi phuc vu luong tim xe. -->
                <div class="mb-4">
                    <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block mb-2">Ghi nhận sự cố</label>
                    <button id="btn-bao-su-co" onclick="baoSuCoKhan()" title="Chỉ ghi nhận sự cố để các máy khác thấy. Hệ thống không gửi lệnh dừng xuống thiết bị." class="w-full text-[11px] font-bold py-2.5 rounded transition-all border bg-red-950/20 border-red-900/30 text-red-400 hover:bg-red-900/20">BÁO SỰ CỐ</button>
                    <p class="text-[10px] text-slate-500 mt-2 leading-relaxed">Chỉ ghi nhận để các máy khác thấy. Muốn dừng thiết bị phải dùng nút cơ khí ngoài hiện trường.</p>
                </div>




            </div>
        </div>

    </div>
</div>



<!-- JavaScript State Engine & Actions -->
<script>
    // Constants mapping Zone to its Blocks list
    // ===================== DU LIEU THAT =====================
    // Truoc day trang nay chay tren mot "co so du lieu mo phong": 18 ten khoi
    // bia cho mot bai co 118 khoi, va cung 5 bien so duoc gieo vao MOI khoi.
    // Chung song trong localStorage (occBlockStates, occPalletOccupancy) chu
    // khong den tu may chu lan nao.
    //
    // Gio: danh sach khoi tu /Monitor/BlockMap, o do tu /SlotStatus.
    var URL_BLOCKMAP = "@Url.Action("BlockMap", "Monitor")";
    var URL_SLOT     = "@Url.Action("Index", "SlotStatus")";
    var NHIP_KHOI_MS = 15000;

    var khoiTheoSo   = {};     // block_no -> ban ghi tu BlockMap
    var khoiTheoZone = {};     // zone_id  -> [block_no]
    var khoiDangChon = null;

    // HOP DONG LIEN TRANG (AGENTS.md muc 2): khoa activeAlarms duoc Index,
    // Diagnostics va Safety cung doc. Safety dung chuoi chua "E-Stop" trong
    // day de dung ma tran khoa lien dong, nen ban ghi su co khan PHAI tiep tuc
    // duoc ghi vao khoa nay du moi nut dieu khien khac da bi go.
    var activeAlarms = [];
    try {
        var thoAlarms = localStorage.getItem("activeAlarms");
        if (thoAlarms) activeAlarms = JSON.parse(thoAlarms) || [];
    } catch (e) {
        activeAlarms = [];
    }

    function saveActiveAlarms() {
        localStorage.setItem("activeAlarms", JSON.stringify(activeAlarms));
    }

    function escO(v) {
        return String(v === null || v === undefined ? "" : v)
            .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;");
    }

    function zoneDangXem() {
        var e = document.getElementById("occ-zone-select");
        return e ? parseInt(e.value, 10) : 1;
    }

    // ------------------------------------------------------- danh sach khoi
    function veDanhSachKhoi() {
        var zone = zoneDangXem();
        var ds = (khoiTheoZone[zone] || []).map(function (n) { return khoiTheoSo[n]; });

        var nhanZone = document.getElementById("block-grid-zone-num");
        if (nhanZone) nhanZone.textContent = zone;

        var mat = ds.filter(function (b) { return !b.online; }).length;
        var nhan = document.getElementById("occ-grid-nhan");
        if (nhan) {
            nhan.textContent = ds.length === 0 ? "zone này chưa có khối nào"
                : (mat ? mat + "/" + ds.length + " khối mất kết nối"
                       : ds.length + " khối, tất cả đang đọc được");
        }

        var grid = document.getElementById("occ-blocks-grid");
        if (!grid) return;
        if (ds.length === 0) {
            grid.innerHTML = '<div class="col-span-full text-center text-slate-500 text-xs py-6">' +
                             'Zone này chưa có khối nào trong cơ sở dữ liệu.</div>';
            return;
        }

        grid.innerHTML = ds.map(function (b) {
            var chon = b.block_no === khoiDangChon;
            // Mat ket noi KHAC voi trong: so o cua mot khoi khong doc duoc la so
            // doc duoc LAN CUOI, khong phai hien trang.
            var vien = chon ? "rgb(59,130,246)"
                            : (b.online ? "rgba(34,197,94,.35)" : "rgba(220,38,38,.45)");
            var cham = b.online ? "rgb(34,197,94)" : "rgb(220,38,38)";
            // Dau su co lay tu MAY CHU chu khong tu localStorage: mot dau chi co
            // o mot trinh duyet la thu tao cam giac "da xu ly" sai lech.
            if (suCoKhanDangMo.has("Khối " + b.block_no)) vien = "rgb(239,68,68)";
            return '<button type="button" onclick="chonKhoi(' + b.block_no + ')" ' +
                   'class="text-left rounded-lg p-2.5 transition-all hover:border-slate-500" ' +
                   'style="background:rgb(15,23,42);border:1px solid ' + vien + ';">' +
                     '<div class="flex items-center justify-between mb-1">' +
                       '<span class="text-[11px] font-bold text-white">Khối ' + b.block_no + '</span>' +
                       '<span class="w-2 h-2 rounded-full" style="background:' + cham + ';"></span>' +
                     '</div>' +
                     '<div class="text-[10px] font-mono text-slate-400">' +
                       (b.occupied || 0) + '/' + (b.slots || 0) + ' ô có xe</div>' +
                   '</button>';
        }).join("");
    }

    // Dropdown khoi phai sinh tu du lieu that, khong phai tu danh sach viet cung.
    function dungDropdownKhoi() {
        var sel = document.getElementById("occ-block-select");
        if (!sel) return;
        var zone = zoneDangXem();
        var ds = khoiTheoZone[zone] || [];
        sel.innerHTML = ds.length === 0
            ? '<option value="">(chưa có khối)</option>'
            : ds.map(function (n) {
                  return '<option value="' + n + '">Khối ' + n + '</option>';
              }).join("");
        if (ds.length && ds.indexOf(khoiDangChon) < 0) khoiDangChon = ds[0];
        if (khoiDangChon !== null) sel.value = String(khoiDangChon);
    }

    function onZoneChanged() {
        khoiDangChon = null;
        dungDropdownKhoi();
        veDanhSachKhoi();
        if (khoiDangChon !== null) chonKhoi(khoiDangChon);
        else veODo(null);
    }

    function onBlockDropdownChanged() {
        var sel = document.getElementById("occ-block-select");
        if (sel && sel.value) chonKhoi(parseInt(sel.value, 10));
    }

    // ------------------------------------------------------------ mot khoi
    function chonKhoi(blockNo) {
        khoiDangChon = blockNo;
        var b = khoiTheoSo[blockNo] || {};

        var sel = document.getElementById("occ-block-select");
        if (sel) sel.value = String(blockNo);

        var tieuDe = document.getElementById("occ-panel-title");
        if (tieuDe) tieuDe.textContent = "Khối " + blockNo;

        var nhanKN = document.getElementById("occ-panel-conn");
        if (nhanKN) {
            nhanKN.textContent = b.online ? "Đang đọc được" : "Mất kết nối";
            nhanKN.style.cssText = b.online
                ? "border-color:rgba(34,197,94,.4);background:rgba(34,197,94,.1);color:rgb(74,222,128);"
                : "border-color:rgba(220,38,38,.4);background:rgba(220,38,38,.1);color:rgb(248,113,113);";
        }

        var tieuDeO = document.getElementById("pallet-grid-block-title");
        if (tieuDeO) tieuDeO.textContent = "Khối " + blockNo;

        veDanhSachKhoi();

        var luoi = document.getElementById("occ-pallet-matrix");
        if (luoi) luoi.innerHTML = '<div class="col-span-full text-slate-500 text-xs">Đang đọc ô đỗ…</div>';

        fetch(URL_SLOT + "?block=" + blockNo, { cache: "no-store" })
            .then(function (r) {
                if (!r.ok) throw new Error("HTTP " + r.status);
                return r.json();
            })
            .then(function (d) {
                if (blockNo !== khoiDangChon) return;   // nguoi dung da doi khoi
                if (d && d.error) throw new Error(d.error);
                if (!d || !Array.isArray(d.slots)) throw new Error("thiếu dữ liệu");
                veODo(d.slots);
            })
            .catch(function (e) {
                if (blockNo !== khoiDangChon) return;
                if (luoi) {
                    luoi.innerHTML = '<div class="col-span-full text-red-400 text-xs">' +
                                     'Không đọc được ô đỗ: ' + escO(e.message) + '</div>';
                }
            });
    }

    // ------------------------------------------------------------- o do
    function veODo(slots) {
        var luoi = document.getElementById("occ-pallet-matrix");
        if (!luoi) return;
        if (!slots) {
            luoi.innerHTML = '<div class="col-span-full text-slate-500 text-xs">Chưa chọn khối.</div>';
            return;
        }

        luoi.innerHTML = slots.map(function (o) {
            var nen, vien, noiDung;
            if (o.suspect) {
                // Co ma the trong thanh ghi nhung ma do khong co trong danh muc:
                // co xe that nhung the chua dang ky, hoac giai ma sai. Khong duoc
                // gop vao "trong".
                nen = "rgba(245,158,11,.15)"; vien = "rgba(245,158,11,.45)";
                noiDung = '<div class="text-[9px] font-bold" style="color:rgb(251,191,36);">Thẻ lạ</div>' +
                          '<div class="text-[9px] font-mono text-slate-300">' + escO(o.card_code) + '</div>';
            } else if (o.occupied) {
                // Chi 128/613 the co bien so, nhung ca 613 deu co so the.
                var chinh = o.plate || o.card_no || o.card_code;
                nen = "rgba(37,99,235,.15)"; vien = "rgba(37,99,235,.45)";
                noiDung = '<div class="text-[10px] font-bold text-white font-mono">' + escO(chinh) + '</div>' +
                          (o.plate ? "" : '<div class="text-[9px] text-slate-500">chưa có biển số</div>');
            } else {
                nen = "rgba(15,23,42,.6)"; vien = "rgba(51,65,85,.8)";
                noiDung = '<div class="text-[10px] text-slate-600">trống</div>';
            }
            return '<div class="rounded p-2" style="background:' + nen + ';border:1px solid ' + vien + ';">' +
                     '<div class="flex items-center justify-between mb-1">' +
                       '<span class="text-[9px] font-bold text-slate-300">Ô ' +
                         (o.slot < 10 ? "0" + o.slot : o.slot) + '</span>' +
                       '<span class="text-[9px] font-mono text-slate-600">' + escO(o.register) + '</span>' +
                     '</div>' + noiDung +
                   '</div>';
        }).join("");
    }

    // ---------------------------------------------------------------- poll
    function taiKhoi() {
        return fetch(URL_BLOCKMAP, { cache: "no-store" })
            .then(function (r) {
                if (!r.ok) throw new Error("HTTP " + r.status);
                return r.json();
            })
            .then(function (d) {
                if (d && d.error) throw new Error(d.error);
                if (!d || !Array.isArray(d.blocks)) throw new Error("thiếu dữ liệu");
                khoiTheoSo = {};
                khoiTheoZone = {};
                d.blocks.slice().sort(function (a, b) { return a.block_no - b.block_no; })
                    .forEach(function (b) {
                        khoiTheoSo[b.block_no] = b;
                        (khoiTheoZone[b.zone_id] = khoiTheoZone[b.zone_id] || []).push(b.block_no);
                    });

                var dauTien = khoiDangChon === null;
                dungDropdownKhoi();
                veDanhSachKhoi();
                if (dauTien && khoiDangChon !== null) chonKhoi(khoiDangChon);
            })
            .catch(function (e) {
                // Xoa so chu khong giu lai: so cu trong y het so dung.
                var grid = document.getElementById("occ-blocks-grid");
                if (grid) {
                    grid.innerHTML = '<div class="col-span-full text-center text-red-400 text-xs py-6">' +
                                     'Không đọc được danh sách khối: ' + escO(e.message) + '</div>';
                }
                var nhan = document.getElementById("occ-grid-nhan");
                if (nhan) nhan.textContent = "mất kết nối máy chủ";
            });
    }

    // Guard if (timer): thieu no thi moi lan visibilitychange bao hien ma khong
    // co lan an tuong ung se sinh them mot interval va mat handle cu.
    var timerKhoi = null;

    function batDauKhoi() {
        if (timerKhoi) return;
        taiKhoi();
        timerKhoi = setInterval(taiKhoi, NHIP_KHOI_MS);
    }

    document.addEventListener("visibilitychange", function () {
        if (document.hidden) {
            if (timerKhoi) { clearInterval(timerKhoi); timerKhoi = null; }
        } else {
            batDauKhoi();
        }
    });

    var API_ALARM_LIST = "@Url.Action("List", "Alarm")";
    var API_SU_CO_KHAN = "@Url.Action("SuCoKhan", "Alarm")";
    var MA_SU_CO_KHAN  = "SU-CO-KHAN";
    var NHIP_SU_CO_MS  = 15000;

    // Ten khoi (nhu hien tren man hinh) dang co su co chua ai xac nhan.
    let suCoKhanDangMo = new Set();

    // Guard if (timer): thieu no thi moi lan visibilitychange bao hien ma khong
    // co lan an tuong ung se sinh them mot interval va mat handle cu.
    var timerSuCo = null;

    function batDauSuCo() {
        if (timerSuCo) return;
        taiSuCoKhan();
        timerSuCo = setInterval(taiSuCoKhan, NHIP_SU_CO_MS);
    }

    document.addEventListener("visibilitychange", function () {
        if (document.hidden) {
            if (timerSuCo) { clearInterval(timerSuCo); timerSuCo = null; }
        } else {
            batDauSuCo();
        }
    });

    function taiSuCoKhan() {
        return fetch(API_ALARM_LIST, { cache: "no-store" })
            .then(function (r) {
                if (!r.ok) throw new Error("HTTP " + r.status);
                return r.json();
            })
            .then(function (d) {
                const moi = new Set();
                (d.canh_bao || []).forEach(function (c) {
                    if (c.ma_loi === MA_SU_CO_KHAN && c.chua_xac_nhan && c.thiet_bi)
                        moi.add(c.thiet_bi);
                });
                suCoKhanDangMo = moi;
                veDanhSachKhoi();
                capNhatNutSuCo();
            })
            .catch(function () {
                // Giu nguyen tap cu khi khong goi duoc may chu. Xoa dau su co vi
                // mat mang thi nguy hiem hon la de no hien thua mot lat.
            });
    }

    // Nut doi hinh dang theo du lieu MAY CHU, khong theo occBlockStates.
    function capNhatNutSuCo() {
        const nut = document.getElementById('btn-bao-su-co');
        if (!nut) return;
        const dangBao = suCoKhanDangMo.has("Khối " + khoiDangChon);
        nut.innerText = dangBao ? "ĐÃ BÁO SỰ CỐ" : "BÁO SỰ CỐ";
        nut.className = "text-[10px] font-bold py-2 rounded transition-all border " +
            (dangBao ? "bg-red-600 border-red-500 text-white status-pulse"
                     : "bg-red-950/20 border-red-900/30 text-red-400 hover:bg-red-900/20");
    }

    // Ghi nhan mot su co khan. KHONG dung may — nhan va hop xac nhan deu phai noi
    // ro dieu do, neu khong thi viec ghi duoc CSDL con lam te hon nut cu: no tao
    // cam giac he thong vua "nhan lenh".
    function baoSuCoKhan() {
        const khoi = khoiDangChon === null ? null : "Khối " + khoiDangChon;
        if (khoi === null) { alert("Chưa chọn khối nào."); return; }
        if (!confirm("Ghi nhận sự cố khẩn tại " + khoi + "?\n\n" +
                     "Thao tác này CHỈ ghi nhận để người khác thấy. " +
                     "Hệ thống KHÔNG gửi lệnh dừng nào xuống thiết bị. " +
                     "Việc dừng máy khẩn cấp phải dùng nút cơ khí tại chỗ.")) return;

        const zoneId = document.getElementById('occ-zone-select').value;
        const than = new URLSearchParams();
        than.append("khoi", khoi);
        than.append("zoneId", zoneId);

        fetch(API_SU_CO_KHAN, { method: "POST", body: than })
            .then(function (r) {
                return r.json().then(function (d) { return { ok: r.ok, d: d }; });
            })
            .then(function (kq) {
                if (!kq.ok) {
                    alert("Không ghi được sự cố: " + (kq.d && kq.d.error ? kq.d.error : "lỗi máy chủ"));
                    return;
                }

                // VAN ghi activeAlarms voi chuoi chua "E-Stop". Safety.cshtml do
                // dung chuoi do de dung dong khoa lien dong trong ma tran an toan;
                // bo di thi ma tran do se mai bao OK. Dung go neu chua sua Safety.
                activeAlarms.unshift({
                    id: "ALM-" + kq.d.id,
                    time: new Date().toTimeString().split(' ')[0],
                    code: MA_SU_CO_KHAN,
                    type: 1,
                    typeName: "Lỗi Thao Tác",
                    source: "Z" + zoneId + " · " + khoi,
                    msg: "Ghi nhận sự cố khẩn (E-Stop) tại " + khoi + " — đã lưu về máy chủ"
                });
                saveActiveAlarms();

                return taiSuCoKhan().then(function () {
                    alert("Đã ghi nhận sự cố tại " + khoi +
                          ". Các máy khác sẽ thấy trong vòng một chu kỳ làm mới.");
                });
            })
            .catch(function (e) {
                alert("Không gọi được máy chủ: " + e.message);
            });
    }





















    // Active Sequence intervals
    let activeSequenceInterval = null;
    let activeTimerInterval = null;






    // Initialize layout on DOM load
    document.addEventListener("DOMContentLoaded", function () {
        batDauKhoi();
        batDauSuCo();
    });
</script>

@* =====================================================================
   SỐ LIỆU THẬT CHO ĐIỀU KHIỂN VẬN HÀNH — specs/monitoring-real-data task-02

   Khối này CHỈ ĐỌC và chỉ ghi vào ba ô số của thanh "Số liệu thật từ PLC".
   Không đụng tầng điều khiển (btn-action-*, btn-mode-*, btn-plc-send,
   chk-bypass-*), không đọc/ghi localStorage, không sửa lưới mô phỏng.

   Hai nhịp poll khác nhau, cố ý:
     PlcStatus/Index  ~4 KB   -> 2 giây
     SlotStatus/Index ~121 KB -> 20 giây, vì chu kỳ quét ô đỗ của chính nó là
                                 45 giây; poll nhanh hơn là lãng phí thuần.
   ===================================================================== *@
<script>
    (function () {
        "use strict";

        var URL_PLC  = "@Url.Action("Index", "PlcStatus")";
        var URL_SLOT = "@Url.Action("Index", "SlotStatus")";
        var POLL_PLC_MS  = 2000;
        var POLL_SLOT_MS = 20000;
        var GACH = "—";

        var timerPlc = null, timerSlot = null;

        function el(id) { return document.getElementById(id); }
        function dat(id, v) { var e = el(id); if (e) e.textContent = v; }

        function datTrangThai(chu, mau) {
            var e = el("occ-status");
            if (!e) return;
            e.textContent = chu;
            e.style.color = mau;
        }

        function tickPlc() {
            fetch(URL_PLC, { cache: "no-store" })
                .then(function (r) {
                    if (!r.ok) throw new Error("HTTP " + r.status);
                    return r.json();
                })
                .then(function (d) {
                    var blocks = d.blocks || [];
                    var song = 0;
                    for (var i = 0; i < blocks.length; i++) if (blocks[i].online) song++;
                    dat("occ-block-doc-duoc", song + "/" + blocks.length);

                    // chua_dua_vao_van_hanh la mang RIENG, khong nam trong blocks[].
                    var cho = d.chua_dua_vao_van_hanh;
                    dat("occ-block-cho-kich-hoat", cho ? (cho.so_luong || 0) : 0);

                    datTrangThai("cập nhật " + (d.now || ""), "rgb(52, 211, 153)");
                })
                .catch(function (err) {
                    // Xoá số chứ không giữ lại — số cũ trông y hệt số đúng.
                    dat("occ-block-doc-duoc", GACH);
                    dat("occ-block-cho-kich-hoat", GACH);
                    datTrangThai("lỗi: " + err.message, "rgb(251, 191, 36)");
                });
        }

        function tickSlot() {
            fetch(URL_SLOT, { cache: "no-store" })
                .then(function (r) {
                    if (!r.ok) throw new Error("HTTP " + r.status);
                    return r.json();
                })
                .then(function (d) {
                    dat("occ-o-co-xe",
                        (d.occupied != null ? d.occupied : GACH) +
                        (d.total_slots != null ? "/" + d.total_slots : ""));
                })
                .catch(function () { dat("occ-o-co-xe", GACH); });
        }

        function batDau() {
            if (!timerPlc)  { tickPlc();  timerPlc  = setInterval(tickPlc,  POLL_PLC_MS); }
            if (!timerSlot) { tickSlot(); timerSlot = setInterval(tickSlot, POLL_SLOT_MS); }
        }
        function dungLai() {
            if (timerPlc)  { clearInterval(timerPlc);  timerPlc  = null; }
            if (timerSlot) { clearInterval(timerSlot); timerSlot = null; }
        }

        document.addEventListener("visibilitychange", function () {
            if (document.hidden) dungLai(); else batDau();
        });

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", batDau);
        } else {
            batDau();
        }
    })();
</script>
