<style>

    /* Modal Overlay & Box styling for absolute layout stability */

    .custom-modal-overlay {

        position: fixed !important;

        inset: 0 !important;

        z-index: 9999 !important; /* sits above everything */

        display: none !important;

        align-items: center !important;

        justify-content: center !important;

        padding: 16px !important;

        background-color: rgba(15, 23, 42, 0.8) !important;

        backdrop-filter: blur(6px) !important;

        transition: all 0.2s ease-in-out !important;

    }



        .custom-modal-overlay.active {

            display: flex !important;

        }



    .custom-modal-box {

        width: 100% !important;

        max-width: 680px !important;

        background-color: rgb(21, 32, 51) !important;

        border: 1px solid rgb(35, 53, 78) !important;

        border-radius: 12px !important;

        padding: 24px !important;

        box-sizing: border-box !important;

        position: relative !important;

        display: flex !important;

        flex-direction: column !important;

        max-height: 90vh !important;

        overflow-y: auto !important;

        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5) !important;

        animation: modalFadeIn 0.2s ease-out !important;

    }



    @@keyframes modalFadeIn {

        from {

            opacity: 0;

            transform: scale(0.95);

        }



        to {

            opacity: 1;

            transform: scale(1);

        }

    }



    /* Premium Block Card Button CSS Styles */

    .block-card-btn {

        background-color: #111C2E !important;

        border-radius: 6px !important;

        padding: 16px !important;

        text-align: left !important;

        width: 100% !important;

        cursor: pointer !important;

        outline: none !important;

        transition: all 0.2s ease-in-out !important;

        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1) !important;

        display: flex;

        flex-direction: column;

        justify-content: space-between;

        min-height: 180px;

    }



        /* Specific borders for status types */

        .block-card-btn.status-running {

            border: 1px solid rgba(37, 99, 235, 0.22) !important;

        }



        .block-card-btn.status-normal {

            border: 1px solid rgba(22, 163, 74, 0.22) !important;

        }



        .block-card-btn.status-warning {

            border: 1px solid rgba(245, 158, 11, 0.22) !important;

        }



        .block-card-btn.status-error {

            border: 1px solid rgba(220, 38, 38, 0.22) !important;

        }

        .block-card-btn.status-maintenance {

            border: 1px solid rgba(124, 58, 237, 0.22) !important;

        }

        .block-card-btn.status-offline {

            border: 1px solid rgba(100, 116, 139, 0.22) !important;

        }



        /* Hover effects - colorful borders and light backgrounds with glow shadow (matching Overview page scale transition) */

        .block-card-btn:hover {

            transform: scale(1.02) !important;

        }



        .block-card-btn.status-running:hover {

            border-color: rgb(37, 99, 235) !important;

            background-color: rgba(37, 99, 235, 0.08) !important;

            box-shadow: 0 10px 15px -3px rgba(37, 99, 235, 0.3), 0 4px 6px -4px rgba(37, 99, 235, 0.3), 0 0 12px rgba(37, 99, 235, 0.2) !important;

        }



        .block-card-btn.status-normal:hover {

            border-color: rgb(22, 163, 74) !important;

            background-color: rgba(22, 163, 74, 0.08) !important;

            box-shadow: 0 10px 15px -3px rgba(22, 163, 74, 0.3), 0 4px 6px -4px rgba(22, 163, 74, 0.3), 0 0 12px rgba(22, 163, 74, 0.2) !important;

        }



        .block-card-btn.status-warning:hover {

            border-color: rgb(245, 158, 11) !important;

            background-color: rgba(245, 158, 11, 0.08) !important;

            box-shadow: 0 10px 15px -3px rgba(245, 158, 11, 0.3), 0 4px 6px -4px rgba(245, 158, 11, 0.3), 0 0 12px rgba(245, 158, 11, 0.2) !important;

        }



        .block-card-btn.status-error:hover {

            border-color: rgb(220, 38, 38) !important;

            background-color: rgba(220, 38, 38, 0.08) !important;

            box-shadow: 0 10px 15px -3px rgba(220, 38, 38, 0.3), 0 4px 6px -4px rgba(220, 38, 38, 0.3), 0 0 12px rgba(220, 38, 38, 0.2) !important;

        }

        .block-card-btn.status-maintenance:hover {

            border-color: rgb(124, 58, 237) !important;

            background-color: rgba(124, 58, 237, 0.08) !important;

            box-shadow: 0 10px 15px -3px rgba(124, 58, 237, 0.3), 0 4px 6px -4px rgba(124, 58, 237, 0.3), 0 0 12px rgba(124, 58, 237, 0.2) !important;

        }

        .block-card-btn.status-offline:hover {

            border-color: rgb(100, 116, 139) !important;

            background-color: rgba(100, 116, 139, 0.08) !important;

            box-shadow: 0 10px 15px -3px rgba(100, 116, 139, 0.3), 0 4px 6px -4px rgba(100, 116, 139, 0.3), 0 0 12px rgba(100, 116, 139, 0.2) !important;

        }



    .absolute-close-btn {

        position: absolute;

        top: 16px;

        right: 16px;

        background: transparent;

        border: none;

        color: #94a3b8;

        cursor: pointer;

        padding: 4px;

        border-radius: 4px;

        transition: color 0.15s, background-color 0.15s;

    }



        .absolute-close-btn:hover {

            color: #ffffff;

            background-color: rgba(255, 255, 255, 0.08);

        }



    /* Modal Stat Cards */

    .modal-stat-card {

        background-color: rgb(21, 32, 51) !important;

        border: 1px solid rgb(35, 53, 78) !important;

        border-radius: 6px !important;

        padding: 10px 14px !important;

    }



    /* Pallet Grid Layout */

    #modalPalletsGrid {

        display: grid !important;

        grid-template-columns: repeat(3, 1fr) !important;

        gap: 8px !important;

        width: 100% !important;

    }



    @@media (min-width: 480px) {

        #modalPalletsGrid {

            grid-template-columns: repeat(4, 1fr) !important;

        }

    }



    @@media (min-width: 640px) {

        #modalPalletsGrid {

            grid-template-columns: repeat(6, 1fr) !important;

        }

    }



    /* Pallet Lot Cards (Fixed dimensions and flex layout to guarantee zero layout breaking) */

    .pallet-card {

        width: 100% !important;

        height: 96px !important;

        padding: 8px 6px !important;

        box-sizing: border-box !important;

        border-radius: 6px !important;

        user-select: none !important;

        transition: all 0.15s ease-in-out !important;

        display: flex !important;

        flex-direction: column !important;

        justify-content: space-between !important;

        align-items: center !important;

        flex-shrink: 0 !important;

    }



        .pallet-card.occupied {

            border: 1px solid rgb(22, 163, 74) !important;

            background-color: rgba(22, 163, 74, 0.08) !important;

            color: rgb(74, 222, 128) !important;

        }



            .pallet-card.occupied:hover {

                background-color: rgba(22, 163, 74, 0.15) !important;

            }



        .pallet-card.empty {

            border: 1px solid rgb(203, 213, 225) !important;

            background-color: rgba(255, 255, 255, 0.03) !important;

            color: rgb(241, 245, 249) !important;

        }



            .pallet-card.empty:hover {

                background-color: rgba(255, 255, 255, 0.08) !important;

            }



        .pallet-card.lime {

            border: 1px solid rgb(132, 204, 22) !important;

            background-color: rgba(132, 204, 22, 0.08) !important;

            color: rgb(163, 230, 53) !important;

        }



            .pallet-card.lime:hover {

                background-color: rgba(132, 204, 22, 0.15) !important;

            }



        .pallet-card.cyan {

            border: 1px solid rgb(6, 182, 212) !important;

            background-color: rgba(6, 182, 212, 0.08) !important;

            color: rgb(34, 211, 238) !important;

        }



            .pallet-card.cyan:hover {

                background-color: rgba(6, 182, 212, 0.15) !important;

            }



        .pallet-card.error {

            border: 1px solid rgb(220, 38, 38) !important;

            background-color: rgba(220, 38, 38, 0.12) !important;

            color: rgb(248, 113, 113) !important;

        }



            .pallet-card.error:hover {

                background-color: rgba(220, 38, 38, 0.2) !important;

            }



        .pallet-card.locked {

            border: 1px solid rgb(124, 58, 237) !important;

            background-color: rgba(124, 58, 237, 0.12) !important;

            color: rgb(192, 132, 252) !important;

        }



            .pallet-card.locked:hover {

                background-color: rgba(124, 58, 237, 0.2) !important;

            }



        /* Lot Card Inner Elements */

        .pallet-card .pallet-header {

            font-size: 10px !important;

            font-weight: 700 !important;

            display: flex !important;

            align-items: center !important;

            justify-content: center !important;

            gap: 4px !important;

            width: 100% !important;

            margin-bottom: 2px !important;

        }



        .pallet-card .pallet-type {

            font-size: 9px !important;

            font-weight: 700 !important;

            text-transform: uppercase !important;

            color: rgb(148, 163, 184) !important;

            width: 100% !important;

            text-align: center !important;

            margin-bottom: 2px !important;

        }



        .pallet-card .pallet-plate {

            font-size: 9px !important;

            font-weight: 700 !important;

            font-family: Consolas, Monaco, monospace !important;

            width: 100% !important;

            text-align: center !important;

            white-space: nowrap !important;

            overflow: hidden !important;

            text-overflow: ellipsis !important;

            margin-bottom: 2px !important;

        }



        .pallet-card .pallet-time {

            font-size: 8px !important;

            font-weight: 600 !important;

            width: 100% !important;

            text-align: center !important;

        }



    /* Modal Footer Buttons Style */

    .modal-footer-btn {

        padding: 6px 12px !important;

        font-size: 12px !important;

        font-weight: 700 !important;

        border-radius: 4px !important;

        transition: all 0.15s ease-in-out !important;

        display: inline-flex !important;

        align-items: center !important;

        gap: 6px !important;

        cursor: pointer !important;

        white-space: nowrap !important;

        flex-shrink: 0 !important;

    }

</style>



<script>

    // ===================== DU LIEU THAT =====================
    // Truoc day trang nay gia tu tren xuong duoi: 8 dong gan so cung cho thong
    // ke zone, 18 khoi bia dat ten theo khuon "Block <chu cai>-<so>" (bai that co 118
    // khoi), va 9 bien so xe khong ton tai gan cho cac o do.
    //
    // Gio: danh sach khoi tu /Monitor/BlockMap, o do tu /SlotStatus.
    var ZONE_ID = @zoneId;
    var URL_BLOCKMAP = "@Url.Action("BlockMap", "Monitor")";
    var URL_SLOT = "@Url.Action("Index", "SlotStatus")";
    var NHIP_KHOI_MS = 15000;

    var khoiTheoSo = {};

    function escZ(v) {
        return String(v === null || v === undefined ? "" : v)
            .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;");
    }

    function veThongKeZone(ds) {
        var tongO = 0, coXe = 0, mat = 0;
        ds.forEach(function (b) {
            tongO += b.slots || 0;
            coXe += b.occupied || 0;
            if (!b.online) mat++;
        });
        var pct = tongO > 0 ? Math.round(coXe / tongO * 100) : 0;

        var tt = document.getElementById("zoneTomTat");
        if (tt) tt.textContent = ds.length + " khối · " + coXe + "/" + tongO +
                                 " ô có xe · " + pct + "%" +
                                 (mat ? "  ·  " + mat + " khối mất kết nối" : "");
        var th = document.getElementById("zoneThanh");
        if (th) th.style.width = pct + "%";
        var pt = document.getElementById("zonePhanTram");
        if (pt) pt.textContent = pct + "%";
    }

    function veKhoi(ds) {
        var grid = document.getElementById("blocksGrid");
        if (!grid) return;

        if (ds.length === 0) {
            grid.innerHTML = '<div class="col-span-full text-center text-slate-500 text-xs py-8">' +
                             'Zone này chưa có khối nào trong cơ sở dữ liệu.</div>';
            return;
        }

        grid.innerHTML = ds.map(function (b) {
            var trong = (b.slots || 0) - (b.occupied || 0);
            var pct = b.slots > 0 ? Math.round(b.occupied / b.slots * 100) : 0;

            // Mat ket noi KHAC voi trong. Mot khoi khong doc duoc thi so o cua no
            // la so doc duoc LAN CUOI, khong phai hien trang.
            var nhan = b.online
                ? '<span class="px-2 py-0.5 rounded text-[10px] font-semibold border" ' +
                  'style="border-color:rgba(34,197,94,.4);background:rgba(34,197,94,.1);color:rgb(74,222,128);">Đang đọc được</span>'
                : '<span class="px-2 py-0.5 rounded text-[10px] font-semibold border" ' +
                  'style="border-color:rgba(220,38,38,.4);background:rgba(220,38,38,.1);color:rgb(248,113,113);">Mất kết nối</span>';

            return '<button onclick="openBlockModal(' + b.block_no + ')" ' +
                   'class="text-left rounded-lg p-3 transition-all hover:border-slate-500" ' +
                   'style="background:rgb(30,41,59);border:1px solid rgb(51,65,85);">' +
                   '<div class="flex items-center justify-between mb-2">' +
                     '<span class="text-sm font-bold text-white">Khối ' + b.block_no + '</span>' +
                     nhan +
                   '</div>' +
                   '<div class="space-y-1 text-[11px] font-mono">' +
                     '<div class="flex justify-between"><span class="text-slate-400">Sức chứa</span>' +
                       '<span class="text-slate-100 font-semibold">' + (b.slots || 0) + ' ô</span></div>' +
                     '<div class="flex justify-between"><span class="text-slate-400">Có xe</span>' +
                       '<span class="font-bold" style="color:rgb(34,197,94);">' + (b.occupied || 0) + '</span></div>' +
                     '<div class="flex justify-between"><span class="text-slate-400">Còn trống</span>' +
                       '<span class="text-slate-100 font-semibold">' + trong + '</span></div>' +
                     '<div class="flex justify-between"><span class="text-slate-400">Ô đọc mới</span>' +
                       '<span class="text-slate-300">' + (b.fresh || 0) + '/' + (b.slots || 0) + '</span></div>' +
                   '</div>' +
                   '<div class="w-full bg-slate-800 rounded-full mt-2" style="height:4px;">' +
                     '<div class="rounded-full" style="height:4px;width:' + pct + '%;background:rgb(37,99,235);"></div>' +
                   '</div></button>';
        }).join("");
    }

    function loiKhoi(thongBao) {
        var grid = document.getElementById("blocksGrid");
        if (grid) {
            grid.innerHTML = '<div class="col-span-full text-center text-red-400 text-xs py-8">' +
                             'Không đọc được danh sách khối: ' + escZ(thongBao) + '</div>';
        }
        // Modal khong co nhip lam moi rieng. Khong xoa thi no giu nguyen so cu
        // vo thoi han truoc mat nguoi dung trong khi nen sau da bao mat ket noi.
        khoiTheoSo = {};
        var modal = document.getElementById("blockDetailModal");
        if (modal && modal.classList.contains("active")) {
            ["modalCapacityVal", "modalParkedVal", "modalModeVal",
             "modalPalletCount"].forEach(function (id) {
                var e = document.getElementById(id);
                if (e) e.innerText = "—";
            });
            var g = document.getElementById("modalPalletsGrid");
            if (g) g.innerHTML = '<div class="text-red-400 text-xs">Mất kết nối máy chủ.</div>';
            var d2 = document.getElementById("modalDenPlc");
            if (d2) d2.style.cssText = "background-color: rgb(71, 85, 105);";
        }

        // Xoa so chu khong giu lai: so cu trong y het so dung.
        var tt = document.getElementById("zoneTomTat");
        if (tt) tt.textContent = "Mất kết nối máy chủ";
        var th = document.getElementById("zoneThanh");
        if (th) th.style.width = "0%";
        var pt = document.getElementById("zonePhanTram");
        if (pt) pt.textContent = "—";
    }

    function taiKhoi() {
        return fetch(URL_BLOCKMAP, { cache: "no-store" })
            .then(function (r) {
                if (!r.ok) throw new Error("HTTP " + r.status);
                return r.json();
            })
            .then(function (d) {
                if (d && d.error) throw new Error(d.error);
                if (!d || !Array.isArray(d.blocks)) throw new Error("thiếu dữ liệu");
                var ds = d.blocks.filter(function (b) { return b.zone_id === ZONE_ID; })
                                 .sort(function (a, b) { return a.block_no - b.block_no; });
                khoiTheoSo = {};
                ds.forEach(function (b) { khoiTheoSo[b.block_no] = b; });
                veThongKeZone(ds);
                veKhoi(ds);
            })
            .catch(function (e) { loiKhoi(e.message); });
    }

    // ------------------------------- o do trong mot khoi
    function veODo(slots) {
        var grid = document.getElementById("modalPalletsGrid");
        if (!grid) return;
        grid.innerHTML = "";

        slots.forEach(function (o) {
            var card = document.createElement("div");
            var nen, vien, noiDung;

            if (o.suspect) {
                // The la: co ma the trong thanh ghi nhung ma do KHONG co trong
                // danh muc. Nghia la co xe that nhung the chua dang ky, hoac
                // thanh ghi giai ma sai. Phai hien rieng, khong gop vao "trong".
                nen = "rgba(245,158,11,.12)"; vien = "rgba(245,158,11,.45)";
                noiDung = '<div class="text-[10px] font-bold" style="color:rgb(251,191,36);">Thẻ lạ</div>' +
                          '<div class="text-[10px] font-mono text-slate-300">' + escZ(o.card_code) + '</div>';
            } else if (o.occupied) {
                // Chi 128/613 the co bien so, nhung ca 613 deu co so the. Lui ve
                // so the thay vi hien dau gach cho 79% truong hop.
                var chinh = o.plate || o.card_no || o.card_code;
                var phu = o.plate ? o.card_no : (o.vehicle_name || "");
                nen = "rgba(37,99,235,.12)"; vien = "rgba(37,99,235,.45)";
                noiDung = '<div class="text-[11px] font-bold text-white font-mono">' + escZ(chinh) + '</div>' +
                          (phu ? '<div class="text-[9px] text-slate-400 font-mono">' + escZ(phu) + '</div>' : "") +
                          (o.plate ? "" : '<div class="text-[9px] text-slate-500">chưa có biển số</div>');
            } else {
                nen = "rgba(15,23,42,.6)"; vien = "rgba(51,65,85,.8)";
                noiDung = '<div class="text-[10px] text-slate-600">trống</div>';
            }

            card.className = "rounded p-2";
            card.style.cssText = "background:" + nen + ";border:1px solid " + vien + ";";
            card.innerHTML =
                '<div class="flex items-center justify-between mb-1">' +
                  '<span class="text-[10px] font-bold text-slate-300">Ô ' +
                    (o.slot < 10 ? "0" + o.slot : o.slot) + '</span>' +
                  '<span class="text-[9px] font-mono text-slate-600">' + escZ(o.register) + '</span>' +
                '</div>' + noiDung +
                '<div class="text-[9px] text-slate-600 font-mono mt-1">' +
                  (o.read_at ? "đọc " + escZ(o.read_at) : "chưa đọc được") + '</div>';
            grid.appendChild(card);
        });
    }

    // Tang moi lan mo modal. Response ve muon cua khoi truoc phai bi bo,
    // neu khong: bam khoi A (cham) roi bam ngay khoi B (nhanh) thi luoi o cua A
    // ve sau se de len o cua B trong khi tieu de van ghi ten B — nguoi di tim xe
    // doc bien so khoi A duoi nhan khoi B.
    var luotMo = 0;

    function openBlockModal(blockNo) {
        var luot = ++luotMo;
        var b = khoiTheoSo[blockNo] || {};
        var dat = function (id, v) {
            var e = document.getElementById(id);
            if (e) e.innerText = v;
        };

        dat("modalBlockName", "Khối " + blockNo);
        dat("modalZoneVal", "@zoneName");
        dat("modalCapacityVal", (b.slots || 0) + " ô");
        dat("modalParkedVal", String(b.occupied || 0));
        dat("modalSuvVal", "—");
        dat("modalSedanVal", "—");
        dat("modalModeVal", b.online ? "Đang đọc được" : "Mất kết nối");

        var den = document.getElementById("modalDenPlc");
        if (den) {
            den.style.cssText = b.online
                ? "background-color: rgb(34, 197, 94); box-shadow: rgba(34, 197, 94, 0.4) 0px 0px 6px;"
                : "background-color: rgb(220, 38, 38); box-shadow: rgba(220, 38, 38, 0.4) 0px 0px 6px;";
        }
        dat("modalRuntimeVal", "—");
        dat("modalCycleVal", "—");
        dat("modalPalletCount", "…");

        var badge = document.getElementById("modalBlockStatus");
        if (badge) {
            badge.innerText = b.online ? "Đang đọc được" : "Mất kết nối";
            badge.className = "px-2 py-0.5 rounded text-[10px] font-semibold border flex items-center gap-1";
            badge.style.cssText = b.online
                ? "border-color:rgba(34,197,94,.4);background:rgba(34,197,94,.1);color:rgb(74,222,128);"
                : "border-color:rgba(220,38,38,.4);background:rgba(220,38,38,.1);color:rgb(248,113,113);";
        }

        var grid = document.getElementById("modalPalletsGrid");
        if (grid) grid.innerHTML = '<div class="text-slate-500 text-xs">Đang đọc ô đỗ…</div>';

        var modal = document.getElementById("blockDetailModal");
        if (modal) modal.classList.add("active");

        fetch(URL_SLOT + "?block=" + blockNo, { cache: "no-store" })
            .then(function (r) {
                if (!r.ok) throw new Error("HTTP " + r.status);
                return r.json();
            })
            .then(function (d) {
                if (luot !== luotMo) return;          // khoi khac da duoc mo
                if (d && d.error) throw new Error(d.error);
                if (!d || !Array.isArray(d.slots)) throw new Error("thiếu dữ liệu");
                veODo(d.slots);
                dat("modalPalletCount", d.occupied + "/" + d.total_slots +
                                        (d.suspect ? "  ·  " + d.suspect + " thẻ lạ" : ""));
            })
            .catch(function (e) {
                if (luot !== luotMo) return;
                if (grid) {
                    grid.innerHTML = '<div class="text-red-400 text-xs">Không đọc được ô đỗ: ' +
                                     escZ(e.message) + "</div>";
                }
                dat("modalPalletCount", "—");
            });
    }

    // Guard if (!timer): thieu no thi moi lan visibilitychange bao hien ma
    // khong co lan an tuong ung se sinh them mot interval va mat handle cu.
    var timerKhoi = null;

    function batDauKhoi() {
        if (timerKhoi) return;
        taiKhoi();
        timerKhoi = setInterval(taiKhoi, NHIP_KHOI_MS);
    }

    document.addEventListener("visibilitychange", function () {
        if (document.hidden) {
            if (timerKhoi) { clearInterval(timerKhoi); timerKhoi = null; }
        } else {
            batDauKhoi();
        }
    });

    batDauKhoi();

    function closeBlockModal() {

        var modal = document.getElementById("blockDetailModal");

        modal.classList.remove("active");

    }



    // Close on click outside modal content

    document.getElementById("blockDetailModal").addEventListener("click", function(event) {

        if (event.target === this) {

            closeBlockModal();

        }

    });

</script>

